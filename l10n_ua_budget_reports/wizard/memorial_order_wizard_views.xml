<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_memorial_order_wizard" model="ir.ui.view">
        <field name="name">l10n_ua.budget.memorial_order.wizard.form</field>
        <field name="model">l10n_ua.budget.memorial_order.wizard</field>
        <field name="arch" type="xml">
            <form string="Меморіальний ордер: параметри">
                <group>
                    <field name="mo_kind"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Друкувати" class="btn-primary"/>
                    <button special="cancel" string="Скасувати" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_memorial_order_wizard" model="ir.actions.act_window">
        <field name="name">Меморіальні ордери</field>
        <field name="res_model">l10n_ua.budget.memorial_order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
