<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_supplier_price_source_list" model="ir.ui.view">
        <field name="name">l10n_ua.supplier.price.source.list</field>
        <field name="model">l10n_ua.supplier.price.source</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Sources">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="fetcher_type"/>
                <field name="parser_type"/>
                <field name="auto_sync_active"/>
                <field name="last_import_state"/>
                <field name="import_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_price_source_form" model="ir.ui.view">
        <field name="name">l10n_ua.supplier.price.source.form</field>
        <field name="model">l10n_ua.supplier.price.source</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Source">
                <header>
                    <button name="action_create_import" type="object"
                            string="New Import" class="oe_highlight"
                            groups="l10n_ua_supplier_prices_base.group_supplier_prices_officer"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_imports" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="import_count" widget="statinfo" string="Imports"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Generic A"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="fetcher_type"/>
                            <field name="parser_type"/>
                            <field name="mapping_id"/>
                            <field name="currency_default_id"/>
                            <field name="unknown_sku_action"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connection">
                            <field name="connection_config" widget="text"
                                   placeholder='{"url": "https://...", "api_key": "..."}'/>
                            <p class="text-muted">
                                Структура залежить від <em>fetcher_type</em>. Дивись документацію
                                відповідного модуля розширення.
                            </p>
                        </page>
                        <page string="Auto Sync">
                            <group>
                                <field name="auto_sync_active"/>
                                <field name="sync_interval_hours"
                                       invisible="not auto_sync_active"/>
                                <field name="last_sync_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Timeouts">
                            <group>
                                <field name="fetch_timeout"/>
                                <field name="parse_timeout"/>
                                <field name="apply_timeout"/>
                                <field name="watchdog_timeout_minutes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_supplier_price_source" model="ir.actions.act_window">
        <field name="name">Sources</field>
        <field name="res_model">l10n_ua.supplier.price.source</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
