<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_supplier_price_watchdog" model="ir.cron">
            <field name="name">Supplier Prices: Watchdog (stuck imports)</field>
            <field name="model_id" ref="model_l10n_ua_supplier_price_import"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_supplier_price_auto_sync" model="ir.cron">
            <field name="name">Supplier Prices: Auto Sync</field>
            <field name="model_id" ref="model_l10n_ua_supplier_price_import"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
