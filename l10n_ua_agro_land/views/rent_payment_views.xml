<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_agro_rent_payment_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.agro.rent.payment.list</field>
        <field name="model">l10n_ua.agro.rent.payment</field>
        <field name="arch" type="xml">
            <list string="Rent Payments" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="payment_form"/>
                <field name="journal_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_agro_rent_payment_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.agro.rent.payment.form</field>
        <field name="model">l10n_ua.agro.rent.payment</field>
        <field name="arch" type="xml">
            <form string="Rent Payment">
                <header>
                    <button name="action_fill" type="object" string="Fill with Debts"
                            class="btn-primary" invisible="state != 'draft' or line_ids"/>
                    <button name="action_fill" type="object" string="Add Debts"
                            invisible="state != 'draft' or not line_ids"/>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'posted'" confirm="Cancel the rent payment?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_move" type="object" class="oe_stat_button"
                                icon="fa-bars" invisible="not move_id">
                            <span class="o_stat_text">Journal Entry</span>
                        </button>
                        <button name="action_view_pickings" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Delivery"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="payment_form" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="accrual_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="move_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="payable_account_id" readonly="state != 'draft'"/>
                            <field name="income_account_id" invisible="payment_form != 'in_kind'"
                                   required="payment_form == 'in_kind'" readonly="state != 'draft'"/>
                            <field name="product_id" invisible="payment_form != 'in_kind'"
                                   required="payment_form == 'in_kind'" readonly="state != 'draft'"/>
                            <field name="price_unit" invisible="payment_form != 'in_kind'"
                                   required="payment_form == 'in_kind'" readonly="state != 'draft'"/>
                            <field name="warehouse_id" invisible="payment_form != 'in_kind'"
                                   required="payment_form == 'in_kind'" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lessors" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="accrual_line_id"/>
                                    <field name="lessor_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="debt" optional="show"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="quantity" sum="Total"
                                           column_invisible="parent.payment_form != 'in_kind'"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="quantity_total" invisible="payment_form != 'in_kind'"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_agro_rent_payment_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.agro.rent.payment.search</field>
        <field name="model">l10n_ua.agro.rent.payment</field>
        <field name="arch" type="xml">
            <search string="Rent Payments">
                <field name="name"/>
                <field name="line_ids" string="Lessor" filter_domain="[('line_ids.lessor_id', 'ilike', self)]"/>
                <filter string="Money" name="money" domain="[('payment_form', '=', 'money')]"/>
                <filter string="In Kind" name="in_kind" domain="[('payment_form', '=', 'in_kind')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
            </search>
        </field>
    </record>

    <record id="l10n_ua_agro_rent_payment_action" model="ir.actions.act_window">
        <field name="name">Rent Payments</field>
        <field name="res_model">l10n_ua.agro.rent.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
