<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_agro_land_plot_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.plot.list</field>
        <field name="model">l10n_ua.agro.land.plot</field>
        <field name="arch" type="xml">
            <list string="Land Plots">
                <field name="cadastral_number"/>
                <field name="owner_id"/>
                <field name="ownership" optional="show"/>
                <field name="land_type" optional="show"/>
                <field name="field_id" optional="show"/>
                <field name="current_lease_id" optional="show"/>
                <field name="use_state" widget="badge" optional="show"
                       decoration-success="use_state in ('own', 'leased')"
                       decoration-warning="use_state == 'free'"/>
                <field name="katottg" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="ngo_value" sum="Total" optional="show"/>
                <field name="area" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_agro_land_plot_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.plot.form</field>
        <field name="model">l10n_ua.agro.land.plot</field>
        <field name="arch" type="xml">
            <form string="Land Plot">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="cadastral_number"/>
                        <h1><field name="cadastral_number" placeholder="0000000000:00:000:0000"/></h1>
                    </div>
                    <group>
                        <group string="Plot">
                            <field name="area"/>
                            <field name="land_type"/>
                            <field name="purpose_code" placeholder="01.01"/>
                            <field name="location"/>
                            <field name="katottg" placeholder="UA00000000000000000"/>
                            <field name="field_id"/>
                        </group>
                        <group string="Ownership">
                            <field name="ownership"/>
                            <field name="owner_id"/>
                            <field name="ngo_value"/>
                            <field name="ngo_date"/>
                            <field name="use_state"/>
                            <field name="current_lease_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Leases" name="leases">
                            <field name="lease_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="lessor_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_agro_land_plot_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.plot.search</field>
        <field name="model">l10n_ua.agro.land.plot</field>
        <field name="arch" type="xml">
            <search string="Land Plots">
                <field name="cadastral_number"/>
                <field name="owner_id"/>
                <field name="field_id"/>
                <field name="katottg"/>
                <filter string="Leased" name="leased" domain="[('use_state', '=', 'leased')]"/>
                <filter string="Owned" name="own" domain="[('use_state', '=', 'own')]"/>
                <filter string="Not in Use" name="free" domain="[('use_state', '=', 'free')]"/>
                <separator/>
                <filter string="Without Field" name="no_field" domain="[('field_id', '=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Owner" name="groupby_owner" domain="[]" context="{'group_by': 'owner_id'}"/>
                    <filter string="Field" name="groupby_field" domain="[]" context="{'group_by': 'field_id'}"/>
                    <filter string="Ownership" name="groupby_ownership" domain="[]" context="{'group_by': 'ownership'}"/>
                    <filter string="KATOTTG" name="groupby_katottg" domain="[]" context="{'group_by': 'katottg'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_agro_land_plot_view_pivot" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.plot.pivot</field>
        <field name="model">l10n_ua.agro.land.plot</field>
        <field name="arch" type="xml">
            <pivot string="Area by Owner" sample="1">
                <field name="owner_id" type="row"/>
                <field name="land_type" type="col"/>
                <field name="area" type="measure"/>
                <field name="ngo_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_ua_agro_land_plot_action" model="ir.actions.act_window">
        <field name="name">Land Plots</field>
        <field name="res_model">l10n_ua.agro.land.plot</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first land plot</p>
            <p>Plots can be imported from a spreadsheet: cadastral number, area, valuation, owner.</p>
        </field>
    </record>

    <record id="l10n_ua_agro_land_plot_report_action" model="ir.actions.act_window">
        <field name="name">Area by Owner</field>
        <field name="res_model">l10n_ua.agro.land.plot</field>
        <field name="view_mode">pivot,list</field>
    </record>

</odoo>
