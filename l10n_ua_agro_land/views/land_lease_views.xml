<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_agro_land_lease_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.lease.list</field>
        <field name="model">l10n_ua.agro.land.lease</field>
        <field name="arch" type="xml">
            <list string="Land Leases" decoration-muted="state in ('expired', 'terminated')">
                <field name="name"/>
                <field name="lessor_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="registration_date" optional="show"/>
                <field name="payment_form" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="plots_area" sum="Total"/>
                <field name="annual_rent" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('expired', 'terminated')"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_agro_land_lease_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.lease.form</field>
        <field name="model">l10n_ua.agro.land.lease</field>
        <field name="arch" type="xml">
            <form string="Land Lease">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_renew" type="object" string="Renew"
                            invisible="state not in ('active', 'expired')"
                            confirm="Extend the contract for the same term?"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="state != 'active'"
                            confirm="Terminate the lease contract?"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            groups="l10n_ua_agro_base.group_ua_agro_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 15/2026"/></h1>
                    </div>
                    <group>
                        <group string="Contract">
                            <field name="lessor_id"/>
                            <field name="date"/>
                            <field name="date_start"/>
                            <field name="term_years"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="State Registration">
                            <field name="registration_date"/>
                            <field name="registration_number"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rent">
                            <field name="rent_method"/>
                            <field name="ngo_total" invisible="rent_method != 'ngo_percent'"/>
                            <field name="rent_percent" invisible="rent_method != 'ngo_percent'"/>
                            <field name="rent_fixed" invisible="rent_method != 'fixed'"/>
                            <field name="annual_rent"/>
                            <field name="rent_residual"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Payment">
                            <field name="payment_form"/>
                            <field name="in_kind_product_id" invisible="payment_form != 'in_kind'"/>
                            <field name="lessor_is_individual" invisible="1"/>
                            <div class="text-muted" colspan="2" invisible="not lessor_is_individual">
                                The lessor is an individual: personal income tax and military levy are withheld from the rent.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Land Plots" name="plots">
                            <field name="plot_ids"
                                   context="{'default_owner_id': lessor_id}">
                                <list>
                                    <field name="cadastral_number"/>
                                    <field name="owner_id"/>
                                    <field name="land_type"/>
                                    <field name="field_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="ngo_value" sum="Total"/>
                                    <field name="area" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="plots_area"/>
                            </group>
                        </page>
                        <page string="Rent Accruals" name="accruals">
                            <field name="accrual_line_ids" readonly="1">
                                <list>
                                    <field name="accrual_id"/>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="pdfo_amount" sum="Total"/>
                                    <field name="military_amount" sum="Total"/>
                                    <field name="net_amount" sum="Total"/>
                                    <field name="paid_amount" sum="Total"/>
                                    <field name="residual" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_agro_land_lease_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.agro.land.lease.search</field>
        <field name="model">l10n_ua.agro.land.lease</field>
        <field name="arch" type="xml">
            <search string="Land Leases">
                <field name="name"/>
                <field name="lessor_id"/>
                <field name="plot_ids" string="Cadastral Number"/>
                <filter string="Active" name="active_leases" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Expiring within 90 days" name="expiring"
                        domain="[('state', '=', 'active'), ('date_end', '&lt;=', (context_today() + relativedelta(days=90)).strftime('%Y-%m-%d'))]"/>
                <filter string="Not Registered" name="not_registered" domain="[('registration_date', '=', False)]"/>
                <separator/>
                <filter string="In Kind" name="in_kind" domain="[('payment_form', '=', 'in_kind')]"/>
                <group>
                    <filter string="Lessor" name="groupby_lessor" domain="[]" context="{'group_by': 'lessor_id'}"/>
                    <filter string="Status" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="End Date" name="groupby_date_end" domain="[]" context="{'group_by': 'date_end:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_agro_land_lease_action" model="ir.actions.act_window">
        <field name="name">Land Leases</field>
        <field name="res_model">l10n_ua.agro.land.lease</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_leases': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register the first land lease contract</p>
            <p>The rent is computed from the valuation of the plots or as a fixed amount, and accrued for a period with tax withholding.</p>
        </field>
    </record>

</odoo>
