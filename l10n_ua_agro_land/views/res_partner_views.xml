<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_agro_land" model="ir.ui.view">
        <field name="name">res.partner.form.agro.land</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_l10n_ua_agro_leases" type="object" class="oe_stat_button"
                        icon="fa-map-o" invisible="not l10n_ua_agro_lease_count"
                        groups="l10n_ua_agro_base.group_ua_agro_user">
                    <field name="l10n_ua_agro_lease_count" widget="statinfo" string="Land Leases"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
