<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Landscape A4: the М-19 table carries four quantity/amount pairs and
         does not fit the portrait width. Defined here rather than reused from
         the accounting localization, which this module deliberately does not
         depend on. -->
    <record id="paperformat_ua_stock_report" model="report.paperformat">
        <field name="name">UA Stock Report A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_m19_material" model="ir.actions.report">
        <field name="name">Матеріальний звіт (М-19)</field>
        <field name="model">l10n_ua.m19.material.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_stock_reports.report_m19_material</field>
        <field name="report_file">l10n_ua_stock_reports.report_m19_material</field>
        <field name="paperformat_id" ref="paperformat_ua_stock_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_m19_material">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size: 9pt;">
                        <t t-set="lines" t-value="wizard._get_report_lines()"/>
                        <t t-set="totals" t-value="wizard._get_report_totals(lines)"/>

                        <div style="text-align: right; font-size: 8pt;">
                            Типова форма № М-19
                        </div>
                        <h4 style="text-align: center; margin: 4px 0;">
                            МАТЕРІАЛЬНИЙ ЗВІТ
                        </h4>
                        <div style="text-align: center; margin-bottom: 8px;">
                            за період з
                            <span t-field="wizard.date_from" t-options="{'widget': 'date'}"/>
                            по
                            <span t-field="wizard.date_to" t-options="{'widget': 'date'}"/>
                        </div>

                        <table style="width: 100%; margin-bottom: 8px;">
                            <tr>
                                <td style="width: 50%;">
                                    Підприємство: <strong t-field="wizard.company_id.name"/>
                                </td>
                                <td style="width: 50%;">
                                    Місце зберігання: <strong t-field="wizard.location_id.complete_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    Матеріально відповідальна особа:
                                    <strong t-out="wizard.responsible_person or '______________________'"/>
                                </td>
                            </tr>
                        </table>

                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f0f0f0;">
                                    <th style="border: 1px solid #000; padding: 2px;" rowspan="2">№ з/п</th>
                                    <th style="border: 1px solid #000; padding: 2px;" rowspan="2">Номенклатурний номер</th>
                                    <th style="border: 1px solid #000; padding: 2px;" rowspan="2">Назва матеріалу</th>
                                    <th style="border: 1px solid #000; padding: 2px;" rowspan="2">Од. вим.</th>
                                    <th style="border: 1px solid #000; padding: 2px;" rowspan="2">Ціна</th>
                                    <th style="border: 1px solid #000; padding: 2px;" colspan="2">Залишок на початок</th>
                                    <th style="border: 1px solid #000; padding: 2px;" colspan="2">Надходження</th>
                                    <th style="border: 1px solid #000; padding: 2px;" colspan="2">Витрата</th>
                                    <th style="border: 1px solid #000; padding: 2px;" colspan="2">Залишок на кінець</th>
                                </tr>
                                <tr style="background-color: #f0f0f0;">
                                    <th style="border: 1px solid #000; padding: 2px;">К-сть</th>
                                    <th style="border: 1px solid #000; padding: 2px;">Сума</th>
                                    <th style="border: 1px solid #000; padding: 2px;">К-сть</th>
                                    <th style="border: 1px solid #000; padding: 2px;">Сума</th>
                                    <th style="border: 1px solid #000; padding: 2px;">К-сть</th>
                                    <th style="border: 1px solid #000; padding: 2px;">Сума</th>
                                    <th style="border: 1px solid #000; padding: 2px;">К-сть</th>
                                    <th style="border: 1px solid #000; padding: 2px;">Сума</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td style="border: 1px solid #000; padding: 2px; text-align: center;">
                                        <t t-out="line_index + 1"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 2px;"><t t-out="line['code']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px;"><t t-out="line['name']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: center;"><t t-out="line['uom']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;">
                                        <t t-out="'%.2f' % line['price']"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.3f' % line['opening_qty']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % line['opening_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.3f' % line['in_qty']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % line['in_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.3f' % line['out_qty']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % line['out_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.3f' % line['closing_qty']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % line['closing_value']"/></td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td style="border: 1px solid #000; padding: 2px;" colspan="6">Разом</td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % totals['opening_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px;"></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % totals['in_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px;"></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % totals['out_value']"/></td>
                                    <td style="border: 1px solid #000; padding: 2px;"></td>
                                    <td style="border: 1px solid #000; padding: 2px; text-align: right;"><t t-out="'%.2f' % totals['closing_value']"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- The basis of the amounts is printed, not implied:
                             a reader must not mistake cost-price figures for a
                             valuation taken from the accounting layers. -->
                        <div style="font-size: 8pt; margin-top: 4px;">
                            Суми наведено за обліковою ціною номенклатури (собівартість на момент друку).
                        </div>

                        <table style="width: 100%; margin-top: 24px;">
                            <tr>
                                <td style="width: 50%;">
                                    Матеріально відповідальна особа ____________________
                                </td>
                                <td style="width: 50%;">
                                    Перевірив ____________________
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
