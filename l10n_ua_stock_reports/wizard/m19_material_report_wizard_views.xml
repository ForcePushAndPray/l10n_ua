<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_m19_material_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ua.m19.material.report.wizard.form</field>
        <field name="model">l10n_ua.m19.material.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Матеріальний звіт (М-19)">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="location_id"/>
                    </group>
                    <group>
                        <field name="responsible_person"/>
                        <field name="include_zero"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Друк" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Скасувати" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_m19_material_report_wizard" model="ir.actions.act_window">
        <field name="name">Матеріальний звіт (М-19)</field>
        <field name="res_model">l10n_ua.m19.material.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_m19_material_report"
              name="Матеріальний звіт (М-19)"
              parent="stock.menu_warehouse_report"
              action="action_m19_material_report_wizard"
              sequence="90"/>

</odoo>
