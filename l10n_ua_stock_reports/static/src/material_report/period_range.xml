<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A button carrying the already applied period, not a field. A field
         promises a step that does not exist: you fill it in and confirm it
         somewhere, so the reader hunts for a "Generate" button. A button states
         the state — "the report is currently for this period" — and the
         question never arises. Changing it is a job for the dialog behind the
         button, where the two dates are ordinary form fields. -->
    <t t-name="l10n_ua_stock_reports.MaterialReportPeriodRange">
        <div t-if="state.available"
             class="o_l10n_ua_material_report_period d-print-none">
            <button class="btn btn-secondary text-nowrap"
                    t-att-class="{ o_period_just_applied: state.justApplied }"
                    t-on-click="onOpen">
                <i t-if="state.pending" class="fa fa-fw fa-circle-o-notch fa-spin me-1"/>
                <i t-else="" class="fa fa-fw fa-calendar me-1"/>
                <t t-out="label"/>
            </button>
        </div>
    </t>

</templates>
