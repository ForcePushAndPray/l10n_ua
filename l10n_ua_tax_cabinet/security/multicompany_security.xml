<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             These models carry company_id but had NO multi-company rule,
             so records leaked across ALL companies, including non-UA ones.
             Standard Odoo pattern (see l10n_ua_account_vat). -->

        <record id="l10n_ua_tax_cabinet_config_company_rule" model="ir.rule">
            <field name="name">Конфігурація Електронного кабінету: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_tax_cabinet_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_company_kved_company_rule" model="ir.rule">
            <field name="name">КВЕД компанії: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_company_kved"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
