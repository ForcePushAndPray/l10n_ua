<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_tax_request_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.request.form</field>
        <field name="model">l10n_ua.tax.request</field>
        <field name="arch" type="xml">
            <form string="Запит до ДПС">
                <header>
                    <button name="action_generate_xml" string="Сформувати XML"
                            type="object" class="btn-secondary"
                            invisible="state in ('submitted', 'answered') or request_type != 'j1300205'"/>
                    <button name="action_submit" string="Підписати і подати"
                            type="object" class="btn-primary"
                            invisible="state in ('submitted', 'answered') or request_type != 'j1300205'"/>
                    <button name="action_draft" string="Повернути в чернетку"
                            type="object" invisible="state == 'draft' or tax_document_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,submitted,answered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_response" type="object"
                                class="oe_stat_button" icon="fa-envelope-open-o"
                                invisible="not response_document_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Відповідь ДПС</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_type" readonly="tax_document_id or response_document_id"/>
                            <field name="request_date"/>
                            <label for="period_from" string="Період"
                                   invisible="not period_from"/>
                            <div class="o_row" invisible="not period_from">
                                <field name="period_from" readonly="1"/> —
                                <field name="period_to" readonly="1"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="submission_date" invisible="state not in ('submitted', 'answered')"/>
                            <field name="tax_document_id" invisible="not tax_document_id"/>
                            <field name="response_document_id" invisible="not response_document_id"/>
                            <field name="xml_filename" invisible="1"/>
                            <field name="xml_file" filename="xml_filename"
                                   invisible="not xml_file"/>
                        </group>
                    </group>
                    <group string="Квитанція" invisible="not response_receipt">
                        <field name="response_receipt" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_tax_request_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax.request.list</field>
        <field name="model">l10n_ua.tax.request</field>
        <field name="arch" type="xml">
            <list string="Запити до ДПС">
                <field name="name"/>
                <field name="request_type"/>
                <field name="request_date"/>
                <field name="period_from" optional="show"/>
                <field name="period_to" optional="show"/>
                <field name="submission_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'answered'"
                       decoration-primary="state == 'submitted'"
                       decoration-info="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_tax_request_action" model="ir.actions.act_window">
        <field name="name">Запити до ДПС</field>
        <field name="res_model">l10n_ua.tax.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ua_tax_cabinet_requests"
              name="Requests to DPS"
              parent="l10n_ua_tax.menu_ua_tax_reporting"
              action="l10n_ua_tax_request_action"
              sequence="80"/>

</odoo>
