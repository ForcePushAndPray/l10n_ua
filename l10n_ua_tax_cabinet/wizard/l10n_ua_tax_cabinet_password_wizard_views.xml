<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_tax_cabinet_password_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.cabinet.password.wizard.form</field>
        <field name="model">l10n_ua.tax.cabinet.password.wizard</field>
        <field name="arch" type="xml">
            <form string="KEP Password">
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="action" invisible="1"/>
                    <field name="document_id" readonly="1"
                           invisible="action not in ('redownload', 'sign', 'submit')"/>
                    <field name="password" password="True" placeholder="Enter KEP password"/>
                </group>

                <!-- Info message based on action -->
                <div class="alert alert-warning" role="alert" invisible="action != 'sign'">
                    <p><strong>Sign Document:</strong> The XML document will be signed with your KEP.</p>
                </div>
                <div class="alert alert-danger" role="alert" invisible="action != 'submit'">
                    <p><strong>⚠️ PRODUCTION SUBMISSION:</strong></p>
                    <p>The document will be signed, encrypted and submitted to <strong>cabinet.tax.gov.ua</strong> (production).</p>
                    <p><em>Note: There is no test environment for report submission. This document will be sent to the real Tax Office (DPS).</em></p>
                </div>

                <!-- Sync options (only visible for sync action) -->
                <group string="Sync Options" invisible="action != 'sync'">
                    <field name="sync_mode" widget="radio"/>
                    <group>
                        <field name="year"/>
                        <field name="month"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert">
                    <p><strong>Security Notice:</strong> Your password is not stored and will only be used for this operation.</p>
                </div>

                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
