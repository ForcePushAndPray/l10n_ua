<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_vat_register_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.vat.register.form</field>
        <field name="model">l10n_ua.vat.register</field>
        <field name="arch" type="xml">
            <form string="VAT Register">
                <sheet>
                    <group>
                        <group>
                            <field name="register_type"/>
                            <field name="period_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="total_base"/>
                            <field name="total_vat"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="partner_ipn"/>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date"/>
                                    <field name="base_amount" sum="Total"/>
                                    <field name="vat_rate"/>
                                    <field name="vat_amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_vat_register_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.vat.register.list</field>
        <field name="model">l10n_ua.vat.register</field>
        <field name="arch" type="xml">
            <list string="VAT Registers">
                <field name="name"/>
                <field name="register_type"/>
                <field name="period_id"/>
                <field name="total_base" sum="Total"/>
                <field name="total_vat" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_vat_register_action" model="ir.actions.act_window">
        <field name="name">VAT Registers</field>
        <field name="res_model">l10n_ua.vat.register</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
