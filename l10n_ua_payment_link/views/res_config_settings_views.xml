<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_payment_link" model="ir.ui.view">
        <field name="name">res.config.settings.form.payment.link.ua</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting string="QR-код НБУ на рахунках"
                         help="Додавати QR-код для оплати за стандартом НБУ на друковані рахунки (Proforma Invoice)"
                         company_dependent="1">
                    <field name="l10n_ua_nbu_qr_on_invoices"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
