<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_inherit_payment_link" model="ir.ui.view">
        <field name="name">account.move.form.payment.link</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="before">
                <page string="Оплата" name="payment_links"
                      invisible="move_type != 'out_invoice'">
                    <group string="QR-код для оплати (стандарт НБУ)">
                        <field name="nbu_payment_link" widget="CopyClipboardURL" readonly="1"
                               invisible="not nbu_payment_link"/>
                        <div invisible="nbu_payment_link" colspan="2">
                            <span class="text-muted">Для генерації QR-коду налаштуйте IBAN та ЄДРПОУ компанії</span>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
