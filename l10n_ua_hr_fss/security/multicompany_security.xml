<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rule (issue #178).
             hr.fss.settlement carries company_id but had no multi-company
             ir.rule, so records leaked across ALL companies. -->

        <record id="hr_fss_settlement_company_rule" model="ir.rule">
            <field name="name">Розрахунок з ФСС: multi-company</field>
            <field name="model_id" ref="model_hr_fss_settlement"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
