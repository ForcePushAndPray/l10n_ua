<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_order_tree" model="ir.ui.view">
        <field name="name">hr.order.tree</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="order_type"/>
                <field name="employee_id"/>
                <field name="subject"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_order_form" model="ir.ui.view">
        <field name="name">hr.order.form</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state not in ('confirmed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_type"/>
                            <field name="date"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_order_search" model="ir.ui.view">
        <field name="name">hr.order.search</field>
        <field name="model">hr.order</field>
        <field name="arch" type="xml">
            <search string="HR Orders">
                <field name="name"/>
                <field name="subject"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Hiring" name="hiring" domain="[('order_type', '=', 'hiring')]"/>
                <filter string="Dismissal" name="dismissal" domain="[('order_type', '=', 'dismissal')]"/>
                <filter string="Transfer" name="transfer" domain="[('order_type', '=', 'transfer')]"/>
                <filter string="Vacation" name="vacation" domain="[('order_type', '=', 'vacation')]"/>
                <separator/>
                <filter string="Type" name="group_type" context="{'group_by': 'order_type'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_order" model="ir.actions.act_window">
        <field name="name">HR Orders</field>
        <field name="res_model">hr.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first HR order
            </p>
            <p>
                HR orders include hiring, dismissal, transfer, vacation, and other personnel documents.
            </p>
        </field>
    </record>

</odoo>
