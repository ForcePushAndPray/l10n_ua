<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_ua_hr" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ua.hr</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ukrainian HR" name="ua_hr">
                    <group>
                        <group string="Registration">
                            <field name="edrpou"/>
                            <field name="koatuu"/>
                            <field name="kved_main"/>
                            <field name="ownership_form"/>
                        </group>
                        <group string="Tax &amp; Pension">
                            <field name="tax_office_code"/>
                            <field name="pension_fund_code"/>
                        </group>
                    </group>
                    <group>
                        <group string="Responsible Persons">
                            <field name="director_id"/>
                            <field name="accountant_id"/>
                            <field name="hr_manager_id"/>
                        </group>
                        <group string="Legal Address">
                            <field name="legal_address"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
