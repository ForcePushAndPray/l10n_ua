<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_benefit_tree" model="ir.ui.view">
        <field name="name">hr.employee.benefit.tree</field>
        <field name="model">hr.employee.benefit</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="psp_type"/>
                <field name="psp_multiplier"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_benefit_form" model="ir.ui.view">
        <field name="name">hr.employee.benefit.form</field>
        <field name="model">hr.employee.benefit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="psp_type"/>
                            <field name="psp_multiplier"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_benefit_search" model="ir.ui.view">
        <field name="name">hr.employee.benefit.search</field>
        <field name="model">hr.employee.benefit</field>
        <field name="arch" type="xml">
            <search string="Employee Benefits">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="With PSP" name="with_psp" domain="[('psp_type', '!=', 'none')]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_benefit" model="ir.actions.act_window">
        <field name="name">Employee Benefits</field>
        <field name="res_model">hr.employee.benefit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
