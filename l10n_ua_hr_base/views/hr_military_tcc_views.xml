<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_military_tcc_tree" model="ir.ui.view">
        <field name="name">hr.military.tcc.tree</field>
        <field name="model">hr.military.tcc</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="region_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_hr_military_tcc_form" model="ir.ui.view">
        <field name="name">hr.military.tcc.form</field>
        <field name="model">hr.military.tcc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="region_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_military_tcc_search" model="ir.ui.view">
        <field name="name">hr.military.tcc.search</field>
        <field name="model">hr.military.tcc</field>
        <field name="arch" type="xml">
            <search string="Territorial Recruitment Centers">
                <field name="name"/>
                <field name="region_id"/>
            </search>
        </field>
    </record>

    <record id="action_hr_military_tcc" model="ir.actions.act_window">
        <field name="name">Territorial Recruitment Centers</field>
        <field name="res_model">hr.military.tcc</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
