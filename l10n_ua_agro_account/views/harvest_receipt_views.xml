<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ua_agro_harvest_receipt_view_form_account" model="ir.ui.view">
        <field name="name">l10n_ua.agro.harvest.receipt.form.account</field>
        <field name="model">l10n_ua.agro.harvest.receipt</field>
        <field name="inherit_id" ref="l10n_ua_agro_harvest.l10n_ua_agro_harvest_receipt_view_form"/>
        <field name="arch" type="xml">
            <field name="credit_weight" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="valuation_price" invisible="not account_move_id"/>
                <field name="valuation_amount" invisible="not account_move_id"/>
                <field name="account_move_id" invisible="not account_move_id"
                       groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>
    <record id="l10n_ua_agro_harvest_receipt_view_list_account" model="ir.ui.view">
        <field name="name">l10n_ua.agro.harvest.receipt.list.account</field>
        <field name="model">l10n_ua.agro.harvest.receipt</field>
        <field name="inherit_id" ref="l10n_ua_agro_harvest.l10n_ua_agro_harvest_receipt_view_list"/>
        <field name="arch" type="xml">
            <field name="credit_weight" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="valuation_amount" sum="Total" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
