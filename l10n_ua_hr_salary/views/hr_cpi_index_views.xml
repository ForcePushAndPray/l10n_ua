<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_cpi_index_view_tree" model="ir.ui.view">
        <field name="name">hr.cpi.index.list</field>
        <field name="model">hr.cpi.index</field>
        <field name="arch" type="xml">
            <list string="Consumer Price Index" editable="top" default_order="month desc">
                <field name="month"/>
                <field name="index_value"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="hr_cpi_index_view_form" model="ir.ui.view">
        <field name="name">hr.cpi.index.form</field>
        <field name="model">hr.cpi.index</field>
        <field name="arch" type="xml">
            <form string="Consumer Price Index">
                <sheet>
                    <group>
                        <field name="month"/>
                        <field name="index_value"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_cpi_index_view_search" model="ir.ui.view">
        <field name="name">hr.cpi.index.search</field>
        <field name="model">hr.cpi.index</field>
        <field name="arch" type="xml">
            <search string="Consumer Price Index">
                <field name="month"/>
                <group>
                    <filter string="Year" name="groupby_year" domain="[]"
                            context="{'group_by': 'month:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_cpi_index" model="ir.actions.act_window">
        <field name="name">Consumer Price Index</field>
        <field name="res_model">hr.cpi.index</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Заведіть місячні індекси споживчих цін
            </p>
            <p>
                Індекси споживчих цін (ІСЦ) використовуються для розрахунку
                індексації заробітної плати. Значення — у відсотках до
                попереднього місяця (напр. 100.5).
            </p>
        </field>
    </record>

</odoo>
