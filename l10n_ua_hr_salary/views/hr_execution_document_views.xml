<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_execution_document_view_form" model="ir.ui.view">
        <field name="name">hr.execution.document.form</field>
        <field name="model">hr.execution.document</field>
        <field name="arch" type="xml">
            <form string="Execution Document">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state in ('closed', 'draft')"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state not in ('suspended',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Document Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="document_type"/>
                            <field name="deduction_priority"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Recipient">
                        <group>
                            <field name="recipient_name"/>
                            <field name="recipient_rnokpp"/>
                        </group>
                        <group>
                            <field name="recipient_account"/>
                            <field name="recipient_bank"/>
                        </group>
                    </group>
                    <group string="Calculation">
                        <group>
                            <field name="calculation_method"/>
                            <field name="percent_value" invisible="calculation_method != 'percent'"/>
                            <field name="fixed_amount" invisible="calculation_method == 'percent'"/>
                        </group>
                        <group>
                            <field name="max_deduction_percent"/>
                            <field name="total_amount"/>
                            <field name="collected_amount"/>
                            <field name="remaining_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_execution_document_view_tree" model="ir.ui.view">
        <field name="name">hr.execution.document.tree</field>
        <field name="model">hr.execution.document</field>
        <field name="arch" type="xml">
            <list string="Execution Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_type"/>
                <field name="recipient_name"/>
                <field name="calculation_method"/>
                <field name="percent_value"/>
                <field name="fixed_amount"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'suspended'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="hr_execution_document_view_search" model="ir.ui.view">
        <field name="name">hr.execution.document.search</field>
        <field name="model">hr.execution.document</field>
        <field name="arch" type="xml">
            <search string="Search Execution Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="recipient_name"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_alimony" string="Alimony" domain="[('document_type', '=', 'alimony')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_execution_document" model="ir.actions.act_window">
        <field name="name">Execution Documents</field>
        <field name="res_model">hr.execution.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_execution_document_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an execution document
            </p>
            <p>
                Execution documents are used for automatic deductions like alimony,
                court decisions, and other mandatory payments.
            </p>
        </field>
    </record>

</odoo>
