<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_seniority_scale_form" model="ir.ui.view">
        <field name="name">hr.seniority.scale.form</field>
        <field name="model">hr.seniority.scale</field>
        <field name="arch" type="xml">
            <form string="Шкала вислуги років">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Назва шкали"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="years_from"/>
                            <field name="percent"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_seniority_scale_list" model="ir.ui.view">
        <field name="name">hr.seniority.scale.list</field>
        <field name="model">hr.seniority.scale</field>
        <field name="arch" type="xml">
            <list string="Шкали вислуги років">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_hr_seniority_scale" model="ir.actions.act_window">
        <field name="name">Шкали вислуги років</field>
        <field name="res_model">hr.seniority.scale</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
