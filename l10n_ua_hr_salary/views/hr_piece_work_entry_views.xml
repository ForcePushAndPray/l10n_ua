<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_piece_work_entry_form" model="ir.ui.view">
        <field name="name">hr.piece.work.entry.form</field>
        <field name="model">hr.piece.work.entry</field>
        <field name="arch" type="xml">
            <form string="Наряд відрядної оплати">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_rate"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_piece_work_entry_list" model="ir.ui.view">
        <field name="name">hr.piece.work.entry.list</field>
        <field name="model">hr.piece.work.entry</field>
        <field name="arch" type="xml">
            <list string="Наряди відрядної оплати" editable="bottom">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="unit_rate"/>
                <field name="amount" sum="Разом"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_piece_work_entry_search" model="ir.ui.view">
        <field name="name">hr.piece.work.entry.search</field>
        <field name="model">hr.piece.work.entry</field>
        <field name="arch" type="xml">
            <search string="Наряди відрядної оплати">
                <field name="employee_id"/>
                <field name="name"/>
                <filter string="Цей місяць" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Працівник" name="groupby_employee" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Дата" name="groupby_date" domain="[]"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_piece_work_entry" model="ir.actions.act_window">
        <field name="name">Наряди відрядної оплати</field>
        <field name="res_model">hr.piece.work.entry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_this_month': 1, 'search_default_groupby_employee': 1}</field>
    </record>

</odoo>
