<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_salary_advance_view_form" model="ir.ui.view">
        <field name="name">hr.salary.advance.form</field>
        <field name="model">hr.salary.advance</field>
        <field name="arch" type="xml">
            <form string="Salary Advance">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('confirmed',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Batch &amp; Payroll Integration"
                           invisible="not payslip_id and not advance_run_id">
                        <field name="advance_run_id" readonly="1"
                               invisible="not advance_run_id"/>
                        <field name="payslip_id" readonly="1"
                               invisible="not payslip_id"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_salary_advance_view_list" model="ir.ui.view">
        <field name="name">hr.salary.advance.list</field>
        <field name="model">hr.salary.advance</field>
        <field name="arch" type="xml">
            <list string="Salary Advances"
                  decoration-muted="state == 'paid'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="hr_salary_advance_view_search" model="ir.ui.view">
        <field name="name">hr.salary.advance.search</field>
        <field name="model">hr.salary.advance</field>
        <field name="arch" type="xml">
            <search string="Salary Advances">
                <field name="name"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Month" name="filter_last_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() - relativedelta(months=1, day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="groupby_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="groupby_department" domain="[]" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_salary_advance" model="ir.actions.act_window">
        <field name="name">Salary Advances</field>
        <field name="res_model">hr.salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first salary advance</p>
            <p>Confirmed advances are automatically deducted from the payslip.</p>
        </field>
    </record>

</odoo>

