<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button name="action_compute_sheet" string="Compute Sheet" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_payslip_verify" string="Verify" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_payslip_done" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'verify'"/>
                    <button name="action_payslip_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_payslip_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancel'"/>
                    <button name="action_print_payslip" string="Print" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verify,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="version_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="payslip_run_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Worked Time" name="worked_time">
                            <group>
                                <group string="Scheduled">
                                    <field name="scheduled_days"/>
                                    <field name="scheduled_hours"/>
                                </group>
                                <group string="Worked">
                                    <field name="worked_days"/>
                                    <field name="worked_hours"/>
                                </group>
                            </group>
                        </page>
                        <page string="Accruals" name="accruals">
                            <field name="accrual_ids">
                                <list editable="bottom">
                                    <field name="accrual_type_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="is_taxable_pdfo"/>
                                    <field name="is_esv_base"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="gross_salary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Taxes &amp; Deductions" name="deductions">
                            <group>
                                <group string="PSP (Tax Social Benefit)">
                                    <field name="psp_eligible"/>
                                    <field name="psp_type"/>
                                    <field name="psp_amount"/>
                                </group>
                                <group string="PDFO">
                                    <field name="pdfo_base"/>
                                    <field name="pdfo_rate"/>
                                    <field name="pdfo_amount"/>
                                </group>
                            </group>
                            <group>
                                <group string="Military Tax">
                                    <field name="military_tax_base"/>
                                    <field name="military_tax_rate"/>
                                    <field name="military_tax_amount"/>
                                </group>
                                <group string="ESV (Employer)">
                                    <field name="esv_base"/>
                                    <field name="esv_rate"/>
                                    <field name="esv_amount"/>
                                </group>
                            </group>
                            <separator string="Other Deductions"/>
                            <field name="deduction_ids">
                                <list editable="bottom">
                                    <field name="deduction_type_id"/>
                                    <field name="base_amount"/>
                                    <field name="rate"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="execution_doc_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary" name="summary">
                            <group>
                                <group>
                                    <field name="gross_salary"/>
                                    <field name="pdfo_amount"/>
                                    <field name="military_tax_amount"/>
                                    <field name="other_deductions"/>
                                    <field name="total_deductions"/>
                                </group>
                                <group>
                                    <field name="net_salary" class="oe_subtotal_footer_separator"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="esv_amount" string="ESV (Employer Cost)"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_payslip_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.tree</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips" decoration-muted="state == 'cancel'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_salary" sum="Total Gross"/>
                <field name="pdfo_amount" sum="Total PDFO" optional="hide"/>
                <field name="military_tax_amount" sum="Total Military" optional="hide"/>
                <field name="net_salary" sum="Total Net"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'verify'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

<record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first payslip
            </p>
        </field>
    </record>

</odoo>
