<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_company_view_form_payroll_bank" model="ir.ui.view">
        <field name="name">res.company.form.payroll.bank</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Зарплатний банк-файл (клієнт-банк)"
                       groups="l10n_ua_hr_base.group_hr_ua_manager">
                    <field name="payroll_bank_account_id"/>
                    <field name="payroll_bank_file_format"/>
                    <field name="payroll_payment_purpose"/>
                    <field name="payroll_transit_account_id"
                           invisible="payroll_bank_file_format not in ('ifobs',)"/>
                    <field name="payroll_salary_project_code"
                           invisible="payroll_bank_file_format not in ('ifobs',)"/>
                    <field name="payroll_accrual_name"
                           invisible="payroll_bank_file_format not in ('ifobs', 'ibank2')"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
