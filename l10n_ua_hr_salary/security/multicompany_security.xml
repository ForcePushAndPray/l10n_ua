<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             Models below carry a stored company_id but had no multi-company
             ir.rule, so records leaked across ALL companies. These global
             rules scope each model to the user's allowed companies. -->

        <record id="hr_execution_document_company_rule" model="ir.rule">
            <field name="name">Виконавчий документ: multi-company</field>
            <field name="model_id" ref="model_hr_execution_document"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_payslip_company_rule" model="ir.rule">
            <field name="name">Розрахунковий листок: multi-company</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_payslip_run_company_rule" model="ir.rule">
            <field name="name">Відомість нарахування: multi-company</field>
            <field name="model_id" ref="model_hr_payslip_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_salary_advance_company_rule" model="ir.rule">
            <field name="name">Аванс: multi-company</field>
            <field name="model_id" ref="model_hr_salary_advance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_salary_advance_run_company_rule" model="ir.rule">
            <field name="name">Відомість авансу: multi-company</field>
            <field name="model_id" ref="model_hr_salary_advance_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_psp_parameters_company_rule" model="ir.rule">
            <field name="name">Параметри ПСП: multi-company</field>
            <field name="model_id" ref="model_hr_psp_parameters"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Models with company_id missed by the initial #178 sweep: without
             a rule their records were visible across ALL companies. -->

        <record id="hr_salary_deposit_company_rule" model="ir.rule">
            <field name="name">Депонент: multi-company</field>
            <field name="model_id" ref="model_hr_salary_deposit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_piece_work_entry_company_rule" model="ir.rule">
            <field name="name">Відрядний виробіток: multi-company</field>
            <field name="model_id" ref="model_hr_piece_work_entry"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_cpi_index_company_rule" model="ir.rule">
            <field name="name">Індекс споживчих цін: multi-company</field>
            <field name="model_id" ref="model_hr_cpi_index"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="hr_seniority_scale_company_rule" model="ir.rule">
            <field name="name">Шкала вислуги років: multi-company</field>
            <field name="model_id" ref="model_hr_seniority_scale"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
