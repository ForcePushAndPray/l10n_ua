<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Передвизначені графіки роботи як штатні resource.calendar (#213).
             Заміна hr.work.schedule: норму годин рахує саме ядро з рядків
             attendance_ids, тож зарплата і відпустки більше не можуть
             розійтися.

             attendance_ids задаємо явно навіть там, де він порожній: штатний
             _compute_attendance_ids копіює сітку календаря компанії в кожен
             новий календар, тож без (5, 0, 0) змінні графіки мовчки отримали б
             чужий 5-денний тиждень.

             Змінні цикли (2/2, доба/три, 3/3) і підсумований облік на тижневу
             сітку не лягають — вони позначені штатним schedule_type='flexible',
             через що ядро не перераховує hours_per_week/hours_per_day, і
             норма береться з наших явних значень. Планування самих змін —
             окрема задача (hr.production.calendar). -->

        <record id="resource_calendar_ua_std40" model="resource.calendar">
            <field name="name">Стандартний 5-денний (40 год/тиждень)</field>
            <field name="ua_code">STD40</field>
            <field name="ua_schedule_type">standard</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Ранок', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 13.0}) for d in range(5)
            ] + [
                (0, 0, {'name': 'Друга половина дня', 'dayofweek': str(d), 'day_period': 'afternoon',
                        'hour_from': 14.0, 'hour_to': 18.0}) for d in range(5)
            ]"/>
        </record>

        <record id="resource_calendar_ua_std36" model="resource.calendar">
            <field name="name">Скорочений 5-денний (36 год/тиждень)</field>
            <field name="ua_code">STD36</field>
            <field name="ua_schedule_type">standard</field>
            <field name="ua_reduced_hours" eval="True"/>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Ранок', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 13.0}) for d in range(5)
            ] + [
                (0, 0, {'name': 'Друга половина дня', 'dayofweek': str(d), 'day_period': 'afternoon',
                        'hour_from': 14.0, 'hour_to': 17.2}) for d in range(5)
            ]"/>
        </record>

        <record id="resource_calendar_ua_std24" model="resource.calendar">
            <field name="name">Скорочений (24 год/тиждень)</field>
            <field name="ua_code">STD24</field>
            <field name="ua_schedule_type">standard</field>
            <field name="ua_reduced_hours" eval="True"/>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Робочий день', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 13.8}) for d in range(5)
            ]"/>
        </record>

        <record id="resource_calendar_ua_part20" model="resource.calendar">
            <field name="name">Неповний робочий день (0.5 ставки)</field>
            <field name="ua_code">PART20</field>
            <field name="ua_schedule_type">standard</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Робочий день', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 13.0}) for d in range(5)
            ]"/>
        </record>

        <record id="resource_calendar_ua_std6d" model="resource.calendar">
            <field name="name">6-денний робочий тиждень</field>
            <field name="ua_code">STD6D</field>
            <field name="ua_schedule_type">standard</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Робочий день', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 15.6667}) for d in range(6)
            ]"/>
        </record>

        <record id="resource_calendar_ua_flex" model="resource.calendar">
            <field name="name">Гнучкий графік</field>
            <field name="ua_code">FLEX</field>
            <field name="ua_schedule_type">flexible</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)] + [
                (0, 0, {'name': 'Ранок', 'dayofweek': str(d), 'day_period': 'morning',
                        'hour_from': 9.0, 'hour_to': 13.0}) for d in range(5)
            ] + [
                (0, 0, {'name': 'Друга половина дня', 'dayofweek': str(d), 'day_period': 'afternoon',
                        'hour_from': 14.0, 'hour_to': 18.0}) for d in range(5)
            ]"/>
        </record>

        <!-- Змінні цикли: тижневої сітки немає, норму задаємо явно -->

        <record id="resource_calendar_ua_shift2x2" model="resource.calendar">
            <field name="name">Змінний 2/2 (12 год)</field>
            <field name="ua_code">SHIFT2X2</field>
            <field name="ua_schedule_type">shift</field>
            <field name="schedule_type">flexible</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]"/>
            <field name="hours_per_week">42</field>
            <field name="hours_per_day">12</field>
        </record>

        <record id="resource_calendar_ua_shift1x3" model="resource.calendar">
            <field name="name">Змінний доба/три</field>
            <field name="ua_code">SHIFT1X3</field>
            <field name="ua_schedule_type">shift</field>
            <field name="schedule_type">flexible</field>
            <field name="ua_is_night_work" eval="True"/>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]"/>
            <field name="hours_per_week">42</field>
            <field name="hours_per_day">24</field>
        </record>

        <record id="resource_calendar_ua_shift3x3" model="resource.calendar">
            <field name="name">Змінний 3/3 (8 год)</field>
            <field name="ua_code">SHIFT3X3</field>
            <field name="ua_schedule_type">shift</field>
            <field name="schedule_type">flexible</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]"/>
            <field name="hours_per_week">28</field>
            <field name="hours_per_day">8</field>
        </record>

        <record id="resource_calendar_ua_summ" model="resource.calendar">
            <field name="name">Підсумований облік (місяць)</field>
            <field name="ua_code">SUMM</field>
            <field name="ua_schedule_type">summarized</field>
            <field name="schedule_type">flexible</field>
            <field name="tz">Europe/Kiev</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]"/>
            <field name="hours_per_week">40</field>
            <field name="hours_per_day">8</field>
        </record>

    </data>
</odoo>
