<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_job_combining_tree" model="ir.ui.view">
        <field name="name">hr.job.combining.tree</field>
        <field name="model">hr.job.combining</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="combined_job_id"/>
                <field name="combined_department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="surcharge_type"/>
                <field name="calculated_surcharge"/>
                <field name="order_number"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'active'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_job_combining_form" model="ir.ui.view">
        <field name="name">hr.job.combining.form</field>
        <field name="model">hr.job.combining</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'active'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="main_contract_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Combined Position">
                            <field name="combined_job_id"/>
                            <field name="combined_department_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Surcharge">
                            <field name="surcharge_type"/>
                            <field name="surcharge_percent" invisible="surcharge_type != 'percent'"/>
                            <field name="surcharge_amount" invisible="surcharge_type != 'fixed'"/>
                            <field name="calculated_surcharge"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Order References">
                        <group>
                            <field name="order_number"/>
                            <field name="order_date"/>
                        </group>
                        <group>
                            <field name="cancellation_order_number"/>
                            <field name="cancellation_order_date"/>
                        </group>
                    </group>
                    <group string="Related Allowance" invisible="not allowance_id">
                        <field name="allowance_id"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_job_combining_search" model="ir.ui.view">
        <field name="name">hr.job.combining.search</field>
        <field name="model">hr.job.combining</field>
        <field name="arch" type="xml">
            <search string="Job Combining">
                <field name="employee_id"/>
                <field name="combined_job_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Combined Position" name="group_job" domain="[]" context="{'group_by': 'combined_job_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_job_combining" model="ir.actions.act_window">
        <field name="name">Job Combining</field>
        <field name="res_model">hr.job.combining</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record job combining for employees
            </p>
            <p>
                Track employees who perform duties of combined positions with surcharges.
            </p>
        </field>
    </record>

</odoo>
