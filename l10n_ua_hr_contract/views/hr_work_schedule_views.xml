<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_work_schedule_view_form" model="ir.ui.view">
        <field name="name">hr.work.schedule.form</field>
        <field name="model">hr.work.schedule</field>
        <field name="arch" type="xml">
            <form string="Work Schedule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Schedule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="schedule_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="hours_per_week"/>
                            <field name="hours_per_day"/>
                            <field name="working_days_per_week"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Special Conditions">
                            <field name="is_night_work"/>
                            <field name="night_start_hour" invisible="not is_night_work"/>
                            <field name="night_end_hour" invisible="not is_night_work"/>
                            <field name="is_hazardous"/>
                            <field name="reduced_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="is_working_day"/>
                                    <field name="work_from" widget="float_time"/>
                                    <field name="work_to" widget="float_time"/>
                                    <field name="break_from" widget="float_time"/>
                                    <field name="break_to" widget="float_time"/>
                                    <field name="working_hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_work_schedule_view_tree" model="ir.ui.view">
        <field name="name">hr.work.schedule.tree</field>
        <field name="model">hr.work.schedule</field>
        <field name="arch" type="xml">
            <list string="Work Schedules">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="schedule_type"/>
                <field name="hours_per_week"/>
                <field name="hours_per_day"/>
                <field name="is_night_work"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_work_schedule_view_search" model="ir.ui.view">
        <field name="name">hr.work.schedule.search</field>
        <field name="model">hr.work.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Work Schedules">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="filter_standard" string="Standard" domain="[('schedule_type', '=', 'standard')]"/>
                <filter name="filter_shift" string="Shift Work" domain="[('schedule_type', '=', 'shift')]"/>
                <filter name="filter_flexible" string="Flexible" domain="[('schedule_type', '=', 'flexible')]"/>
                <separator/>
                <filter name="filter_night" string="Night Work" domain="[('is_night_work', '=', True)]"/>
                <filter name="filter_hazardous" string="Hazardous" domain="[('is_hazardous', '=', True)]"/>
                <separator/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Schedule Type" context="{'group_by': 'schedule_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_work_schedule" model="ir.actions.act_window">
        <field name="name">Work Schedules</field>
        <field name="res_model">hr.work.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_work_schedule_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first work schedule
            </p>
        </field>
    </record>

</odoo>
