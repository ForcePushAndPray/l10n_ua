<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_employee_view_form_job_combining" model="ir.ui.view">
        <field name="name">hr.employee.form.job.combining</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_job_combining" type="object"
                        class="oe_stat_button" icon="fa-briefcase"
                        groups="hr.group_hr_user">
                    <field name="job_combining_count" widget="statinfo" string="Job Combining"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
