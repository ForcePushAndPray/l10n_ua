<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_open" string="Confirm" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" 
                            invisible="state != 'open'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ('close', 'cancel')"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state not in ('cancel',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Contract Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="contract_type_ua"/>
                            <field name="date_start"/>
                            <field name="date_end" invisible="contract_type_ua == 'permanent'"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Details" name="details">
                            <group>
                                <group string="Employment Type">
                                    <field name="is_main_workplace"/>
                                    <field name="is_part_time"/>
                                    <field name="part_time_type" invisible="not is_part_time"/>
                                    <field name="diia_city_employee"/>
                                </group>
                                <group string="Working Time">
                                    <field name="work_mode"/>
                                    <field name="work_schedule_id"/>
                                    <field name="working_hours_week"/>
                                    <field name="work_rate"/>
                                </group>
                            </group>
                            <group>
                                <group string="Probation">
                                    <field name="probation_period_days"/>
                                    <field name="probation_end_date"/>
                                </group>
                                <group string="Staffing">
                                    <field name="staffing_line_id" 
                                           domain="[('company_id', '=', company_id), ('state', '=', 'approved')]"/>
                                    <field name="tariff_grade_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Salary" name="salary">
                            <group>
                                <group>
                                    <field name="wage"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_allowances"/>
                                    <field name="total_wage"/>
                                </group>
                            </group>
                            <separator string="Allowances"/>
                            <field name="allowance_ids">
                                <tree editable="bottom">
                                    <field name="allowance_type_id"/>
                                    <field name="calculation_method"/>
                                    <field name="amount" invisible="calculation_method != 'fixed'"/>
                                    <field name="percent" invisible="calculation_method == 'fixed'"/>
                                    <field name="calculated_amount"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="is_active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Orders" name="orders">
                            <group>
                                <group string="Hiring">
                                    <field name="hire_order_number"/>
                                    <field name="hire_order_date"/>
                                </group>
                                <group string="Termination">
                                    <field name="termination_reason_id"/>
                                    <field name="termination_date"/>
                                    <field name="termination_order_number"/>
                                    <field name="termination_order_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_contract_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.tree</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <tree string="Contracts" decoration-muted="state == 'cancel'" 
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="job_id"/>
                <field name="contract_type_ua"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'open'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('close', 'cancel')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="hr_contract_view_search" model="ir.ui.view">
        <field name="name">hr.contract.search</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'open')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'close')]"/>
                <separator/>
                <filter name="filter_main" string="Main Workplace" domain="[('is_main_workplace', '=', True)]"/>
                <filter name="filter_part_time" string="Part-time" domain="[('is_part_time', '=', True)]"/>
                <separator/>
                <filter name="filter_permanent" string="Permanent" domain="[('contract_type_ua', '=', 'permanent')]"/>
                <filter name="filter_fixed_term" string="Fixed Term" domain="[('contract_type_ua', '=', 'fixed_term')]"/>
                <filter name="filter_civil" string="Civil Law" domain="[('contract_type_ua', '=', 'civil')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="Contract Type" context="{'group_by': 'contract_type_ua'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_contract_view_kanban" model="ir.ui.view">
        <field name="name">hr.contract.kanban</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="wage"/>
                <field name="state"/>
                <field name="contract_type_ua"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <strong class="o_kanban_record_title">
                                    <field name="employee_id"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="job_id"/>
                                <br/>
                                <field name="wage" widget="monetary"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="contract_type_ua"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection" 
                                           options="{'classes': {'draft': 'info', 'open': 'success', 'close': 'secondary', 'cancel': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="hr_contract_view_search"/>
        <field name="context">{'search_default_filter_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first employment contract
            </p>
            <p>
                Contracts define the terms of employment including salary, working hours, and allowances.
            </p>
        </field>
    </record>

</odoo>
