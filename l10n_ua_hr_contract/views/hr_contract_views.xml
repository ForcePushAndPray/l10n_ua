<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.ua.form</field>
        <field name="model">hr.contract.ua</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_open" string="Confirm" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" 
                            invisible="state != 'open'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ('close', 'cancel')"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state not in ('cancel',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Contract Reference"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="contract_type_ua"/>
                            <field name="date_start"/>
                            <field name="date_end" invisible="contract_type_ua == 'permanent'"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Details" name="details">
                            <group>
                                <group string="Employment Type">
                                    <field name="is_main_workplace"/>
                                    <field name="is_part_time"/>
                                    <field name="part_time_type" invisible="not is_part_time"/>
                                    <field name="diia_city_employee"/>
                                </group>
                                <group string="Working Time">
                                    <field name="work_mode"/>
                                    <field name="work_schedule_id"/>
                                    <field name="working_hours_week"/>
                                    <field name="work_rate"/>
                                </group>
                            </group>
                            <group>
                                <group string="Probation">
                                    <field name="probation_period_days"/>
                                    <field name="probation_end_date"/>
                                </group>
                                <group string="Staffing">
                                    <field name="staffing_line_id"
                                           domain="[('company_id', '=', company_id), ('state', '=', 'approved')]"/>
                                    <field name="tariff_grade_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Work Conditions">
                                    <field name="work_conditions"/>
                                    <field name="work_conditions_class" invisible="work_conditions == 'normal'"/>
                                    <field name="work_conditions_subclass" invisible="work_conditions == 'normal'"/>
                                    <field name="additional_vacation_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="Salary" name="salary">
                            <group>
                                <group>
                                    <field name="wage"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_allowances"/>
                                    <field name="total_wage"/>
                                </group>
                            </group>
                            <separator string="Allowances"/>
                            <field name="allowance_ids"/>
                        </page>
                        <page string="Orders" name="orders">
                            <group>
                                <group string="Hiring">
                                    <field name="hire_order_number"/>
                                    <field name="hire_order_date"/>
                                </group>
                                <group string="Termination">
                                    <field name="termination_reason_id"/>
                                    <field name="termination_date"/>
                                    <field name="termination_order_number"/>
                                    <field name="termination_order_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Salary History" name="salary_history">
                            <field name="salary_change_ids" readonly="1">
                                <list>
                                    <field name="effective_date"/>
                                    <field name="old_wage"/>
                                    <field name="new_wage"/>
                                    <field name="change_percent"/>
                                    <field name="order_number"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Amendments" name="amendments">
                            <field name="amendment_ids" readonly="1">
                                <list>
                                    <field name="amendment_date"/>
                                    <field name="effective_date"/>
                                    <field name="amendment_type"/>
                                    <field name="description"/>
                                    <field name="order_number"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_contract_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.ua.tree</field>
        <field name="model">hr.contract.ua</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-muted="state == 'cancel'" 
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="job_id"/>
                <field name="contract_type_ua"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage" sum="Total"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'open'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state in ('close', 'cancel')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract.ua</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first employment contract
            </p>
        </field>
    </record>

</odoo>
