<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_contract_amendment_tree" model="ir.ui.view">
        <field name="name">hr.contract.amendment.tree</field>
        <field name="model">hr.contract.amendment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amendment_date"/>
                <field name="effective_date"/>
                <field name="employee_id"/>
                <field name="contract_id"/>
                <field name="amendment_type"/>
                <field name="order_number"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_amendment_form" model="ir.ui.view">
        <field name="name">hr.contract.amendment.form</field>
        <field name="model">hr.contract.amendment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Amendment">
                            <field name="amendment_number"/>
                            <field name="amendment_date"/>
                            <field name="effective_date"/>
                            <field name="amendment_type"/>
                        </group>
                        <group string="Contract">
                            <field name="contract_id"/>
                            <field name="employee_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Changes">
                            <group>
                                <group string="Previous Values">
                                    <field name="old_values" nolabel="1" readonly="1"/>
                                </group>
                                <group string="New Values">
                                    <field name="new_values" nolabel="1" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Order Reference">
                            <group>
                                <group>
                                    <field name="order_number"/>
                                    <field name="order_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_contract_amendment_search" model="ir.ui.view">
        <field name="name">hr.contract.amendment.search</field>
        <field name="model">hr.contract.amendment</field>
        <field name="arch" type="xml">
            <search string="Contract Amendments">
                <field name="employee_id"/>
                <field name="contract_id"/>
                <field name="amendment_type"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter string="Type" name="group_type" domain="[]" context="{'group_by': 'amendment_type'}"/>
                    <filter string="Employee" name="group_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'amendment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_contract_amendment" model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">hr.contract.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a contract amendment
            </p>
            <p>
                Track all changes made to employment contracts.
            </p>
        </field>
    </record>

</odoo>
