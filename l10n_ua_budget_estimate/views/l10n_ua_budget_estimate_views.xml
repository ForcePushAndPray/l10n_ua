<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Estimate header views                                        -->
    <!-- ============================================================ -->

    <record id="view_l10n_ua_budget_estimate_list" model="ir.ui.view">
        <field name="name">l10n_ua.budget.estimate.list</field>
        <field name="model">l10n_ua.budget.estimate</field>
        <field name="arch" type="xml">
            <list string="Кошториси"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="title" optional="show"/>
                <field name="year"/>
                <field name="fund_type"/>
                <field name="kpkvk_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="total_planned" widget="monetary"/>
                <field name="total_actual" widget="monetary" optional="show"/>
                <field name="execution_percent" widget="percentage" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_budget_estimate_form" model="ir.ui.view">
        <field name="name">l10n_ua.budget.estimate.form</field>
        <field name="model">l10n_ua.budget.estimate</field>
        <field name="arch" type="xml">
            <form string="Кошторис">
                <header>
                    <button name="action_submit" string="Подати" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Затвердити" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="l10n_ua_budget_base.group_ua_budget_manager"/>
                    <button name="action_execute" string="Запустити виконання" type="object"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_close" string="Закрити" type="object"
                            invisible="state not in ('approved', 'executed')"/>
                    <button name="action_recompute_actuals" string="Перерахувати касове виконання"
                            type="object" invisible="state not in ('approved', 'executed')"/>
                    <button name="action_reset_to_draft" string="У чернетку" type="object"
                            invisible="state not in ('submitted', 'cancelled')"/>
                    <button name="action_cancel" string="Скасувати" type="object"
                            invisible="state in ('draft', 'closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,executed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="fund_type" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="parent_estimate_id" invisible="not is_amendment"/>
                            <field name="is_amendment" invisible="1"/>
                        </group>
                        <group>
                            <field name="kpkvk_id" readonly="state not in ('draft', 'submitted')"/>
                            <field name="kfk_id" readonly="1"/>
                            <field name="kvkv_id" readonly="1"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="approval_date" readonly="1"
                                   invisible="state in ('draft', 'submitted')"/>
                            <field name="approved_by_id" readonly="1"
                                   invisible="state in ('draft', 'submitted')"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Рядки кошторису" name="lines">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'submitted')">
                                <list string="Рядки" editable="bottom">
                                    <field name="kekv_id"/>
                                    <field name="kekv_code" optional="hide"/>
                                    <field name="fund_type"/>
                                    <field name="name"/>
                                    <field name="kpkvk_id" optional="hide"/>
                                    <field name="m01" optional="show"/>
                                    <field name="m02" optional="hide"/>
                                    <field name="m03" optional="hide"/>
                                    <field name="q1" optional="show"/>
                                    <field name="m04" optional="hide"/>
                                    <field name="m05" optional="hide"/>
                                    <field name="m06" optional="hide"/>
                                    <field name="q2" optional="show"/>
                                    <field name="m07" optional="hide"/>
                                    <field name="m08" optional="hide"/>
                                    <field name="m09" optional="hide"/>
                                    <field name="q3" optional="show"/>
                                    <field name="m10" optional="hide"/>
                                    <field name="m11" optional="hide"/>
                                    <field name="m12" optional="show"/>
                                    <field name="q4" optional="show"/>
                                    <field name="amount_planned" sum="Усього план"/>
                                    <field name="amount_actual" sum="Усього факт"/>
                                    <field name="execution_percent" widget="percentage"
                                           optional="show"/>
                                    <field name="variance" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_general" widget="monetary"/>
                                <field name="total_special" widget="monetary"/>
                                <field name="total_planned" widget="monetary"
                                       class="oe_subtotal_footer_separator"/>
                                <field name="total_actual" widget="monetary"/>
                                <field name="execution_percent" widget="percentage"/>
                            </group>
                        </page>
                        <page string="Примітки" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_l10n_ua_budget_estimate_search" model="ir.ui.view">
        <field name="name">l10n_ua.budget.estimate.search</field>
        <field name="model">l10n_ua.budget.estimate</field>
        <field name="arch" type="xml">
            <search string="Пошук кошторисів">
                <field name="name"/>
                <field name="title"/>
                <field name="year"/>
                <field name="kpkvk_id"/>
                <field name="kvkv_id"/>
                <filter string="Чернетки" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Затверджені" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="У виконанні" name="filter_executed" domain="[('state', '=', 'executed')]"/>
                <separator/>
                <filter string="Загальний фонд" name="filter_general"
                        domain="[('fund_type', 'in', ('general', 'both'))]"/>
                <filter string="Спеціальний фонд" name="filter_special"
                        domain="[('fund_type', 'in', ('special', 'both'))]"/>
                <group>
                    <filter string="Рік" name="groupby_year" domain="[]" context="{'group_by': 'year'}"/>
                    <filter string="Стан" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="КПКВК" name="groupby_kpkvk" domain="[]" context="{'group_by': 'kpkvk_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_budget_estimate" model="ir.actions.act_window">
        <field name="name">Кошториси</field>
        <field name="res_model">l10n_ua.budget.estimate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================================================ -->
    <!-- Estimate line views (for cross-document analysis)            -->
    <!-- ============================================================ -->

    <record id="view_l10n_ua_budget_estimate_line_list" model="ir.ui.view">
        <field name="name">l10n_ua.budget.estimate.line.list</field>
        <field name="model">l10n_ua.budget.estimate.line</field>
        <field name="arch" type="xml">
            <list string="Рядки кошторисів"
                  decoration-warning="execution_percent &gt;= 90 and execution_percent &lt; 100"
                  decoration-danger="execution_percent &gt;= 100">
                <field name="estimate_id"/>
                <field name="year"/>
                <field name="kekv_code"/>
                <field name="kekv_id"/>
                <field name="fund_type"/>
                <field name="kpkvk_id" optional="hide"/>
                <field name="amount_planned" widget="monetary"/>
                <field name="amount_actual" widget="monetary"/>
                <field name="variance" widget="monetary"/>
                <field name="execution_percent" widget="percentage"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_budget_estimate_line_search" model="ir.ui.view">
        <field name="name">l10n_ua.budget.estimate.line.search</field>
        <field name="model">l10n_ua.budget.estimate.line</field>
        <field name="arch" type="xml">
            <search string="Пошук рядків">
                <field name="estimate_id"/>
                <field name="year"/>
                <field name="kekv_id"/>
                <field name="kpkvk_id"/>
                <filter string="Загальний фонд" name="filter_general"
                        domain="[('fund_type', '=', 'general')]"/>
                <filter string="Спеціальний фонд" name="filter_special"
                        domain="[('fund_type', '=', 'special')]"/>
                <separator/>
                <filter string="Перевиконання" name="filter_overrun"
                        domain="[('execution_percent', '&gt;=', 100)]"/>
                <filter string="Майже вичерпано (≥90%)" name="filter_near_limit"
                        domain="[('execution_percent', '&gt;=', 90), ('execution_percent', '&lt;', 100)]"/>
                <group>
                    <filter string="КЕКВ" name="groupby_kekv" domain="[]" context="{'group_by': 'kekv_id'}"/>
                    <filter string="Рік" name="groupby_year" domain="[]" context="{'group_by': 'year'}"/>
                    <filter string="Фонд" name="groupby_fund" domain="[]" context="{'group_by': 'fund_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_budget_estimate_line" model="ir.actions.act_window">
        <field name="name">Рядки кошторисів (зведено)</field>
        <field name="res_model">l10n_ua.budget.estimate.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_groupby_kekv': 1}</field>
    </record>

</odoo>
