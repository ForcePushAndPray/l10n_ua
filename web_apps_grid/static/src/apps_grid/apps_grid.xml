<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_apps_grid.Tile">
        <a class="o_apps_grid_item o_apps_grid_tile"
           t-att-class="{
               'o_apps_grid_current': currentApp and currentApp.id === app.id,
               'o_apps_grid_dragging': state.dragId === app.id,
           }"
           t-att-href="href(app)"
           t-att-data-menu-xmlid="app.xmlid"
           t-att-draggable="draggable ? 'true' : 'false'"
           t-on-click="(ev) => this.onTileClick(ev, app)"
           t-on-dragstart="(ev) => draggable and this.onDragStart(ev, app)"
           t-on-dragover="(ev) => draggable and this.onDragOver(ev)"
           t-on-drop="(ev) => draggable and this.onDrop(ev, app)"
           t-on-dragend="() => this.onDragEnd()">
            <span class="o_apps_grid_icon">
                <img t-if="app.webIconData" t-att-src="app.webIconData" alt="" draggable="false"/>
                <span t-else="" class="o_apps_grid_letter" t-out="iconLetter(app)"/>
            </span>
            <span class="o_apps_grid_name" t-out="app.name"/>
            <span class="o_apps_grid_pin" role="button"
                  t-att-class="{ 'o_apps_grid_pinned': isPinned(app) }"
                  t-att-title="pinTitle(app)"
                  t-on-click="(ev) => this.togglePin(ev, app)">
                <i class="fa" t-att-class="isPinned(app) ? 'fa-star' : 'fa-star-o'"/>
            </span>
        </a>
    </t>

    <t t-name="web_apps_grid.AppsGrid">
            <div class="o_apps_grid" t-ref="root" t-on-click="onBackdropClick"
                 role="dialog" aria-modal="true" aria-label="Apps">
                <div class="o_apps_grid_inner">
                    <div class="o_apps_grid_head">
                        <div class="o_apps_grid_search">
                            <i class="oi oi-search" aria-hidden="true"/>
                            <input type="search" t-ref="search" t-model="state.query"
                                   class="form-control" autocomplete="off" spellcheck="false"
                                   placeholder="Search apps and menus…"/>
                        </div>
                        <div class="o_apps_grid_toolbar">
                            <button class="btn btn-link" t-on-click="toggleGrouped"
                                    t-att-title="groupTitle">
                                <i class="fa" t-att-class="grouped ? 'fa-th' : 'fa-th-list'"/>
                            </button>
                            <button class="btn btn-link" title="Close (Esc)" t-on-click="() => props.close()">
                                <i class="oi oi-close"/>
                            </button>
                        </div>
                    </div>

                    <!-- Search results -->
                    <t t-if="state.query.trim()">
                        <t t-set="res" t-value="results"/>
                        <div t-if="res.apps.length" class="o_apps_grid_tiles o_apps_grid_hits">
                            <t t-foreach="res.apps" t-as="app" t-key="app.id">
                                <t t-call="web_apps_grid.Tile"/>
                            </t>
                        </div>
                        <ul t-if="res.items.length" class="o_apps_grid_results list-unstyled">
                            <li t-foreach="res.items" t-as="item" t-key="item.menu.id">
                                <a class="o_apps_grid_item o_apps_grid_result"
                                   t-att-href="href(item.menu)"
                                   t-att-data-menu-xmlid="item.menu.xmlid"
                                   t-on-click="(ev) => this.onTileClick(ev, item.menu, item.app)">
                                    <img t-if="item.app.webIconData" t-att-src="item.app.webIconData" alt=""/>
                                    <span class="o_apps_grid_result_app" t-out="item.app.name"/>
                                    <t t-foreach="item.path" t-as="part" t-key="part_index">
                                        <i class="oi oi-chevron-right" aria-hidden="true"/>
                                        <span t-att-class="{ 'fw-bold': part_last }" t-out="part"/>
                                    </t>
                                </a>
                            </li>
                        </ul>
                        <p t-if="!res.apps.length and !res.items.length" class="o_apps_grid_empty">
                            Nothing found
                        </p>
                    </t>

                    <t t-else="">
                        <div t-if="pinned.length or recent.length" class="o_apps_grid_dock">
                            <div t-if="pinned.length" class="o_apps_grid_dock_part o_apps_grid_pinned_section"
                                 t-on-dragover="onDragOver" t-on-drop="(ev) => this.onDrop(ev, null)">
                                <h6>Pinned apps</h6>
                                <div class="o_apps_grid_tiles">
                                    <t t-foreach="pinned" t-as="app" t-key="app.id">
                                        <t t-call="web_apps_grid.Tile"><t t-set="draggable" t-value="true"/></t>
                                    </t>
                                </div>
                            </div>
                            <div t-if="recent.length" class="o_apps_grid_dock_part o_apps_grid_recent_section">
                                <h6>Recently opened</h6>
                                <div class="o_apps_grid_tiles">
                                    <t t-foreach="recent" t-as="app" t-key="app.id">
                                        <t t-call="web_apps_grid.Tile"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="o_apps_grid_groups" t-att-class="{ 'o_apps_grid_flat': !grouped }">
                            <section t-foreach="groups" t-as="group" t-key="group.key"
                                     class="o_apps_grid_section" t-att-data-group="group.key">
                                <h6 t-if="group.label" t-out="group.label"/>
                                <h6 t-elif="pinned.length or recent.length">All apps</h6>
                                <div class="o_apps_grid_tiles">
                                    <t t-foreach="group.apps" t-as="app" t-key="app.id">
                                        <t t-call="web_apps_grid.Tile"/>
                                    </t>
                                </div>
                            </section>
                        </div>
                    </t>
                </div>
            </div>
    </t>

</templates>
