<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]" position="replace">
            <div t-if="!isScopedApp" class="o_navbar_apps_menu o_apps_grid_toggle">
                <button class="dropdown-toggle" data-hotkey="h" title="Home Menu"
                        t-att-class="{ 'active': appsGrid.open }"
                        t-on-click="toggleAppsGrid">
                    <i class="oi oi-apps"/>
                </button>
            </div>
        </xpath>
    </t>

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav" position="after">
            <AppsGrid t-if="appsGrid.open" prefs="appsGridPrefs" close.bind="closeAppsGrid"/>
        </xpath>
    </t>

</templates>
