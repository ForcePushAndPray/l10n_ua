<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_kvkv_list" model="ir.ui.view">
        <field name="name">l10n_ua.kvkv.list</field>
        <field name="model">l10n_ua.kvkv</field>
        <field name="arch" type="xml">
            <list string="ГРБК (КВКВ)">
                <field name="code"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_kvkv_form" model="ir.ui.view">
        <field name="name">l10n_ua.kvkv.form</field>
        <field name="model">l10n_ua.kvkv</field>
        <field name="arch" type="xml">
            <form string="ГРБК">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ua_kvkv_search" model="ir.ui.view">
        <field name="name">l10n_ua.kvkv.search</field>
        <field name="model">l10n_ua.kvkv</field>
        <field name="arch" type="xml">
            <search string="Пошук ГРБК">
                <field name="code"/>
                <field name="name"/>
                <filter string="Активні" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Архівні" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_kvkv" model="ir.actions.act_window">
        <field name="name">ГРБК (КВКВ)</field>
        <field name="res_model">l10n_ua.kvkv</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
