<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_budget" model="ir.ui.view">
        <field name="name">account.move.form.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Document-level: КПКВК + Фонд on the journal entry — add a new notebook page -->
            <xpath expr="//field[@name='line_ids']/../.." position="inside">
                <page string="Бюджетний облік (UA)" name="ua_budget">
                    <group>
                        <field name="ua_kpkvk_id"/>
                        <field name="ua_fund_type"/>
                    </group>
                </page>
            </xpath>

            <!-- Line-level fields inside the JE lines list -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="after">
                <field name="ua_kekv_id" optional="show"/>
                <field name="ua_kfk_id" optional="hide"/>
                <field name="ua_kpkvk_id" optional="hide"/>
                <field name="ua_fund_type" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
