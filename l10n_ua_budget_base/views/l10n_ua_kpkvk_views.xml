<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_kpkvk_list" model="ir.ui.view">
        <field name="name">l10n_ua.kpkvk.list</field>
        <field name="model">l10n_ua.kpkvk</field>
        <field name="arch" type="xml">
            <list string="КПКВК">
                <field name="code"/>
                <field name="name"/>
                <field name="kvkv_id"/>
                <field name="kfk_id" optional="show"/>
                <field name="year" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_kpkvk_form" model="ir.ui.view">
        <field name="name">l10n_ua.kpkvk.form</field>
        <field name="model">l10n_ua.kpkvk</field>
        <field name="arch" type="xml">
            <form string="КПКВК">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="kvkv_code" readonly="1"/>
                            <field name="kvkv_id" readonly="1"/>
                            <field name="kfk_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Опис">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ua_kpkvk_search" model="ir.ui.view">
        <field name="name">l10n_ua.kpkvk.search</field>
        <field name="model">l10n_ua.kpkvk</field>
        <field name="arch" type="xml">
            <search string="Пошук КПКВК">
                <field name="code"/>
                <field name="name"/>
                <field name="kvkv_id"/>
                <field name="kfk_id"/>
                <field name="year"/>
                <group>
                    <filter string="ГРБК" name="groupby_kvkv" domain="[]" context="{'group_by': 'kvkv_id'}"/>
                    <filter string="Рік" name="groupby_year" domain="[]" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_kpkvk" model="ir.actions.act_window">
        <field name="name">КПКВК</field>
        <field name="res_model">l10n_ua.kpkvk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
