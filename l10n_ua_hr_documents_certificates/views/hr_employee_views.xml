<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_employee_view_form_certificates" model="ir.ui.view">
        <field name="name">hr.employee.form.certificates</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_certificates" type="object"
                        class="oe_stat_button" icon="fa-certificate">
                    <field name="certificates_count" widget="statinfo" string="Certificates"/>
                </button>
            </xpath>
        </field>
    </record>

    </data>
</odoo>
