<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_certificate_type_view_form" model="ir.ui.view">
        <field name="name">hr.certificate.type.form</field>
        <field name="model">hr.certificate.type</field>
        <field name="arch" type="xml">
            <form string="Certificate Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_certificates" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="certificates_count" widget="statinfo" string="Certificates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Certificate Type Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="sequence_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="validity_days"/>
                            <field name="requires_destination"/>
                            <field name="requires_salary_info"/>
                            <field name="requires_period"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Template" name="template">
                            <field name="template_body"/>
                        </page>
                        <page string="Source" name="source">
                            <field name="template_body" widget="ace"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_certificate_type_view_tree" model="ir.ui.view">
        <field name="name">hr.certificate.type.tree</field>
        <field name="model">hr.certificate.type</field>
        <field name="arch" type="xml">
            <list string="Certificate Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="requires_salary_info"/>
                <field name="requires_period"/>
                <field name="validity_days"/>
                <field name="certificates_count"/>
            </list>
        </field>
    </record>

    <record id="action_hr_certificate_type" model="ir.actions.act_window">
        <field name="name">Certificate Types</field>
        <field name="res_model">hr.certificate.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first certificate type
            </p>
            <p>
                Certificate types define templates for standard HR documents like
                employment certificates, salary certificates, etc.
            </p>
        </field>
    </record>

    </data>
</odoo>
