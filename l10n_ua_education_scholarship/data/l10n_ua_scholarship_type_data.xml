<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="scholarship_type_academic_basic" model="l10n_ua.scholarship.type">
            <field name="name">Академічна (звичайна)</field>
            <field name="code">ACAD</field>
            <field name="kind">academic</field>
            <field name="sequence">10</field>
            <field name="is_taxable_pdfo" eval="False"/>
            <field name="description">&lt;p&gt;Звичайна академічна стипендія за результатами навчання. Постанова КМУ № 1146.&lt;/p&gt;</field>
        </record>

        <record id="scholarship_type_academic_advanced" model="l10n_ua.scholarship.type">
            <field name="name">Академічна (підвищена)</field>
            <field name="code">ACAD_ADV</field>
            <field name="kind">academic</field>
            <field name="sequence">20</field>
            <field name="description">&lt;p&gt;Підвищена академічна стипендія за відмінну успішність.&lt;/p&gt;</field>
        </record>

        <record id="scholarship_type_social" model="l10n_ua.scholarship.type">
            <field name="name">Соціальна</field>
            <field name="code">SOC</field>
            <field name="kind">social</field>
            <field name="sequence">30</field>
            <field name="description">&lt;p&gt;Соціальна стипендія малозабезпеченим студентам.&lt;/p&gt;</field>
        </record>

        <record id="scholarship_type_presidential" model="l10n_ua.scholarship.type">
            <field name="name">Президентська</field>
            <field name="code">PRES</field>
            <field name="kind">presidential</field>
            <field name="sequence">40</field>
        </record>

        <record id="scholarship_type_rada" model="l10n_ua.scholarship.type">
            <field name="name">Верховної Ради</field>
            <field name="code">RADA</field>
            <field name="kind">rada</field>
            <field name="sequence">50</field>
        </record>

        <record id="scholarship_type_regional" model="l10n_ua.scholarship.type">
            <field name="name">Обласна / місцева</field>
            <field name="code">REG</field>
            <field name="kind">regional</field>
            <field name="sequence">60</field>
        </record>
    </data>
</odoo>
