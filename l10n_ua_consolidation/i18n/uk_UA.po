#. module: l10n_ua_consolidation
#. odoo-python
#: code:addons/l10n_ua_consolidation/models/consolidation_report.py:0
msgid ""
"%(company)s, %(date)s: accounts not mapped to form 1-к rows: %(accounts)s."
msgstr ""
"%(company)s, %(date)s: рахунки, не віднесені до рядків форми 1-к: "
"%(accounts)s."

#. module: l10n_ua_consolidation
#. odoo-python
#: code:addons/l10n_ua_consolidation/models/consolidation_report.py:0
msgid ""
"%(company)s: no investment of the parent company found on accounts "
"%(accounts)s with this partner — set the investment amount manually on the "
"group."
msgstr ""
"%(company)s: не знайдено інвестиції материнської компанії на рахунках "
"%(accounts)s з цим контрагентом — вкажіть суму інвестиції вручну в "
"налаштуваннях групи."

#. module: l10n_ua_consolidation
#. odoo-python
#: code:addons/l10n_ua_consolidation/models/consolidation_report.py:0
msgid ""
"%(date)s: intra-group receivables (%(assets).2f) and payables "
"(%(liabilities).2f) do not match (difference %(diff).2f). Reconcile them or "
"add a manual adjustment (goods/cash in transit)."
msgstr ""
"%(date)s: внутрішньогрупова дебіторська (%(assets).2f) і кредиторська "
"(%(liabilities).2f) заборгованість не збігаються (різниця %(diff).2f). "
"Звірте їх або додайте ручне коригування (товари/кошти в дорозі)."

#. module: l10n_ua_consolidation
#. odoo-python
#: code:addons/l10n_ua_consolidation/models/consolidation_report.py:0
msgid ""
"%(start)s – %(end)s: intra-group expenses exceed intra-group income by "
"%(amount).2f (the seller did not book the income against a group partner?). "
"Check and add a manual adjustment."
msgstr ""
"%(start)s – %(end)s: внутрішньогрупові витрати перевищують "
"внутрішньогрупові доходи на %(amount).2f (продавець не відобразив дохід з "
"контрагентом групи?). Перевірте та додайте ручне коригування."

#. module: l10n_ua_consolidation
#. odoo-python
#: code:addons/l10n_ua_consolidation/models/consolidation_report.py:0
msgid ""
"%(start)s – %(end)s: intra-group income %(amount).2f has no intra-group "
"expense counterpart (e.g. dividends from subsidiaries). It is eliminated and"
" reduces the consolidated result — check it and add a manual adjustment if "
"needed."
msgstr ""
"%(start)s – %(end)s: внутрішньогруповий дохід %(amount).2f не має "
"відповідних внутрішньогрупових витрат (напр., дивіденди від дочірніх). Його"
" виключено, і він зменшує консолідований результат — перевірте та за "
"потреби додайте ручне коригування."

