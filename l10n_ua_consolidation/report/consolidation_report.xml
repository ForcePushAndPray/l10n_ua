<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_consolidated_balance" model="ir.actions.report">
        <field name="name">Consolidated Balance (Form No.1-k)</field>
        <field name="model">l10n_ua.consolidation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_consolidation.report_consolidated_balance</field>
        <field name="report_file">l10n_ua_consolidation.report_consolidated_balance</field>
        <field name="print_report_name">'Баланс_1-к_%s' % object.date_to</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
        <field name="binding_model_id" ref="model_l10n_ua_consolidation_report"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_consolidated_pnl" model="ir.actions.report">
        <field name="name">Consolidated Financial Results (Form No.2-k)</field>
        <field name="model">l10n_ua.consolidation.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_consolidation.report_consolidated_pnl</field>
        <field name="report_file">l10n_ua_consolidation.report_consolidated_pnl</field>
        <field name="print_report_name">'Фін_результати_2-к_%s' % object.date_to</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
        <field name="binding_model_id" ref="model_l10n_ua_consolidation_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Шапка форм 1-к/2-к: материнське підприємство складає звітність групи -->
    <template id="report_consolidated_header">
        <div class="text-center mb-2">
            <div class="small">Додаток 1 до Національного положення (стандарту)</div>
            <div class="small">бухгалтерського обліку 1 «Загальні вимоги до фінансової звітності»</div>
        </div>
        <div class="row mb-3">
            <div class="col-8">
                <table class="table-borderless" style="width: 100%;">
                    <tr>
                        <td style="width: 160px;">Підприємство (материнське)</td>
                        <td class="border-bottom"><span t-field="report.parent_company_id.name"/></td>
                    </tr>
                    <tr t-if="report.parent_company_id.company_registry">
                        <td>за ЄДРПОУ</td>
                        <td class="border-bottom"><span t-field="report.parent_company_id.company_registry"/></td>
                    </tr>
                    <tr>
                        <td>Група</td>
                        <td class="border-bottom"><span t-field="report.group_id.name"/></td>
                    </tr>
                </table>
            </div>
            <div class="col-4 text-right">
                <div class="small">КОДИ</div>
                <table class="small" style="float: right;">
                    <tr>
                        <td class="border">Дата (рік, місяць, число)</td>
                        <td class="border text-center" t-esc="report.date_to.strftime('%Y.%m.%d')"/>
                    </tr>
                    <tr>
                        <td class="border">за ДКУД</td>
                        <td class="border text-center" t-esc="dkud"/>
                    </tr>
                </table>
            </div>
        </div>
        <div class="small mb-2">Одиниця виміру: грн без десяткового знака.
            Складено за національними положеннями (стандартами) бухгалтерського обліку.</div>
    </template>

    <template id="report_consolidated_signatures">
        <div class="row mt-5">
            <div class="col-6">
                <div class="signature-row">
                    <span>Керівник</span>
                    <span class="signature-line"></span>
                </div>
            </div>
            <div class="col-6">
                <div class="signature-row">
                    <span>Головний бухгалтер</span>
                    <span class="signature-line"></span>
                </div>
            </div>
        </div>
    </template>

    <template id="report_consolidated_balance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="dkud" t-value="'1801007'"/>
                        <t t-call="l10n_ua_consolidation.report_consolidated_header"/>
                        <div class="ua-report-title">
                            КОНСОЛІДОВАНИЙ БАЛАНС<br/>
                            (Звіт про фінансовий стан)
                        </div>
                        <div class="ua-report-subtitle mb-3">
                            на <span t-field="report.date_to" t-options='{"widget": "date"}'/> р.
                        </div>
                        <div class="small text-center mb-2">Форма № 1-к</div>
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Стаття</th>
                                    <th style="width: 10%;">Код рядка</th>
                                    <th style="width: 20%;">На початок звітного періоду</th>
                                    <th style="width: 20%;">На кінець звітного періоду</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report._get_form_lines('balance')" t-as="line">
                                    <tr t-if="line.line_type == 'section'">
                                        <td class="bold" t-esc="line.name"/>
                                        <td/><td/><td/>
                                    </tr>
                                    <tr t-elif="line.line_type == 'detail'">
                                        <td t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.previous_amount)"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.current_amount)"/>
                                    </tr>
                                    <tr t-else="" t-att-style="'border-top: 2px solid black;' if line.line_type == 'total' else None">
                                        <td class="bold" t-esc="line.name"/>
                                        <td class="text-center bold" t-esc="line.code"/>
                                        <td class="text-right bold" t-esc="report._fmt_amount(line.previous_amount)"/>
                                        <td class="text-right bold" t-esc="report._fmt_amount(line.current_amount)"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-call="l10n_ua_consolidation.report_consolidated_signatures"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_consolidated_pnl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <t t-set="dkud" t-value="'1801008'"/>
                        <t t-call="l10n_ua_consolidation.report_consolidated_header"/>
                        <div class="ua-report-title">
                            КОНСОЛІДОВАНИЙ ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ<br/>
                            (Звіт про сукупний дохід)
                        </div>
                        <div class="ua-report-subtitle mb-3">
                            за <span t-field="report.date_from" t-options='{"widget": "date"}'/> -
                            <span t-field="report.date_to" t-options='{"widget": "date"}'/> р.
                        </div>
                        <div class="small text-center mb-2">Форма № 2-к</div>
                        <div class="bold mb-1">I. ФІНАНСОВІ РЕЗУЛЬТАТИ</div>
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Стаття</th>
                                    <th style="width: 10%;">Код рядка</th>
                                    <th style="width: 20%;">За звітний період</th>
                                    <th style="width: 20%;">За аналогічний період попереднього року</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report._get_form_lines('pnl')" t-as="line">
                                    <tr t-if="line.line_type == 'detail'">
                                        <td t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.current_amount, line.expense)"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.previous_amount, line.expense)"/>
                                    </tr>
                                    <tr t-else="" t-att-class="'bold' if line.line_type != 'attribution' else None"
                                        t-att-style="'border-top: 2px solid black;' if line.line_type == 'total' else None">
                                        <td t-esc="line.name"/>
                                        <td class="text-center" t-esc="line.code"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.current_amount)"/>
                                        <td class="text-right" t-esc="report._fmt_amount(line.previous_amount)"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-call="l10n_ua_consolidation.report_consolidated_signatures"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
