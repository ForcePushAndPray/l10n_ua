<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Догнати пропущене: надходження зазвичай пишуться в книгу одразу з виписки,
         крон раз на добу добирає поточний і попередній квартал. -->
    <record id="ir_cron_fop_income_book_fill" model="ir.cron">
        <field name="name">ФОП: книги обліку доходів з банківських виписок</field>
        <field name="model_id" ref="model_l10n_ua_fop_income_book"/>
        <field name="state">code</field>
        <field name="code">model._cron_fill_from_bank()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
