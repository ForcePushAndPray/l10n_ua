<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="fop_group_1" model="l10n_ua.fop.group">
        <field name="code">1</field>
        <field name="name">Group 1 - Retail trade, services to population</field>
        <field name="tax_rate">0</field>
        <field name="income_limit">1336000</field>
        <field name="can_hire_employees">False</field>
        <field name="max_employees">0</field>
        <field name="description">Fixed rate based on minimum wage. Retail trade at markets, household services to population.</field>
    </record>

    <record id="fop_group_2" model="l10n_ua.fop.group">
        <field name="code">2</field>
        <field name="name">Group 2 - Services to FOP and legal entities</field>
        <field name="tax_rate">0</field>
        <field name="income_limit">5588000</field>
        <field name="can_hire_employees">True</field>
        <field name="max_employees">10</field>
        <field name="description">Fixed rate based on minimum wage. Services to other FOP and legal entities, production.</field>
    </record>

    <record id="fop_group_3" model="l10n_ua.fop.group">
        <field name="code">3</field>
        <field name="name">Group 3 - Without VAT</field>
        <field name="tax_rate">5</field>
        <field name="income_limit">8379000</field>
        <field name="can_hire_employees">True</field>
        <field name="max_employees">0</field>
        <field name="description">5% of income. Any activity except prohibited. No employee limit.</field>
    </record>

    <record id="fop_group_3_vat" model="l10n_ua.fop.group">
        <field name="code">3_vat</field>
        <field name="name">Group 3 - With VAT</field>
        <field name="tax_rate">3</field>
        <field name="income_limit">8379000</field>
        <field name="can_hire_employees">True</field>
        <field name="max_employees">0</field>
        <field name="description">3% of income + VAT. Any activity except prohibited. No employee limit.</field>
    </record>

</odoo>
