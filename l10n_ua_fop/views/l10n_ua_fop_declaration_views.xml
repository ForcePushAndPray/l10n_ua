<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_fop_declaration_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.fop.declaration.form</field>
        <field name="model">l10n_ua.fop.declaration</field>
        <field name="arch" type="xml">
            <form string="FOP Declaration">
                <header>
                    <button name="action_calculate" string="Calculate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_xml" string="Generate XML" type="object" invisible="state not in ('calculated', 'submitted')"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'calculated'"/>
                    <button name="action_accept" string="Mark Accepted" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,submitted,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="period"/>
                            <field name="fop_group_id"/>
                        </group>
                        <group>
                            <field name="submission_date"/>
                            <field name="xml_file" filename="xml_filename"/>
                            <field name="xml_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Income" name="income">
                            <group>
                                <field name="total_income"/>
                            </group>
                        </page>
                        <page string="Taxes" name="taxes">
                            <group>
                                <group string="Single Tax">
                                    <field name="tax_rate"/>
                                    <field name="single_tax"/>
                                </group>
                                <group string="ESV">
                                    <field name="esv_base"/>
                                    <field name="esv_rate"/>
                                    <field name="esv_amount"/>
                                </group>
                            </group>
                            <group>
                                <field name="total_payable"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_fop_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.fop.declaration.list</field>
        <field name="model">l10n_ua.fop.declaration</field>
        <field name="arch" type="xml">
            <list string="FOP Declarations">
                <field name="name"/>
                <field name="year"/>
                <field name="period"/>
                <field name="fop_group_id"/>
                <field name="total_income"/>
                <field name="total_payable"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_fop_declaration_action" model="ir.actions.act_window">
        <field name="name">FOP Declarations</field>
        <field name="res_model">l10n_ua.fop.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
