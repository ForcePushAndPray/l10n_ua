<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_fop_declaration_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.fop.declaration.form</field>
        <field name="model">l10n_ua.fop.declaration</field>
        <field name="arch" type="xml">
            <form string="Декларація ЄП">
                <header>
                    <button name="action_calculate" string="Розрахувати" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_xml" string="Сформувати XML" type="object"
                            invisible="state not in ('calculated', 'submitted')"/>
                    <button name="action_submit" string="Подано" type="object"
                            class="btn-primary" invisible="state != 'calculated'"/>
                    <button name="action_accept" string="Прийнято" type="object"
                            class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_draft" string="В чернетку" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-book"
                                name="action_view_income_books" type="object">
                            <field name="income_book_ids" invisible="1"/>
                            <span>Книги доходів</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not income_limit_exceeded">
                        <strong>Увага!</strong> Дохід перевищує ліміт для обраної групи ЄП.
                    </div>
                    <group>
                        <group string="Основне">
                            <field name="year"/>
                            <field name="period"/>
                            <field name="fop_group_id"/>
                            <field name="income_limit" invisible="not fop_group_id"/>
                        </group>
                        <group string="Подання">
                            <field name="submission_date"/>
                            <field name="xml_file" filename="xml_filename"/>
                            <field name="xml_filename" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Дохід" name="income">
                            <group>
                                <group>
                                    <field name="total_income" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Податки та ЄСВ" name="taxes">
                            <group>
                                <group string="Єдиний податок">
                                    <field name="tax_rate"/>
                                    <field name="monthly_tax_amount"
                                           invisible="fop_group_id and fop_group_id.code not in ('1', '2')"/>
                                    <field name="single_tax" widget="monetary"/>
                                </group>
                                <group string="ЄСВ">
                                    <field name="min_wage"/>
                                    <field name="esv_rate"/>
                                    <field name="esv_months"/>
                                    <field name="esv_base" widget="monetary"/>
                                    <field name="esv_amount" widget="monetary"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="total_payable" widget="monetary"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Примітки" name="notes">
                            <field name="notes" placeholder="Додаткові примітки..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_fop_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.fop.declaration.list</field>
        <field name="model">l10n_ua.fop.declaration</field>
        <field name="arch" type="xml">
            <list string="Декларації ЄП"
                  decoration-danger="income_limit_exceeded"
                  decoration-muted="state == 'accepted'">
                <field name="name"/>
                <field name="year"/>
                <field name="period"/>
                <field name="fop_group_id"/>
                <field name="total_income" sum="Разом дохід"/>
                <field name="single_tax" sum="Разом ЄП"/>
                <field name="esv_amount" sum="Разом ЄСВ"/>
                <field name="total_payable" sum="Разом до сплати"/>
                <field name="income_limit_exceeded" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-info="state == 'calculated'"
                       decoration-warning="state == 'submitted'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_fop_declaration_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.fop.declaration.search</field>
        <field name="model">l10n_ua.fop.declaration</field>
        <field name="arch" type="xml">
            <search string="Декларації ЄП">
                <field name="name"/>
                <field name="fop_group_id"/>
                <filter string="Чернетки" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Розраховані" name="filter_calculated"
                        domain="[('state', '=', 'calculated')]"/>
                <filter string="Подані" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Прийняті" name="filter_accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <separator/>
                <filter string="Поточний рік" name="filter_current_year"
                        domain="[('year', '=', context_today().year)]"/>
                <filter string="Ліміт перевищено" name="filter_exceeded"
                        domain="[('income_limit_exceeded', '=', True)]"/>
                <group>
                    <filter string="Рік" name="groupby_year" domain="[]"
                            context="{'group_by': 'year'}"/>
                    <filter string="Період" name="groupby_period" domain="[]"
                            context="{'group_by': 'period'}"/>
                    <filter string="Група ЄП" name="groupby_group" domain="[]"
                            context="{'group_by': 'fop_group_id'}"/>
                    <filter string="Статус" name="groupby_state" domain="[]"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_fop_declaration_action" model="ir.actions.act_window">
        <field name="name">Декларації ЄП</field>
        <field name="res_model">l10n_ua.fop.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ua_fop_declaration_view_search"/>
        <field name="context">{'search_default_filter_current_year': 1}</field>
    </record>

</odoo>
