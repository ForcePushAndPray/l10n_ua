<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_fop_income_book_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.fop.income.book.form</field>
        <field name="model">l10n_ua.fop.income.book</field>
        <field name="arch" type="xml">
            <form string="Income Book">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="quarter"/>
                            <field name="fop_group_id"/>
                        </group>
                        <group>
                            <field name="total_income"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Income Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="document_number"/>
                                    <field name="description"/>
                                    <field name="partner_id"/>
                                    <field name="income_type"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_fop_income_book_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.fop.income.book.list</field>
        <field name="model">l10n_ua.fop.income.book</field>
        <field name="arch" type="xml">
            <list string="Income Books">
                <field name="name"/>
                <field name="year"/>
                <field name="quarter"/>
                <field name="fop_group_id"/>
                <field name="total_income" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_fop_income_book_action" model="ir.actions.act_window">
        <field name="name">Income Books</field>
        <field name="res_model">l10n_ua.fop.income.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
