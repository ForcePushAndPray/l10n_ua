<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- Bank UA - Main menu                            -->
    <!-- ============================================== -->

    <menuitem id="menu_ua_bank_root"
              name="Bank UA"
              sequence="53"
              web_icon="l10n_ua_bank_sync,static/description/icon.png"/>

    <!-- Dashboard -->
    <menuitem id="menu_ua_bank_dashboard"
              name="Dashboard"
              parent="menu_ua_bank_root"
              action="l10n_ua_bank_dashboard_action"
              sequence="1"/>

    <!-- Statements submenu -->
    <menuitem id="menu_ua_bank_statements_root"
              name="Statements"
              parent="menu_ua_bank_root"
