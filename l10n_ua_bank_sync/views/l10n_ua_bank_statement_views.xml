<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Statement Form View -->
    <record id="l10n_ua_bank_statement_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.bank.statement.form</field>
        <field name="model">l10n_ua.bank.statement</field>
        <field name="arch" type="xml">
            <form string="Bank Statement">
                <header>
                    <button name="action_link_transactions" string="Link Transactions" type="object"
                            class="btn-secondary"/>
                    <button name="action_compute_opening_balance" string="Compute Opening Balance" type="object"
                            class="btn-secondary"/>
                    <button name="action_export_xlsx" string="Export XLSX" type="object"
                            class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_print_pdf" string="Print PDF" type="object"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_view_sync_job" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="not sync_job_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sync Job</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Period">
                            <field name="journal_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="sync_provider"/>
                        </group>
                        <group string="Balances">
                            <field name="opening_balance"/>
                            <field name="closing_balance"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Totals">
                            <field name="total_incoming"/>
                            <field name="total_outgoing"/>
                            <field name="turnover"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" name="transactions">
                            <field name="transaction_ids">
                                <list decoration-success="amount &gt; 0" decoration-danger="amount &lt; 0">
                                    <field name="date"/>
                                    <field name="payment_ref"/>
                                    <field name="description"/>
                                    <field name="partner_name"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="partner_iban" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'new'"
                                           decoration-warning="state == 'draft'"
                                           decoration-success="state == 'posted'"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Statement List View -->
    <record id="l10n_ua_bank_statement_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.bank.statement.list</field>
        <field name="model">l10n_ua.bank.statement</field>
        <field name="arch" type="xml">
            <list string="Bank Statements">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="transaction_count" string="Trans"/>
                <field name="opening_balance" sum="Total"/>
                <field name="total_incoming" sum="Total"/>
                <field name="total_outgoing" sum="Total"/>
                <field name="closing_balance" sum="Total"/>
                <field name="sync_provider" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Statement Search View -->
    <record id="l10n_ua_bank_statement_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.bank.statement.search</field>
        <field name="model">l10n_ua.bank.statement</field>
        <field name="arch" type="xml">
            <search string="Bank Statements">
                <field name="name"/>
                <field name="journal_id"/>
                <group>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Statement Action -->
    <record id="l10n_ua_bank_statement_action" model="ir.actions.act_window">
        <field name="name">Bank Statements</field>
        <field name="res_model">l10n_ua.bank.statement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
