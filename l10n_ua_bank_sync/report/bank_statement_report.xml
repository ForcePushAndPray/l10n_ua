<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_bank_statement" model="ir.actions.report">
        <field name="name">Bank Statement</field>
        <field name="model">l10n_ua.bank.statement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_bank_sync.report_bank_statement</field>
        <field name="report_file">l10n_ua_bank_sync.report_bank_statement</field>
        <field name="print_report_name">'Bank_Statement_%s_%s' % (object.date_from, object.date_to)</field>
        <field name="binding_model_id" ref="model_l10n_ua_bank_statement"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_bank_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .statement-header { margin-bottom: 20px; }
                            .statement-title { font-size: 18px; font-weight: bold; margin-bottom: 10px; }
                            .statement-info { margin-bottom: 5px; }
                            .statement-summary { margin: 20px 0; }
                            .statement-summary table { width: 50%; }
                            .statement-summary td { padding: 5px 10px; }
                            .statement-summary .label { font-weight: bold; }
                            .statement-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                            .statement-table th { background-color: #4472C4; color: white; padding: 8px; text-align: left; border: 1px solid #ddd; }
                            .statement-table td { padding: 6px 8px; border: 1px solid #ddd; vertical-align: top; }
                            .statement-table tr:nth-child(even) { background-color: #f9f9f9; }
                            .text-right { text-align: right; }
                            .text-center { text-align: center; }
                            .amount-positive { color: green; }
                            .amount-negative { color: red; }
                            .total-row { font-weight: bold; background-color: #e0e0e0 !important; }
                            .description { max-width: 250px; word-wrap: break-word; font-size: 11px; }
                        </style>

                        <div class="statement-header">
                            <div class="statement-title">
                                Bank Statement
                            </div>
                            <div class="statement-info">
                                <strong>Journal:</strong> <span t-field="doc.journal_id.name"/>
                            </div>
                            <div class="statement-info" t-if="doc.bank_account_id">
                                <strong>Account:</strong> <span t-field="doc.bank_account_id.acc_number"/>
                            </div>
                            <div class="statement-info">
                                <strong>Period:</strong>
                                <span t-field="doc.date_from" t-options="{'format': 'dd.MM.yyyy'}"/>
                                -
                                <span t-field="doc.date_to" t-options="{'format': 'dd.MM.yyyy'}"/>
                            </div>
                            <div class="statement-info">
                                <strong>Company:</strong> <span t-field="doc.company_id.name"/>
                            </div>
                        </div>

                        <div class="statement-summary">
                            <table>
                                <tr>
                                    <td class="label">Opening Balance:</td>
                                    <td class="text-right">
                                        <span t-field="doc.opening_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label">Total Incoming:</td>
                                    <td class="text-right amount-positive">
                                        +<span t-field="doc.total_incoming" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label">Total Outgoing:</td>
                                    <td class="text-right amount-negative">
                                        -<span t-field="doc.total_outgoing" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr style="border-top: 2px solid #000;">
                                    <td class="label">Closing Balance:</td>
                                    <td class="text-right">
                                        <strong><span t-field="doc.closing_balance" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <table class="statement-table">
                            <thead>
                                <tr>
                                    <th style="width: 70px;">Date</th>
                                    <th style="width: 80px;">Reference</th>
                                    <th>Description</th>
                                    <th style="width: 120px;">Partner</th>
                                    <th style="width: 90px;" class="text-right">Incoming</th>
                                    <th style="width: 90px;" class="text-right">Outgoing</th>
                                    <th style="width: 90px;" class="text-right">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="running_balance" t-value="doc.opening_balance"/>
                                <t t-foreach="doc.transaction_ids.sorted(key=lambda t: (t.date, t.id))" t-as="trans">
                                    <t t-set="running_balance" t-value="running_balance + trans.amount"/>
                                    <tr>
                                        <td><span t-field="trans.date" t-options="{'format': 'dd.MM.yy'}"/></td>
                                        <td><span t-field="trans.payment_ref"/></td>
                                        <td class="description"><span t-field="trans.description"/></td>
                                        <td>
                                            <t t-if="trans.partner_name">
                                                <span t-field="trans.partner_name"/>
                                            </t>
                                            <t t-elif="trans.partner_id">
                                                <span t-field="trans.partner_id.name"/>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="trans.amount > 0">
                                                <span class="amount-positive" t-esc="'%.2f' % trans.amount"/>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <t t-if="trans.amount &lt; 0">
                                                <span class="amount-negative" t-esc="'%.2f' % abs(trans.amount)"/>
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'%.2f' % running_balance"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="total-row">
                                    <td colspan="4" class="text-right">TOTAL:</td>
                                    <td class="text-right amount-positive">
                                        <span t-esc="'%.2f' % doc.total_incoming"/>
                                    </td>
                                    <td class="text-right amount-negative">
                                        <span t-esc="'%.2f' % doc.total_outgoing"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % doc.closing_balance"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top: 30px; font-size: 10px; color: #666;">
                            <p>Generated: <span t-esc="datetime.datetime.now().strftime('%d.%m.%Y %H:%M')"/></p>
                            <p>Transactions: <span t-esc="doc.transaction_count"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
