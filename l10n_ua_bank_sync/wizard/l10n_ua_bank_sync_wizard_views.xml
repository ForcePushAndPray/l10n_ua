<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_bank_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.bank.sync.wizard.form</field>
        <field name="model">l10n_ua.bank.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Bank Statements">
                <group>
                    <field name="config_id" readonly="1" force_save="1"/>
                    <field name="last_job_id" readonly="1" invisible="not last_job_id"/>
                    <field name="period" widget="radio"/>
                </group>
                <group string="Date Range">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_sync" string="Start Sync" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
