<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rules (issue #178).
             UA bank-sync records carry company_id but had no multi-company
             ir.rule, so they leaked across ALL companies (incl. non-UA ones).
             These global rules scope each record to the user's allowed
             companies. company_id is directly stored on config/statement/
             match.rule and stored-related on job (config_id.company_id) and
             transaction (journal_id.company_id), so the standard domain
             applies to every model. Standard Odoo pattern (see VAT rule). -->

        <record id="l10n_ua_bank_sync_config_company_rule" model="ir.rule">
            <field name="name">Конфігурація банк-синку: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_bank_sync_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_bank_statement_company_rule" model="ir.rule">
            <field name="name">Банківська виписка: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_bank_statement"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_bank_match_rule_company_rule" model="ir.rule">
            <field name="name">Правило зіставлення: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_bank_match_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_bank_sync_job_company_rule" model="ir.rule">
            <field name="name">Завдання синхронізації: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_bank_sync_job"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="l10n_ua_bank_transaction_company_rule" model="ir.rule">
            <field name="name">Банківська транзакція: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_bank_transaction"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
