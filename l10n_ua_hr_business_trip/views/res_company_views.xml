<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Норма добових на формі компанії -->
    <record id="res_company_form_business_trip" model="ir.ui.view">
        <field name="name">res.company.form.business.trip</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="l10n_ua_business_trip_daily_rate"/>
            </xpath>
        </field>
    </record>

</odoo>
