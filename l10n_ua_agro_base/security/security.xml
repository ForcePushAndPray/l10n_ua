<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_l10n_ua_agro" model="ir.module.category">
            <field name="name">Agro (UA)</field>
            <field name="sequence">60</field>
        </record>

        <record id="res_groups_privilege_l10n_ua_agro" model="res.groups.privilege">
            <field name="name">Agro</field>
            <field name="category_id" ref="module_category_l10n_ua_agro"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ua_agro_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_l10n_ua_agro"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Агроном, обліковець: поля, посіви, оренда землі.</field>
        </record>

        <record id="group_ua_agro_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_l10n_ua_agro"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_ua_agro_user'))]"/>
            <field name="comment">Повний доступ: довідники культур, сезони, налаштування.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="agro_field_company_rule" model="ir.rule">
            <field name="name">Agro field: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_agro_field"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="agro_season_company_rule" model="ir.rule">
            <field name="name">Agro season: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_agro_season"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="agro_planting_company_rule" model="ir.rule">
            <field name="name">Agro planting: multi-company</field>
            <field name="model_id" ref="model_l10n_ua_agro_planting"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
