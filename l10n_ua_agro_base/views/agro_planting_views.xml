<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_agro_planting_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.agro.planting.list</field>
        <field name="model">l10n_ua.agro.planting</field>
        <field name="arch" type="xml">
            <list string="Plantings" editable="bottom">
                <field name="season_id"/>
                <field name="field_id"/>
                <field name="crop_id"/>
                <field name="variety" optional="show"/>
                <field name="sowing_date" optional="show"/>
                <field name="predecessor_crop_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="area" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_agro_planting_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.agro.planting.search</field>
        <field name="model">l10n_ua.agro.planting</field>
        <field name="arch" type="xml">
            <search string="Plantings">
                <field name="field_id"/>
                <field name="crop_id"/>
                <field name="season_id"/>
                <field name="variety"/>
                <group>
                    <filter string="Season" name="groupby_season" domain="[]" context="{'group_by': 'season_id'}"/>
                    <filter string="Crop" name="groupby_crop" domain="[]" context="{'group_by': 'crop_id'}"/>
                    <filter string="Crop Group" name="groupby_crop_group" domain="[]" context="{'group_by': 'crop_group'}"/>
                    <filter string="Field" name="groupby_field" domain="[]" context="{'group_by': 'field_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_agro_planting_view_pivot" model="ir.ui.view">
        <field name="name">l10n_ua.agro.planting.pivot</field>
        <field name="model">l10n_ua.agro.planting</field>
        <field name="arch" type="xml">
            <pivot string="Sown Area Structure" sample="1">
                <field name="crop_group" type="row"/>
                <field name="crop_id" type="row"/>
                <field name="season_id" type="col"/>
                <field name="area" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_ua_agro_planting_view_graph" model="ir.ui.view">
        <field name="name">l10n_ua.agro.planting.graph</field>
        <field name="model">l10n_ua.agro.planting</field>
        <field name="arch" type="xml">
            <graph string="Sown Area Structure" type="pie" sample="1">
                <field name="crop_id"/>
                <field name="area" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="l10n_ua_agro_planting_action" model="ir.actions.act_window">
        <field name="name">Plantings</field>
        <field name="res_model">l10n_ua.agro.planting</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_groupby_season': 1}</field>
    </record>

    <record id="l10n_ua_agro_planting_report_action" model="ir.actions.act_window">
        <field name="name">Sown Area Structure</field>
        <field name="res_model">l10n_ua.agro.planting</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

</odoo>
