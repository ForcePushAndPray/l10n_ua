<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_education" model="ir.ui.view">
        <field name="name">res.company.form.education</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Освітня установа (UA)" name="ua_education">
                    <group>
                        <field name="l10n_ua_education_type"/>
                        <field name="l10n_ua_education_is_state"
                               invisible="not l10n_ua_education_type"/>
                        <field name="l10n_ua_education_iea_code"
                               invisible="not l10n_ua_education_type"/>
                    </group>
                    <group>
                        <field name="l10n_ua_education_license_number"
                               invisible="not l10n_ua_education_type"/>
                        <field name="l10n_ua_education_license_date"
                               invisible="not l10n_ua_education_type"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
