<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_education_academic_year_list" model="ir.ui.view">
        <field name="name">l10n_ua.education.academic.year.list</field>
        <field name="model">l10n_ua.education.academic.year</field>
        <field name="arch" type="xml">
            <list string="Навчальні роки"
                  decoration-success="is_active"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="year_start"/>
                <field name="year_end"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_education_academic_year_form" model="ir.ui.view">
        <field name="name">l10n_ua.education.academic.year.form</field>
        <field name="model">l10n_ua.education.academic.year</field>
        <field name="arch" type="xml">
            <form string="Навчальний рік">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="year_start"/>
                            <field name="year_end" readonly="1"/>
                            <field name="state"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Примітки">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ua_education_academic_year" model="ir.actions.act_window">
        <field name="name">Навчальні роки</field>
        <field name="res_model">l10n_ua.education.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
