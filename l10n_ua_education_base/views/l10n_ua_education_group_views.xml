<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_education_group_list" model="ir.ui.view">
        <field name="name">l10n_ua.education.group.list</field>
        <field name="model">l10n_ua.education.group</field>
        <field name="arch" type="xml">
            <list string="Групи / класи" decoration-muted="not active">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="group_type"/>
                <field name="level"/>
                <field name="profile" optional="show"/>
                <field name="academic_year_id"/>
                <field name="teacher_id" optional="show"/>
                <field name="member_count"/>
                <field name="capacity" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_education_group_form" model="ir.ui.view">
        <field name="name">l10n_ua.education.group.form</field>
        <field name="model">l10n_ua.education.group</field>
        <field name="arch" type="xml">
            <form string="Група / клас">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="group_type"/>
                            <field name="level"/>
                            <field name="profile"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="teacher_id"/>
                            <field name="capacity"/>
                            <field name="member_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Контингент" name="members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="member_type"/>
                                    <field name="state"/>
                                    <field name="date_enrolled"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ua_education_group_search" model="ir.ui.view">
        <field name="name">l10n_ua.education.group.search</field>
        <field name="model">l10n_ua.education.group</field>
        <field name="arch" type="xml">
            <search string="Пошук груп">
                <field name="name"/>
                <field name="profile"/>
                <field name="academic_year_id"/>
                <field name="teacher_id"/>
                <filter string="Активні" name="filter_active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Школа" name="filter_class" domain="[('group_type', '=', 'class')]"/>
                <filter string="ЗДО" name="filter_zdo" domain="[('group_type', '=', 'zdo_group')]"/>
                <filter string="ВНЗ" name="filter_zvo" domain="[('group_type', '=', 'course_group')]"/>
                <group>
                    <filter string="Тип" name="groupby_type" domain="[]" context="{'group_by': 'group_type'}"/>
                    <filter string="Навчальний рік" name="groupby_year" domain="[]" context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_education_group" model="ir.actions.act_window">
        <field name="name">Групи / класи</field>
        <field name="res_model">l10n_ua.education.group</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
