<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_log_list" model="ir.ui.view">
        <field name="name">l10n_ua.ehealth.request.log.list</field>
        <field name="model">l10n_ua.ehealth.request.log</field>
        <field name="arch" type="xml">
            <list string="Лог eHealth"
                  decoration-success="response_status &gt;= 200 and response_status &lt; 300"
                  decoration-danger="response_status &gt;= 400 or response_status == 0">
                <field name="create_date"/>
                <field name="operation"/>
                <field name="method"/>
                <field name="url"/>
                <field name="reference"/>
                <field name="response_status"/>
            </list>
        </field>
    </record>

    <record id="view_log_form" model="ir.ui.view">
        <field name="name">l10n_ua.ehealth.request.log.form</field>
        <field name="model">l10n_ua.ehealth.request.log</field>
        <field name="arch" type="xml">
            <form string="Запит eHealth" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="operation"/>
                            <field name="method"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="url"/>
                            <field name="response_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Запит" name="req">
                            <field name="request_body" widget="text" readonly="1"/>
                        </page>
                        <page string="Відповідь" name="resp">
                            <field name="response_body" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_log" model="ir.actions.act_window">
        <field name="name">Лог eHealth</field>
        <field name="res_model">l10n_ua.ehealth.request.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
