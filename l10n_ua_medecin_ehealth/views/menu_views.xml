<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ehealth_settings" model="ir.actions.act_window">
        <field name="name">Налаштування</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'l10n_ua_medecin_ehealth', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_ehealth_settings"
              name="Налаштування"
              parent="l10n_ua_medecin_base.menu_medecin_config"
              action="action_ehealth_settings"
              sequence="10"
              groups="base.group_system"/>

    <menuitem id="menu_ehealth_log"
              name="Лог eHealth"
              parent="l10n_ua_medecin_base.menu_medecin_config"
              action="action_log"
              sequence="90"
              groups="base.group_no_one"/>
</odoo>
