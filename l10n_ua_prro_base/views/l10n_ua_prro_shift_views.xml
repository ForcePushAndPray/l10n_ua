<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_prro_shift_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.prro.shift.form</field>
        <field name="model">l10n_ua.prro.shift</field>
        <field name="arch" type="xml">
            <form string="PRRO Shift">
                <header>
                    <button name="action_close" string="Close Shift (Z-Report)" type="object" class="btn-danger" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="shift_number"/>
                            <field name="cashier_id"/>
                        </group>
                        <group>
                            <field name="open_date"/>
                            <field name="close_date"/>
                            <field name="z_report_number"/>
                        </group>
                    </group>
                    <group>
                        <group string="Totals">
                            <field name="receipt_count"/>
                            <field name="total_sales"/>
                            <field name="total_returns"/>
                        </group>
                        <group string="By Payment Type">
                            <field name="total_cash"/>
                            <field name="total_card"/>
                        </group>
                    </group>
                    <group>
                        <group string="Service Operations">
                            <field name="service_input"/>
                            <field name="service_output"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipts" name="receipts">
                            <field name="receipt_ids">
                                <list>
                                    <field name="fiscal_number"/>
                                    <field name="receipt_type"/>
                                    <field name="payment_type"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_prro_shift_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.prro.shift.list</field>
        <field name="model">l10n_ua.prro.shift</field>
        <field name="arch" type="xml">
            <list string="PRRO Shifts">
                <field name="name"/>
                <field name="config_id"/>
                <field name="cashier_id"/>
                <field name="open_date"/>
                <field name="close_date"/>
                <field name="receipt_count"/>
                <field name="total_sales" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_prro_shift_action" model="ir.actions.act_window">
        <field name="name">PRRO Shifts</field>
        <field name="res_model">l10n_ua.prro.shift</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
