<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kpkvk_import_form" model="ir.ui.view">
        <field name="name">l10n_ua.kpkvk.import.form</field>
        <field name="model">l10n_ua.kpkvk.import</field>
        <field name="arch" type="xml">
            <form string="Імпорт КПКВК">
                <group>
                    <field name="year"/>
                    <field name="file_format"/>
                    <field name="encoding"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="overwrite"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>CSV-формат:</strong> UTF-8, заголовки: <code>code, name</code> (опційно <code>description</code>).<br/>
                    <strong>DBF-формат:</strong> потрібен модуль <code>l10n_ua_budget_treasury_dbf</code>.
                </div>
                <group string="Результат" invisible="not result_log">
                    <field name="result_log" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Імпортувати" class="btn-primary"/>
                    <button special="cancel" string="Закрити" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kpkvk_import" model="ir.actions.act_window">
        <field name="name">Імпорт КПКВК</field>
        <field name="res_model">l10n_ua.kpkvk.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
