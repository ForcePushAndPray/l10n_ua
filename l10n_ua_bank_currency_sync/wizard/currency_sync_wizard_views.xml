<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="currency_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.currency.sync.wizard.form</field>
        <field name="model">l10n_ua.currency.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Currency Rates">
                <group>
                    <group string="Providers">
                        <field name="provider_ids" widget="many2many_tags" nolabel="1"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Period">
                        <field name="period_type"/>
                        <field name="date_from" readonly="period_type != 'custom'"/>
                        <field name="date_to" readonly="period_type != 'custom'"/>
                        <field name="days_count" readonly="1"/>
                    </group>
                </group>

                <field name="has_nbu" invisible="1"/>

                <!-- Warning for historical rates -->
                <div class="alert alert-warning" role="alert"
                     invisible="has_nbu or days_count &lt;= 1">
                    <strong>Warning:</strong> Only NBU supports historical rates.
                    PrivatBank and Monobank will only sync today's rate if today is in the selected range.
                </div>

                <div class="alert alert-info" role="alert">
                    <p><strong>Provider Capabilities:</strong></p>
                    <ul>
                        <li><strong>NBU</strong> - Official rates, supports historical data (any date)</li>
                        <li><strong>PrivatBank</strong> - Commercial rates, only current day</li>
                        <li><strong>Monobank</strong> - Commercial rates, only current day (1 req/min limit)</li>
                    </ul>
                </div>

                <footer>
                    <button name="action_sync" string="Sync Rates" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="currency_sync_wizard_action" model="ir.actions.act_window">
        <field name="name">Sync Currency Rates</field>
        <field name="res_model">l10n_ua.currency.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
