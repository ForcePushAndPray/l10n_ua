<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled action to sync currency rates daily -->
        <record id="ir_cron_currency_sync" model="ir.cron">
            <field name="name">Currency Rates: Daily Sync</field>
            <field name="model_id" ref="l10n_ua_bank_currency_sync.model_res_currency_rate_provider"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_rates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
