<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_delivery_warehouse_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.delivery.warehouse.form</field>
        <field name="model">l10n_ua.delivery.warehouse</field>
        <field name="arch" type="xml">
            <form string="Delivery Warehouse">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="carrier_type"/>
                            <field name="warehouse_ref"/>
                            <field name="warehouse_number"/>
                            <field name="warehouse_type"/>
                        </group>
                        <group>
                            <field name="city"/>
                            <field name="city_ref"/>
                            <field name="address"/>
                            <field name="phone"/>
                            <field name="max_weight"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="schedule" placeholder="Working hours..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_delivery_warehouse_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.delivery.warehouse.list</field>
        <field name="model">l10n_ua.delivery.warehouse</field>
        <field name="arch" type="xml">
            <list string="Delivery Warehouses">
                <field name="carrier_type"/>
                <field name="warehouse_number"/>
                <field name="name"/>
                <field name="city"/>
                <field name="address"/>
                <field name="warehouse_type"/>
            </list>
        </field>
    </record>
