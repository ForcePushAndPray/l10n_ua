    <record id="l10n_ua_delivery_warehouse_action" model="ir.actions.act_window">
        <field name="name">Delivery Warehouses</field>
        <field name="res_model">l10n_ua.delivery.warehouse</field>
        <field name="view_mode">list,form</field>
