<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_agro_cost_report_view_pivot" model="ir.ui.view">
        <field name="name">l10n_ua.agro.cost.report.pivot</field>
        <field name="model">l10n_ua.agro.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Plan / Actual Costs" sample="1">
                <field name="crop_id" type="row"/>
                <field name="field_id" type="row"/>
                <field name="cost_type" type="col"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_ua_agro_cost_report_view_graph" model="ir.ui.view">
        <field name="name">l10n_ua.agro.cost.report.graph</field>
        <field name="model">l10n_ua.agro.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Plan / Actual Costs" type="bar" sample="1">
                <field name="crop_id"/>
                <field name="planned_amount" type="measure"/>
                <field name="actual_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="l10n_ua_agro_cost_report_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.agro.cost.report.search</field>
        <field name="model">l10n_ua.agro.cost.report</field>
        <field name="arch" type="xml">
            <search string="Plan / Actual Costs">
                <field name="season_id"/>
                <field name="crop_id"/>
                <field name="field_id"/>
                <filter string="Plan" name="plan" domain="[('kind', '=', 'plan')]"/>
                <filter string="Actual" name="actual" domain="[('kind', '=', 'actual')]"/>
                <group>
                    <filter string="Season" name="groupby_season" domain="[]" context="{'group_by': 'season_id'}"/>
                    <filter string="Crop" name="groupby_crop" domain="[]" context="{'group_by': 'crop_id'}"/>
                    <filter string="Field" name="groupby_field" domain="[]" context="{'group_by': 'field_id'}"/>
                    <filter string="Cost Type" name="groupby_cost_type" domain="[]" context="{'group_by': 'cost_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_agro_cost_report_action" model="ir.actions.act_window">
        <field name="name">Plan / Actual Costs</field>
        <field name="res_model">l10n_ua.agro.cost.report</field>
        <field name="view_mode">pivot,graph</field>
    </record>

</odoo>
