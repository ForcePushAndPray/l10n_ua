<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Витрати рослинництва несуть дві аналітики: поле і культура. -->
        <record id="analytic_plan_agro_fields" model="account.analytic.plan">
            <field name="name">Fields</field>
            <field name="default_applicability">optional</field>
            <field name="description">Поля сівозміни (Агро): на них відносяться витрати рослинництва.</field>
        </record>
        <record id="analytic_plan_agro_crops" model="account.analytic.plan">
            <field name="name">Crops</field>
            <field name="default_applicability">optional</field>
            <field name="description">Культури (Агро): калькуляція собівартості продукції рослинництва.</field>
        </record>
    </data>
</odoo>
