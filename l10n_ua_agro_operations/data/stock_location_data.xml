<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stock_location_field_consumption" model="stock.location">
            <field name="name">Списання на поля (Агро)</field>
            <field name="usage">production</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="product_category_fuel" model="product.category">
            <field name="name">Паливно-мастильні матеріали</field>
        </record>
        <record id="product_diesel" model="product.product">
            <field name="name">Diesel Fuel</field>
            <field name="is_storable" eval="True"/>
            <field name="categ_id" ref="product_category_fuel"/>
            <field name="uom_id" ref="uom.product_uom_litre"/>
            <field name="standard_price">55.0</field>
            <field name="l10n_ua_agro_material_type">fuel</field>
        </record>
    </data>
</odoo>
