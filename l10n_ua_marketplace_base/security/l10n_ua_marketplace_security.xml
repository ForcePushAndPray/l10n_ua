<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- Marketplace Privilege (replaces module category in Odoo 19) -->
    <record model="res.groups.privilege" id="res_groups_privilege_marketplace">
        <field name="name">Marketplaces</field>
        <field name="sequence">50</field>
    </record>

    <!-- User Group - can view orders, products -->
    <record id="group_marketplace_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_marketplace"/>
    </record>

    <!-- Manager Group - can configure backends, manage pricelists -->
    <record id="group_marketplace_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('group_marketplace_user'))]"/>
    </record>

    <!-- Admin Group - full access including API keys -->
    <record id="group_marketplace_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_marketplace"/>
        <field name="implied_ids" eval="[(4, ref('group_marketplace_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</data>
<data noupdate="1">

    <!-- Record Rules -->

    <!-- Backend: Users see only active backends of their company -->
    <record id="marketplace_backend_rule_user" model="ir.rule">
        <field name="name">Marketplace Backend: User sees company backends</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_marketplace_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="marketplace_backend_rule_manager" model="ir.rule">
        <field name="name">Marketplace Backend: Manager full access to company</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_marketplace_manager'))]"/>
    </record>

    <!-- Orders: Multi-company rule -->
    <record id="marketplace_order_rule_company" model="ir.rule">
        <field name="name">Marketplace Order: Multi-company</field>
        <field name="model_id" ref="model_marketplace_order"/>
        <field name="domain_force">[('backend_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_marketplace_user'))]"/>
    </record>

    <!-- Pricelist: Multi-company rule -->
    <record id="marketplace_pricelist_rule_company" model="ir.rule">
        <field name="name">Marketplace Pricelist: Multi-company</field>
        <field name="model_id" ref="model_marketplace_pricelist"/>
        <field name="domain_force">[('backend_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_marketplace_user'))]"/>
    </record>

</data>
</odoo>
