<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Import Orders Cron Job -->
    <record forcecreate="True" id="ir_cron_marketplace_import_orders" model="ir.cron">
        <field name="name">Marketplace: Import Orders</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_orders_all()</field>
    </record>

    <!-- Sync Stock Cron Job -->
    <record forcecreate="True" id="ir_cron_marketplace_sync_stock" model="ir.cron">
        <field name="name">Marketplace: Sync Stock</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_stock_all()</field>
    </record>

    <!-- Sync Prices Cron Job -->
    <record forcecreate="True" id="ir_cron_marketplace_sync_prices" model="ir.cron">
        <field name="name">Marketplace: Sync Prices</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_prices_all()</field>
    </record>

    <!-- Refresh API Tokens Cron Job -->
    <record forcecreate="True" id="ir_cron_marketplace_refresh_tokens" model="ir.cron">
        <field name="name">Marketplace: Refresh API Tokens</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="model_id" ref="model_marketplace_backend"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_tokens()</field>
    </record>

</odoo>
