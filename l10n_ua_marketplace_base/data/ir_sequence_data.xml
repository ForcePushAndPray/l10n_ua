<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Backend Code Sequence -->
        <record id="seq_marketplace_backend" model="ir.sequence">
            <field name="name">Marketplace Backend Code</field>
            <field name="code">marketplace.backend</field>
            <field name="prefix">MP</field>
            <field name="padding">3</field>
        </record>

        <!-- Internal Order Name Sequence -->
        <record id="seq_marketplace_order" model="ir.sequence">
            <field name="name">Marketplace Order</field>
            <field name="code">marketplace.order</field>
            <field name="prefix">MO/%(year)s/</field>
            <field name="padding">6</field>
        </record>

    </data>
</odoo>
