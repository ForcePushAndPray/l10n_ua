<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cancel Wizard Form View -->
    <record id="marketplace_order_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">marketplace.order.cancel.wizard.form</field>
        <field name="model">marketplace.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Marketplace Order">
                <group>
                    <field name="order_ids" readonly="1" widget="many2many_tags"/>
                    <field name="backend_id" readonly="1"/>
                    <field name="marketplace_type" invisible="1"/>
                </group>
                <group>
                    <field name="cancel_reason"/>
                    <field name="cancel_comment" placeholder="Optional comment..."/>
                </group>
                <group>
                    <field name="sync_to_marketplace"/>
                    <field name="cancel_sale_order"/>
                </group>
                <footer>
                    <button name="action_cancel" type="object" string="Cancel Order(s)"
                            class="btn-primary" confirm="Are you sure you want to cancel the selected order(s)?"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cancel Wizard Action -->
    <record id="marketplace_order_cancel_wizard_action" model="ir.actions.act_window">
        <field name="name">Cancel Marketplace Order</field>
        <field name="res_model">marketplace.order.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
