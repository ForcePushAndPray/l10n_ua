<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_marketplace" model="ir.ui.view">
        <field name="name">product.template.form.marketplace</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="sales" position="after">
                <page string="Marketplaces" name="marketplaces">
                    <group>
                        <group>
                            <field name="marketplace_publish"/>
                            <field name="uktzed_code"/>
                        </group>
                    </group>
                    <group invisible="not marketplace_publish">
                        <field name="marketplace_ids" widget="many2many_tags"/>
                        <field name="marketplace_category_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
