<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_marketplace_category_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.category.form</field>
        <field name="model">l10n_ua.marketplace.category</field>
        <field name="arch" type="xml">
            <form string="Marketplace Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="marketplace_type"/>
                            <field name="external_id"/>
                        </group>
                        <group>
                            <field name="odoo_category_id"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_marketplace_category_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.category.list</field>
        <field name="model">l10n_ua.marketplace.category</field>
        <field name="arch" type="xml">
            <list string="Marketplace Categories">
                <field name="marketplace_type"/>
                <field name="external_id"/>
                <field name="name"/>
                <field name="odoo_category_id"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_marketplace_category_action" model="ir.actions.act_window">
        <field name="name">Category Mapping</field>
        <field name="res_model">l10n_ua.marketplace.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
