<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category Form View -->
    <record id="marketplace_category_view_form" model="ir.ui.view">
        <field name="name">marketplace.category.form</field>
        <field name="model">marketplace.category</field>
        <field name="arch" type="xml">
            <form string="Marketplace Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="marketplace_type"/>
                            <field name="external_id"/>
                            <field name="parent_id"/>
                            <field name="full_path" readonly="1"/>
                        </group>
                        <group>
                            <field name="odoo_category_ids" widget="many2many_tags"/>
                            <field name="product_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="child_ids">
                        <list>
                            <field name="name"/>
                            <field name="external_id"/>
                            <field name="product_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Tree View -->
    <record id="marketplace_category_view_tree" model="ir.ui.view">
        <field name="name">marketplace.category.tree</field>
        <field name="model">marketplace.category</field>
        <field name="arch" type="xml">
            <list string="Marketplace Categories">
                <field name="marketplace_type"/>
                <field name="full_path"/>
                <field name="external_id"/>
                <field name="product_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="marketplace_category_view_search" model="ir.ui.view">
        <field name="name">marketplace.category.search</field>
        <field name="model">marketplace.category</field>
        <field name="arch" type="xml">
            <search string="Marketplace Categories">
                <field name="name"/>
                <field name="full_path"/>
                <field name="external_id"/>
                <filter string="Rozetka" name="filter_rozetka" domain="[('marketplace_type', '=', 'rozetka')]"/>
                <filter string="Prom.ua" name="filter_prom" domain="[('marketplace_type', '=', 'prom')]"/>
                <filter string="Epicentr" name="filter_epicentr" domain="[('marketplace_type', '=', 'epicentr')]"/>
                <separator/>
                <group>
                    <filter string="Marketplace" name="groupby_type" domain="[]"
                            context="{'group_by': 'marketplace_type'}"/>
                    <filter string="Parent" name="groupby_parent" domain="[]"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Category Action -->
    <record id="marketplace_category_action" model="ir.actions.act_window">
        <field name="name">Marketplace Categories</field>
        <field name="res_model">marketplace.category</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
