<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_marketplace_config_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.config.form</field>
        <field name="model">l10n_ua.marketplace.config</field>
        <field name="arch" type="xml">
            <form string="Marketplace Configuration">
                <header>
                    <button name="mp_sync_products" string="Sync Products" type="object"/>
                    <button name="mp_sync_stock" string="Sync Stock" type="object"/>
                    <button name="mp_import_orders" string="Import Orders" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="marketplace_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="api_url"/>
                            <field name="api_key" password="True"/>
                            <field name="feed_url" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Automation">
                            <field name="auto_sync_stock"/>
                            <field name="auto_import_orders"/>
                            <field name="sync_interval"/>
                        </group>
                        <group string="Status">
                            <field name="last_sync_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_marketplace_config_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.config.list</field>
        <field name="model">l10n_ua.marketplace.config</field>
        <field name="arch" type="xml">
            <list string="Marketplace Configurations">
                <field name="name"/>
                <field name="marketplace_type"/>
                <field name="auto_sync_stock"/>
                <field name="auto_import_orders"/>
                <field name="last_sync_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_marketplace_config_action" model="ir.actions.act_window">
        <field name="name">Marketplaces</field>
        <field name="res_model">l10n_ua.marketplace.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="l10n_ua_marketplace_order_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.order.form</field>
        <field name="model">l10n_ua.marketplace.order</field>
        <field name="arch" type="xml">
            <form string="Marketplace Order">
                <header>
                    <button name="action_create_sale_order" string="Create Sale Order" type="object" class="btn-primary" invisible="sale_order_id"/>
                    <button name="action_sync_status" string="Sync Status" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,processing,shipped,delivered"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id"/>
                            <field name="marketplace_config_id"/>
                            <field name="order_date"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="total_amount"/>
                            <field name="marketplace_state"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="delivery_method"/>
                        </group>
                    </group>
                    <field name="delivery_address"/>
                    <notebook>
                        <page string="Raw Data" name="raw_data">
                            <field name="raw_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_marketplace_order_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.marketplace.order.list</field>
        <field name="model">l10n_ua.marketplace.order</field>
        <field name="arch" type="xml">
            <list string="Marketplace Orders">
                <field name="name"/>
                <field name="external_id"/>
                <field name="marketplace_type"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="total_amount" sum="Total"/>
                <field name="sale_order_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_marketplace_order_action" model="ir.actions.act_window">
        <field name="name">Marketplace Orders</field>
        <field name="res_model">l10n_ua.marketplace.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
