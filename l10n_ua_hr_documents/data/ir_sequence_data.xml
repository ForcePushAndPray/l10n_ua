<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="seq_hr_order" model="ir.sequence">
            <field name="name">HR Order</field>
            <field name="code">hr.order</field>
            <field name="prefix">НК-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_hr_order_hiring" model="ir.sequence">
            <field name="name">HR Order - Hiring</field>
            <field name="code">hr.order.hiring</field>
            <field name="prefix">НК-П-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_hr_order_termination" model="ir.sequence">
            <field name="name">HR Order - Termination</field>
            <field name="code">hr.order.termination</field>
            <field name="prefix">НК-З-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_hr_order_vacation" model="ir.sequence">
            <field name="name">HR Order - Vacation</field>
            <field name="code">hr.order.vacation</field>
            <field name="prefix">НК-В-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_hr_personal_file" model="ir.sequence">
            <field name="name">Personal File</field>
            <field name="code">hr.personal.file</field>
            <field name="prefix">ОС-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
    </data>
</odoo>
