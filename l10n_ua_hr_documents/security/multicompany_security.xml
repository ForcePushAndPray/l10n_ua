<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company record rule (issue #178).
             hr.personal.file carries company_id but had no multi-company
             ir.rule, so records leaked across ALL companies. Standard Odoo
             pattern (see l10n_ua_account_vat pilot). -->

        <record id="hr_personal_file_company_rule" model="ir.rule">
            <field name="name">Особова справа: multi-company</field>
            <field name="model_id" ref="model_hr_personal_file"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
