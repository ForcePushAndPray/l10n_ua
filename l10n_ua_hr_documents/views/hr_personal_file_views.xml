<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_personal_file_view_form" model="ir.ui.view">
        <field name="name">hr.personal.file.form</field>
        <field name="model">hr.personal.file</field>
        <field name="arch" type="xml">
            <form string="Personal File">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="birth_place"/>
                            <field name="citizenship"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Education" name="education">
                            <group>
                                <group>
                                    <field name="education_level"/>
                                    <field name="education_institution"/>
                                </group>
                                <group>
                                    <field name="graduation_year"/>
                                    <field name="specialty"/>
                                    <field name="qualification"/>
                                </group>
                            </group>
                        </page>
                        <page string="Military" name="military">
                            <group>
                                <group>
                                    <field name="military_status"/>
                                    <field name="military_rank"/>
                                    <field name="military_specialty"/>
                                </group>
                            </group>
                        </page>
                        <page string="Family" name="family">
                            <group>
                                <field name="marital_status"/>
                            </group>
                            <field name="family_member_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="relation"/>
                                    <field name="birth_date"/>
                                    <field name="birth_place"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="number"/>
                                    <field name="date"/>
                                    <field name="issued_by"/>
                                    <field name="valid_until"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work History" name="work_history">
                            <field name="work_history_ids">
                                <list editable="bottom">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="organization"/>
                                    <field name="position"/>
                                    <field name="entry_type"/>
                                    <field name="order_number"/>
                                    <field name="order_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_personal_file_view_tree" model="ir.ui.view">
        <field name="name">hr.personal.file.tree</field>
        <field name="model">hr.personal.file</field>
        <field name="arch" type="xml">
            <list string="Personal Files">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="education_level"/>
                <field name="military_status"/>
                <field name="marital_status"/>
            </list>
        </field>
    </record>

    <record id="hr_personal_file_view_search" model="ir.ui.view">
        <field name="name">hr.personal.file.search</field>
        <field name="model">hr.personal.file</field>
        <field name="arch" type="xml">
            <search string="Search Personal Files">
                <field name="name"/>
                <field name="employee_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_education" string="Education" context="{'group_by': 'education_level'}"/>
                    <filter name="group_military" string="Military Status" context="{'group_by': 'military_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_personal_file" model="ir.actions.act_window">
        <field name="name">Personal Files</field>
        <field name="res_model">hr.personal.file</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_personal_file_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a personal file for an employee
            </p>
        </field>
    </record>

</odoo>
