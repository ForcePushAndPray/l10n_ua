<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add buttons to hr.employee form view -->
    <record id="hr_employee_view_form_inherit_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add smart button for orders -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="orders_count == 0">
                    <field name="orders_count" widget="statinfo" string="Накази"/>
                </button>
            </xpath>
            <!-- Add "New Order" button in header -->
            <xpath expr="//header" position="inside">
                    <button name="action_create_order"
                            type="object"
                            string="Новий наказ"
                            class="btn-primary"
                            icon="fa-plus"/>
            </xpath>
        </field>
    </record>

</odoo>
