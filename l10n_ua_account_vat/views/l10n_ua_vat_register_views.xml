<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VAT Register Form -->
    <record id="l10n_ua_vat_register_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.vat.register.form</field>
        <field name="model">l10n_ua.vat.register</field>
        <field name="arch" type="xml">
            <form string="Реєстр ПН">
                <header>
                    <button name="action_compute" string="Розрахувати" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_export_xlsx" string="Експорт XLSX" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_confirm" string="Підтвердити" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Повернути в чернетку" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="True"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="register_type"/>
                            <field name="period_id"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="total_base"/>
                            <field name="total_vat"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Рядки" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="doc_type"/>
                                    <field name="invoice_number"/>
                                    <field name="invoice_date" optional="show"/>
                                    <field name="partner_id"/>
                                    <field name="partner_ipn" optional="show"/>
                                    <field name="base_amount" sum="Total"/>
                                    <field name="vat_amount" sum="Total"/>
                                    <field name="total_amount" sum="Total" optional="show"/>
                                    <field name="tax_invoice_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Деталізація за ставками" name="rate_breakdown">
                            <field name="line_ids" readonly="True">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_number"/>
                                    <field name="base_20" sum="Total"/>
                                    <field name="vat_20" sum="Total"/>
                                    <field name="base_14" sum="Total"/>
                                    <field name="vat_14" sum="Total"/>
                                    <field name="base_7" sum="Total"/>
                                    <field name="vat_7" sum="Total"/>
                                    <field name="base_0" sum="Total"/>
                                    <field name="base_exempt" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- VAT Register List -->
    <record id="l10n_ua_vat_register_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.vat.register.list</field>
        <field name="model">l10n_ua.vat.register</field>
        <field name="arch" type="xml">
            <list string="Реєстри ПН">
                <field name="name"/>
                <field name="register_type"/>
                <field name="period_id"/>
                <field name="line_count"/>
                <field name="total_base" sum="Total"/>
                <field name="total_vat" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- VAT Register Search -->
    <record id="l10n_ua_vat_register_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.vat.register.search</field>
        <field name="model">l10n_ua.vat.register</field>
        <field name="arch" type="xml">
            <search string="Реєстри ПН">
                <field name="period_id"/>

                <filter string="Чернетка" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Підтверджено" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Видані" name="filter_issued" domain="[('register_type', '=', 'issued')]"/>
                <filter string="Отримані" name="filter_received" domain="[('register_type', '=', 'received')]"/>

                <group>
                    <filter string="Тип" name="groupby_type" domain="[]" context="{'group_by': 'register_type'}"/>
                    <filter string="Період" name="groupby_period" domain="[]" context="{'group_by': 'period_id'}"/>
                    <filter string="Стан" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="l10n_ua_vat_register_issued_action" model="ir.actions.act_window">
        <field name="name">Реєстр виданих ПН</field>
        <field name="res_model">l10n_ua.vat.register</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('register_type', '=', 'issued')]</field>
        <field name="context">{'default_register_type': 'issued'}</field>
        <field name="search_view_id" ref="l10n_ua_vat_register_view_search"/>
    </record>

    <record id="l10n_ua_vat_register_received_action" model="ir.actions.act_window">
        <field name="name">Реєстр отриманих ПН</field>
        <field name="res_model">l10n_ua.vat.register</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('register_type', '=', 'received')]</field>
        <field name="context">{'default_register_type': 'received'}</field>
        <field name="search_view_id" ref="l10n_ua_vat_register_view_search"/>
    </record>

    <record id="l10n_ua_vat_register_action" model="ir.actions.act_window">
        <field name="name">Усі реєстри ПН</field>
        <field name="res_model">l10n_ua.vat.register</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ua_vat_register_view_search"/>
    </record>

</odoo>
