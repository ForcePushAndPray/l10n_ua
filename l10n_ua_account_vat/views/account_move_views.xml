<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit account.move form to add PN smart button -->
    <record id="view_move_form_inherit_vat" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ua_vat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_tax_invoices" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="tax_invoice_count == 0">
                    <field name="tax_invoice_count" widget="statinfo" string="ПН"/>
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_create_tax_invoice" string="Створити ПН" type="object"
                        class="btn-secondary"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') or state != 'posted'"/>
            </xpath>
        </field>
    </record>

</odoo>
