@startuml full_architecture
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam linetype ortho

title Архітектура модулів Ukrainian Localization for Odoo 19

package "Базовий рівень" #LightBlue {
    [l10n_ua_account_base] as base
    note right of base
        КВЕД, КАТОТТГ
        Валідація ЄДРПОУ/ІПН
        Форматування
    end note
}

package "Бухгалтерія" #LightGreen {
    [l10n_ua_accounting] as accounting
    [l10n_ua_assets] as assets

    note right of accounting
        План рахунків П(С)БО
        Журнали-ордери
        ОСВ, Баланс
    end note
}

package "Податки" #LightYellow {
    [l10n_ua_tax] as tax
    [l10n_ua_account_vat] as vat
    [l10n_ua_fop] as fop
    [l10n_ua_tax_cabinet] as cabinet
    [l10n_ua_tax_F0103309] as f0103309

    note right of tax
        ПДФО, ВЗ, ЄСВ, ПДВ
    end note

    note right of cabinet
        cabinet.tax.gov.ua
        XML документи
    end note
}

package "Банки" #LightCoral {
    [l10n_ua_bank_sync] as bank_sync
    [l10n_ua_bank_privat] as privat
    [l10n_ua_bank_mono] as mono
    [l10n_ua_bank_currency_sync] as currency

    note right of bank_sync
        МФО, IBAN
        Імпорт виписок
    end note
}

package "ПРРО" #Plum {
    [l10n_ua_prro_base] as prro_base
    [l10n_ua_prro_checkbox] as checkbox

    note right of prro_base
        Чеки, Зміни
        X/Z-звіти
    end note
}

package "Доставка" #LightSkyBlue {
    [l10n_ua_delivery_base] as delivery_base
    [l10n_ua_delivery_novaposhta] as novaposhta
    [l10n_ua_delivery_meest] as meest
    [l10n_ua_delivery_ukrposhta] as ukrposhta

    note right of novaposhta
        ТТН, Відстеження
        Післяплата
    end note
}

package "Маркетплейси" #Wheat {
    [l10n_ua_marketplace_base] as mp_base
    [l10n_ua_marketplace_rozetka] as rozetka
    [l10n_ua_marketplace_prom] as prom

    note right of mp_base
        YML фіди
        Імпорт замовлень
    end note
}

package "HR" #PaleGreen {
    [l10n_ua_hr_base] as hr_base
    [l10n_ua_hr_contract] as hr_contract
    [l10n_ua_hr_documents] as hr_docs
    [l10n_ua_hr_salary] as hr_salary
    [l10n_ua_hr_holidays] as hr_holidays
    [l10n_ua_hr_reports] as hr_reports

    note right of hr_base
        Працівники, КП-2010
        Військовий облік
    end note
}

' Dependencies
base --> accounting
base --> tax
base --> bank_sync
base --> prro_base
base --> delivery_base
base --> mp_base
base --> hr_base

accounting --> assets
accounting --> vat

tax --> vat
tax --> fop
tax --> cabinet
cabinet --> f0103309

bank_sync --> privat
bank_sync --> mono
bank_sync --> currency

prro_base --> checkbox

delivery_base --> novaposhta
delivery_base --> meest
delivery_base --> ukrposhta

mp_base --> rozetka
mp_base --> prom

hr_base --> hr_contract
hr_base --> hr_docs
hr_base --> hr_holidays
hr_contract --> hr_salary
hr_salary --> hr_reports

@enduml
