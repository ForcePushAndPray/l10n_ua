<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="l10n_ua_tax_document_type_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.type.list</field>
        <field name="model">l10n_ua.tax.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="l10n_ua_tax_document_type_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.type.form</field>
        <field name="model">l10n_ua.tax.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="l10n_ua_tax_document_type_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.tax.document.type.search</field>
        <field name="model">l10n_ua.tax.document.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="code"/>
                <field name="name"/>
                <filter name="declarations" string="Declarations" domain="[('category', '=', 'declaration')]"/>
                <filter name="reports" string="Reports" domain="[('category', '=', 'report')]"/>
                <filter name="receipts" string="Receipts" domain="[('category', '=', 'receipt')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="l10n_ua_tax_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">l10n_ua.tax.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No document types defined
            </p>
            <p>
                Define types of tax documents (declarations, reports, receipts, etc.)
            </p>
        </field>
    </record>

</odoo>
