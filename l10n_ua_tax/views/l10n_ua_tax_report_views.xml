<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_tax_report_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax.report.form</field>
        <field name="model">l10n_ua.tax.report</field>
        <field name="arch" type="xml">
            <form string="Tax Report">
                <header>
                    <button name="action_calculate" string="Calculate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_xml" string="Generate XML" type="object" invisible="state not in ('calculated', 'submitted')"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'calculated'"/>
                    <button name="action_accept" string="Mark Accepted" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,submitted,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="period_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="submission_date"/>
                            <field name="acceptance_date"/>
                            <field name="xml_file" filename="xml_filename"/>
                            <field name="xml_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_tax_report_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax.report.list</field>
        <field name="model">l10n_ua.tax.report</field>
        <field name="arch" type="xml">
            <list string="Tax Reports">
                <field name="name"/>
                <field name="report_type"/>
                <field name="period_id"/>
                <field name="submission_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_tax_report_action" model="ir.actions.act_window">
        <field name="name">Tax Reports</field>
        <field name="res_model">l10n_ua.tax.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
