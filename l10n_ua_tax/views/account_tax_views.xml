<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_form_ua" model="ir.ui.view">
        <field name="name">account.tax.form.ua</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ua_tax_type"/>
                <field name="ua_tax_code"/>
                <field name="ua_budget_code_id"/>
            </field>
        </field>
    </record>

</odoo>
