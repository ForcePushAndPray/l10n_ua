<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="l10n_ua_budget_code_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.budget.code.list</field>
        <field name="model">l10n_ua.budget.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="tax_type" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="l10n_ua_budget_code_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.budget.code.form</field>
        <field name="model">l10n_ua.budget.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="tax_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="l10n_ua_budget_code_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.budget.code.search</field>
        <field name="model">l10n_ua.budget.code</field>
        <field name="arch" type="xml">
            <search string="Budget Codes">
                <field name="code"/>
                <field name="name"/>
                <field name="tax_type"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="l10n_ua_budget_code_action" model="ir.actions.act_window">
        <field name="name">Budget Codes</field>
        <field name="res_model">l10n_ua.budget.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_ua_budget_code_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No budget codes found
            </p>
            <p>
                Budget classification codes (КБК) are used for tax payments.
            </p>
        </field>
    </record>

</odoo>
