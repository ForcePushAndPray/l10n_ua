<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================== -->
        <!-- Категорія модуля                               -->
        <!-- ============================================== -->
        <record id="module_category_l10n_ua" model="ir.module.category">
            <field name="name">Ukraine Localization</field>
            <field name="description">Ukrainian accounting and HR localization modules</field>
            <field name="sequence">50</field>
        </record>

        <!-- ============================================== -->
        <!-- Групи доступу                                  -->
        <!-- ============================================== -->

        <!-- Технічна авто-керована група: користувач має щонайменше одну
             українську компанію (country=UA) серед доступних (company_ids).
             Керується автоматично res.users._l10n_ua_recompute_has_ua_company;
             НЕ призначати вручну. Використовується для приховування UA-апів у
             користувачів без української компанії (issue #178). -->
        <record id="group_has_ua_company" model="res.groups">
            <field name="name">UA: має українську компанію (авто)</field>
            <field name="comment">Технічна група, керується автоматично за наявністю української компанії у користувача. Не призначати вручну.</field>
        </record>

        <!-- Базовий користувач UA -->
        <record id="group_ua_user" model="res.groups">
            <field name="name">UA User</field>
            <field name="comment">Basic access to Ukrainian localization features (directories, validators)</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Бухгалтер UA -->
        <record id="group_ua_accountant" model="res.groups">
            <field name="name">UA Accountant</field>
            <field name="comment">Access to Ukrainian accounting features (OSV, journal orders, documents)</field>
            <field name="implied_ids" eval="[(4, ref('group_ua_user')), (4, ref('account.group_account_user'))]"/>
        </record>

        <!-- Податковий бухгалтер UA -->
        <record id="group_ua_tax_accountant" model="res.groups">
            <field name="name">UA Tax Accountant</field>
            <field name="comment">Access to Ukrainian tax features (VAT, tax cabinet, declarations)</field>
            <field name="implied_ids" eval="[(4, ref('group_ua_accountant'))]"/>
        </record>

        <!-- Головний бухгалтер / Керівник UA -->
        <record id="group_ua_manager" model="res.groups">
            <field name="name">UA Chief Accountant</field>
            <field name="comment">Full access to Ukrainian accounting, tax, and reporting features</field>
            <field name="implied_ids" eval="[(4, ref('group_ua_tax_accountant')), (4, ref('account.group_account_manager'))]"/>
        </record>

    </data>
</odoo>
