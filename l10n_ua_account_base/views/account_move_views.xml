<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_ua" model="ir.ui.view">
        <field name="name">account.move.form.ua</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <!-- Company-country gate (issue #178): hide UA fields for non-UA companies -->
                <field name="l10n_ua_is_ua_company" invisible="1"/>
                <field name="ua_doc_type" invisible="not l10n_ua_is_ua_company"/>
                <field name="ua_doc_number" invisible="not l10n_ua_is_ua_company"/>
                <field name="ua_doc_date" invisible="not l10n_ua_is_ua_company"/>
                <field name="ua_counterparty_doc" invisible="not l10n_ua_is_ua_company"/>
            </field>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="l10n_ua_discount_total"
                       invisible="l10n_ua_discount_total == 0 or not l10n_ua_is_ua_company"/>
                <field name="l10n_ua_amount_words" colspan="2" nolabel="0"
                       invisible="not l10n_ua_amount_words or not l10n_ua_is_ua_company"/>
            </xpath>
        </field>
    </record>

</odoo>
