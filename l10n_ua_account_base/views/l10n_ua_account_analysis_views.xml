<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_account_analysis_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.account.analysis.form</field>
        <field name="model">l10n_ua.account.analysis</field>
        <field name="arch" type="xml">
            <form string="Account Analysis">
                <header>
                    <button name="action_compute" string="Compute" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="opening_balance"/>
                            <field name="total_debit"/>
                        </group>
                        <group>
                            <field name="closing_balance"/>
                            <field name="total_credit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Correspondence" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="corr_account_id"/>
                                    <field name="turnover_debit" sum="Total Debit"/>
                                    <field name="turnover_credit" sum="Total Credit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_account_analysis_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.account.analysis.list</field>
        <field name="model">l10n_ua.account.analysis</field>
        <field name="arch" type="xml">
            <list string="Account Analysis">
                <field name="name"/>
                <field name="account_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_account_analysis_action" model="ir.actions.act_window">
        <field name="name">Account Analysis</field>
        <field name="res_model">l10n_ua.account.analysis</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
