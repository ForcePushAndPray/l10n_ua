<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_npo_program_report_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.npo.program.report.form</field>
        <field name="model">l10n_ua.npo.program.report</field>
        <field name="arch" type="xml">
            <form string="Target Programs Report">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary"/>
                    <button name="action_print" type="object" string="Print"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="program_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="program_id"/>
                            <field name="partner_id" optional="show"/>
                            <field name="budget_amount" optional="show" sum="Total"/>
                            <field name="opening_balance" sum="Total"/>
                            <field name="received" sum="Total"/>
                            <field name="recognised" sum="Total"/>
                            <field name="other_debit" optional="show" sum="Total"/>
                            <field name="closing_balance" sum="Total"/>
                            <field name="spent" sum="Total"/>
                            <field name="uncovered" optional="show" sum="Total"/>
                            <field name="budget_used" optional="show" widget="progressbar"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ua_npo_program_report_action" model="ir.actions.act_window">
        <field name="name">Target Programs Report</field>
        <field name="res_model">l10n_ua.npo.program.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
