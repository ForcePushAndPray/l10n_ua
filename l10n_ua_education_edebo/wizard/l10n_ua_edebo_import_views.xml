<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edebo_import_form" model="ir.ui.view">
        <field name="name">l10n_ua.edebo.import.form</field>
        <field name="model">l10n_ua.edebo.import</field>
        <field name="arch" type="xml">
            <form string="Імпорт з ЄДЕБО">
                <group>
                    <field name="academic_year_id"/>
                    <field name="file_format"/>
                    <field name="encoding"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="default_member_state"/>
                    <field name="dry_run"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>CSV-формат:</strong> UTF-8, заголовки в першому рядку.
                    Обов'язкові колонки: <code>last_name, first_name, birthdate, member_type</code>.<br/>
                    Опційні: <code>middle_name, student_number, rnokpp</code>.<br/>
                    Дата народження — у форматі <code>YYYY-MM-DD</code>.
                </div>
                <group string="Результат" invisible="not result_log">
                    <field name="result_log" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Імпортувати"
                            class="btn-primary"/>
                    <button special="cancel" string="Закрити" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edebo_import" model="ir.actions.act_window">
        <field name="name">Імпорт з ЄДЕБО</field>
        <field name="res_model">l10n_ua.edebo.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
