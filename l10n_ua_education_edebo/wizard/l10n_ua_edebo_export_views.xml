<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edebo_export_form" model="ir.ui.view">
        <field name="name">l10n_ua.edebo.export.form</field>
        <field name="model">l10n_ua.edebo.export</field>
        <field name="arch" type="xml">
            <form string="Експорт у ЄДЕБО">
                <group>
                    <field name="academic_year_id"/>
                    <field name="state_filter"/>
                </group>
                <group string="Файл експорту" invisible="not file">
                    <field name="file" filename="filename" readonly="1"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Експортувати"
                            class="btn-primary"/>
                    <button special="cancel" string="Закрити" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edebo_export" model="ir.actions.act_window">
        <field name="name">Експорт у ЄДЕБО</field>
        <field name="res_model">l10n_ua.edebo.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
