<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_run_view_form_inherit_account" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.account</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="l10n_ua_hr_salary.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_move" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="not move_id">
                    <field name="move_id" widget="statinfo" string="Проводка"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
