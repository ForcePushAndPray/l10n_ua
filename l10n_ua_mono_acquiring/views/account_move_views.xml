<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_mono_acquiring" model="ir.ui.view">
        <field name="name">account.move.form.mono.acquiring</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="before">
                <page string="Monobank" name="mono_acquiring"
                      invisible="move_type != 'out_invoice'">
                    <group string="Monobank Acquiring">
                        <field name="mono_payment_link" widget="CopyClipboardURL"
                               readonly="1" invisible="not mono_payment_link"/>
                        <field name="mono_invoice_id" readonly="1"
                               invisible="not mono_invoice_id"/>
                        <div>
                            <button name="action_create_mono_link" type="object"
                                    string="Створити посилання Monobank"
                                    class="btn-primary"
                                    invisible="mono_payment_link"/>
                            <button name="action_create_mono_link" type="object"
                                    string="Оновити посилання Monobank"
                                    class="btn-secondary"
                                    invisible="not mono_payment_link"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
