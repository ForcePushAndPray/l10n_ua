<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_agro_land_vat" model="ir.ui.view">
        <field name="name">res.config.settings.agro.land.vat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ua_agro_base.res_config_settings_view_form_agro"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_ua_agro_base']" position="inside">
                <block title="VAT on In-kind Rent" name="agro_in_kind_vat">
                    <setting id="agro_in_kind_vat_included" string="VAT Included in the In-kind Rent"
                             help="Off: VAT is charged on top of the value of the produce and expensed">
                        <field name="l10n_ua_agro_in_kind_vat_included"/>
                        <div class="content-group" invisible="l10n_ua_agro_in_kind_vat_included">
                            <div class="row mt8">
                                <label for="l10n_ua_agro_in_kind_vat_expense_account_id" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ua_agro_in_kind_vat_expense_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
