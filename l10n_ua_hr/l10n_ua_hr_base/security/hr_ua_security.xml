<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Groups -->
    <record id="group_hr_ua_user" model="res.groups">
        <field name="name">Ukraine HR: User</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_ua_officer" model="res.groups">
        <field name="name">Ukraine HR: Officer</field>
        <field name="implied_ids" eval="[(4, ref('l10n_ua_hr_base.group_hr_ua_user'))]"/>
    </record>

    <record id="group_hr_ua_manager" model="res.groups">
        <field name="name">Ukraine HR: Manager</field>
        <field name="implied_ids" eval="[(4, ref('l10n_ua_hr_base.group_hr_ua_officer'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="hr_staffing_table_company_rule" model="ir.rule">
        <field name="name">Staffing Table: Multi-company</field>
        <field name="model_id" ref="model_hr_staffing_table"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_employee_child_rule" model="ir.rule">
        <field name="name">Employee Child: Access via Employee</field>
        <field name="model_id" ref="model_hr_employee_child"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

</odoo>
