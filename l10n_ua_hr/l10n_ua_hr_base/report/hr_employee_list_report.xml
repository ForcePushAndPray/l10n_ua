<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_employee_list" model="ir.actions.report">
        <field name="name">Employee List</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_base.report_hr_employee_list</field>
        <field name="report_file">l10n_ua_hr_base.report_hr_employee_list</field>
        <field name="print_report_name">'Список_працівників_%s' % (time.strftime('%Y%m%d'))</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_a4_ua"/>
    </record>

    <template id="report_hr_employee_list">
        <t t-call="web.html_container">
            <t t-call="l10n_ua_hr_base.report_hr_employee_list_document"/>
        </t>
    </template>

    <template id="report_hr_employee_list_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="docs[0].company_id if docs else env.company"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">
                
                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">СПИСОК ПРАЦІВНИКІВ</h3>
                    <p style="font-size: 10pt;">
                        станом на <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y')"/>
                    </p>
                </div>
                
                <table style="width: 100%; border-collapse: collapse; font-size: 9pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 4px; width: 4%;">№</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 20%;">ПІБ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 15%;">Підрозділ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 15%;">Посада</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 10%;">Дата прийняття</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 10%;">РНОКПП</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 13%;">Телефон</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 13%;">Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-foreach="docs" t-as="employee">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="row_num"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.department_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.job_id.name or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-if="employee.hire_date">
                                        <t t-esc="employee.hire_date.strftime('%d.%m.%Y')"/>
                                    </t>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                    <t t-esc="employee.rnokpp or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="employee.mobile_phone or employee.work_phone or ''"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px; font-size: 8pt;">
                                    <t t-esc="employee.work_email or ''"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                
                <div style="margin-top: 20px; font-size: 10pt;">
                    <p>Всього працівників: <strong><t t-esc="len(docs)"/></strong></p>
                </div>
                
                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Керівник кадрової служби</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>
                
            </div>
        </t>
    </template>

</odoo>
