<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- P&L Report Wizard Form -->
    <record id="view_pnl_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ua.pnl.report.wizard.form</field>
        <field name="model">l10n_ua.pnl.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Звіт про фінансові результати (Форма №2)">
                <group>
                    <group string="Звітний період">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Період для порівняння">
                        <field name="comparison_date_from"/>
                        <field name="comparison_date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- P&L Report Wizard Action -->
    <record id="action_pnl_report_wizard" model="ir.actions.act_window">
        <field name="name">Звіт про фінансові результати (Форма №2)</field>
        <field name="res_model">l10n_ua.pnl.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
