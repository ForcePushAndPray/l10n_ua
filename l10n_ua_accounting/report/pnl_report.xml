<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- P&L Report Action -->
    <record id="action_report_pnl" model="ir.actions.report">
        <field name="name">P&amp;L Statement (Form №2)</field>
        <field name="model">l10n_ua.pnl.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_accounting.report_pnl_document</field>
        <field name="report_file">l10n_ua_accounting.report_pnl_document</field>
        <field name="print_report_name">'ЗФР_%s_%s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="l10n_ua_doc_reports.paperformat_ua_report"/>
    </record>

    <!-- P&L Report Template -->
    <template id="report_pnl_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report">
                        <!-- Header -->
                        <div class="text-center mb-2">
                            <div class="small">Додаток 1 до Національного положення (стандарту)</div>
                            <div class="small">бухгалтерського обліку 1 «Загальні вимоги до фінансової звітності»</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-8">
                                <table class="table-borderless" style="width: 100%;">
                                    <tr>
                                        <td style="width: 120px;">Підприємство</td>
                                        <td class="border-bottom"><span t-field="report.company_id.name"/></td>
                                    </tr>
                                    <tr t-if="report.company_id.company_registry">
                                        <td>за ЄДРПОУ</td>
                                        <td class="border-bottom"><span t-field="report.company_id.company_registry"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-4 text-right">
                                <div class="small">КОДИ</div>
                                <table class="small" style="float: right;">
                                    <tr>
                                        <td class="border">Дата (рік, місяць, число)</td>
                                        <td class="border text-center" t-esc="report.date_to.strftime('%Y.%m.%d')"/>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="ua-report-title">
                            ЗВІТ ПРО ФІНАНСОВІ РЕЗУЛЬТАТИ<br/>
                            (Звіт про сукупний дохід)
                        </div>
                        <div class="ua-report-subtitle mb-3">
                            за <span t-field="report.date_from" t-options='{"widget": "date"}'/> -
                            <span t-field="report.date_to" t-options='{"widget": "date"}'/> р.
                        </div>

                        <div class="small text-center mb-2">Форма № 2 · Код за ДКУД 1801003</div>

                        <!-- P&L Table from stored lines -->
                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Стаття</th>
                                    <th style="width: 10%;">Код рядка</th>
                                    <th style="width: 20%;">За звітний період</th>
                                    <th style="width: 20%;">За аналогічний період попереднього року</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report.line_ids.sorted('sequence')" t-as="line">
                                    <!-- Section title -->
                                    <tr t-if="line.line_type == 'section'">
                                        <td colspan="4" class="bold text-center" t-esc="line.name"/>
                                    </tr>
                                    <t t-else="">
                                        <t t-set="bold" t-value="line.line_type in ('subtotal', 'loss', 'total')"/>
                                        <!-- Expenses and losses in parentheses; 2610–2650 with kopecks; 2600/2605 are counts -->
                                        <t t-set="paren" t-value="line.line_type == 'loss' or line.turnover_type == 'debit'"/>
                                        <t t-set="fmt" t-value="'%.2f' if line.code in ('2610', '2615', '2650') else '%.0f'"/>
                                        <tr t-att-class="'bold' if bold else ''"
                                            t-att-style="'border-top: 2px solid black;' if line.line_type == 'total' else ''">
                                            <td t-esc="line.name"/>
                                            <td class="text-center" t-esc="line.code"/>
                                            <t t-foreach="(line.current_amount, line.previous_amount)" t-as="amount">
                                                <td class="text-right">
                                                    <t t-if="not round(amount, 2)">–</t>
                                                    <t t-elif="paren and amount &gt; 0" t-esc="'(' + (fmt % amount) + ')'"/>
                                                    <t t-else="" t-esc="fmt % amount"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Signatures -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="signature-row">
                                    <span>Керівник</span>
                                    <span class="signature-line"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="signature-row">
                                    <span>Головний бухгалтер</span>
                                    <span class="signature-line"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
