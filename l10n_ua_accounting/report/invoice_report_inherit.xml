<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Override invoice report to add proper table styling for Ukrainian accounting -->
    <template id="report_invoice_document_ua_style"
              inherit_id="account.report_invoice_document"
              priority="99">

        <!-- Add Ukrainian styling CSS before the main content -->
        <xpath expr="//div[hasclass('row')]" position="before">
            <style>
                /* Ukrainian invoice styling */
                .o_main_table {
                    border-collapse: collapse !important;
                    width: 100% !important;
                }
                .o_main_table thead tr {
                    border-bottom: 2px solid #000 !important;
                }
                .o_main_table thead th {
                    border-bottom: 2px solid #000 !important;
                    padding: 6px 8px !important;
                    font-size: 10pt;
                }
                .o_main_table tbody td {
                    border-bottom: 1px solid #ccc !important;
                    padding: 5px 8px !important;
                    font-size: 10pt;
                }
                .o_main_table tbody tr:last-child td {
                    border-bottom: 2px solid #000 !important;
                }

                /* Totals table */
                .o_has_total_table + div table,
                div#total table {
                    width: auto !important;
                    margin-left: auto !important;
                }
                div#total td {
                    padding: 3px 8px !important;
                }

                /* General invoice styles */
                .invoice_main {
                    font-family: 'Times New Roman', Times, serif;
                    font-size: 10pt;
                }
                .invoice_main h2, .invoice_main .h2 {
                    font-size: 16pt;
                    font-weight: bold;
                }

                /* Informations row - dates, refs */
                #informations .col {
                    font-size: 10pt;
                }

                /* Payment communication */
                #payment_term, #informations {
                    font-size: 10pt;
                }
            </style>
        </xpath>

    </template>

</odoo>
