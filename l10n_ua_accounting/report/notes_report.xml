<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_notes" model="ir.actions.report">
        <field name="name">Notes to the Financial Statements (Form No.5)</field>
        <field name="model">l10n_ua.notes.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_accounting.report_notes_document</field>
        <field name="report_file">l10n_ua_accounting.report_notes_document</field>
        <field name="print_report_name">'Ф5_примітки_%s' % object.date_to.year</field>
        <field name="paperformat_id" ref="paperformat_ua_report_landscape"/>
    </record>

    <template id="report_notes_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report">
                <t t-call="web.external_layout">
                    <t t-call="l10n_ua_doc_reports.report_ua_styles"/>
                    <div class="page ua-report" style="font-size: 7pt;">
                        <table class="table-borderless mb-2" style="width: 60%;">
                            <tr>
                                <td style="width: 120px;">Підприємство</td>
                                <td class="border-bottom"><span t-field="report.company_id.name"/></td>
                            </tr>
                            <tr t-if="report.company_id.company_registry">
                                <td>за ЄДРПОУ</td>
                                <td class="border-bottom"><span t-field="report.company_id.company_registry"/></td>
                            </tr>
                        </table>
                        <div class="small">Одиниця виміру: тис. грн.</div>
                        <div class="ua-report-title">ПРИМІТКИ ДО РІЧНОЇ ФІНАНСОВОЇ ЗВІТНОСТІ</div>
                        <div class="ua-report-subtitle">за <t t-esc="report.date_to.year"/> рік</div>
                        <div class="small text-center mb-2">Форма № 5 · Код за ДКУД 1801008</div>

                        <t t-foreach="report.line_ids.filtered(lambda l: l.kind == 'section').sorted('sequence')" t-as="sec">
                            <t t-set="spec" t-value="report._section_graphs(sec.section)"/>
                            <t t-set="graphs" t-value="spec[0]"/>
                            <div class="bold mt-3 mb-1" t-esc="sec.name"/>
                            <table style="page-break-inside: auto;">
                                <thead>
                                    <tr>
                                        <th style="width: 22%;">Найменування показника</th>
                                        <th style="width: 4%;">Код рядка</th>
                                        <t t-foreach="graphs" t-as="g">
                                            <th t-esc="spec[1].get(g, '')" style="font-weight: normal;"/>
                                        </t>
                                    </tr>
                                    <tr>
                                        <th>1</th><th>2</th>
                                        <t t-foreach="graphs" t-as="g"><th t-esc="g"/></t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="report.line_ids.filtered(lambda l: l.section == sec.section and l.kind in ('row', 'blank', 'title')).sorted('sequence')" t-as="line">
                                        <tr t-att-class="'bold' if line.is_total else ''">
                                            <td t-esc="line.label if line.kind == 'blank' else line.name"/>
                                            <td class="text-center" t-esc="line.code"/>
                                            <t t-foreach="graphs" t-as="g">
                                                <td class="text-right">
                                                    <t t-if="g not in line.graph_list()">Х</t>
                                                    <t t-elif="line['g%s' % g]" t-esc="'%.0f' % line['g%s' % g]"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <t t-foreach="report.line_ids.filtered(lambda l: l.section == sec.section and l.kind == 'note').sorted('sequence')" t-as="note">
                                <div class="small">
                                    <t t-esc="note.name"/> (<t t-esc="note.code"/>)
                                    <b t-esc="'%.0f' % note.g3 if note.g3 else '____'"/>
                                </div>
                            </t>
                        </t>

                        <div class="row mt-4">
                            <div class="col-6"><div class="signature-row"><span>Керівник</span><span class="signature-line"></span></div></div>
                            <div class="col-6"><div class="signature-row"><span>Головний бухгалтер</span><span class="signature-line"></span></div></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
