<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Advance Report Form View -->
    <record id="view_advance_report_form" model="ir.ui.view">
        <field name="name">l10n_ua.advance.report.form</field>
        <field name="model">l10n_ua.advance.report</field>
        <field name="arch" type="xml">
            <form string="Авансовий звіт">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="account.group_account_manager"/>
                    <button name="action_post" type="object"
                            string="Post" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_print" type="object"
                            string="Print" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="state not in ('submitted', 'approved', 'cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state in ('posted', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="advance_date" readonly="state != 'draft'"/>
                            <field name="advance_amount" readonly="state != 'draft'"/>
                            <field name="previous_balance" readonly="state != 'draft'"/>
                            <field name="currency_id" groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expenses" name="expenses">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="expense_type"/>
                                    <field name="description"/>
                                    <field name="partner_id"/>
                                    <field name="document_type"/>
                                    <field name="document_number"/>
                                    <field name="account_id"
                                           optional="show"
                                           domain="[('company_ids', 'in', parent.company_id)]"/>
                                    <field name="amount"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_expenses"/>
                                <field name="balance" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Approval" name="approval" invisible="state == 'draft'">
                            <group>
                                <field name="approved_by" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                                <field name="move_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."
                                   readonly="state not in ('draft', 'submitted')"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Advance Report List View -->
    <record id="view_advance_report_list" model="ir.ui.view">
        <field name="name">l10n_ua.advance.report.list</field>
        <field name="model">l10n_ua.advance.report</field>
        <field name="arch" type="xml">
            <list string="Авансові звіти" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="purpose"/>
                <field name="advance_amount"/>
                <field name="total_expenses"/>
                <field name="balance"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state in ('submitted', 'approved')"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Advance Report Search View -->
    <record id="view_advance_report_search" model="ir.ui.view">
        <field name="name">l10n_ua.advance.report.search</field>
        <field name="model">l10n_ua.advance.report</field>
        <field name="arch" type="xml">
            <search string="Advance Reports">
                <field name="name" string="Number"/>
                <field name="employee_id"/>
                <field name="purpose"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="groupby_employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Advance Report Action -->
    <record id="action_advance_report" model="ir.actions.act_window">
        <field name="name">Авансові звіти</field>
        <field name="res_model">l10n_ua.advance.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Advance Report
            </p>
            <p>
                Advance reports are used to account for money given to employees
                for business expenses like travel, purchases, etc.
            </p>
        </field>
    </record>

    <!-- Sequence for Advance Reports -->
    <record id="sequence_advance_report" model="ir.sequence">
        <field name="name">Advance Report Sequence</field>
        <field name="code">l10n_ua.advance.report</field>
        <field name="prefix">АЗ-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
