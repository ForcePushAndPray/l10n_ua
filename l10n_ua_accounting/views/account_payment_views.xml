<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend payment form with Ukrainian fields -->
    <record id="view_account_payment_form_ua" model="ir.ui.view">
        <field name="name">account.payment.form.ua</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <field name="ua_cash_order_number" readonly="1"
                       invisible="not is_ua_cash_order"/>
                <field name="ua_payment_basis"
                       invisible="not is_ua_cash_order"/>
                <field name="ua_cash_person"
                       invisible="not is_ua_cash_order"/>
                <field name="ua_person_document"
                       invisible="not is_ua_cash_order"/>
                <field name="ua_appendix"
                       invisible="not is_ua_cash_order"/>
                <field name="is_ua_cash_order" invisible="1"/>
                <field name="ua_cash_order_type" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Add print buttons for PKO/VKO -->
    <record id="view_account_payment_form_ua_buttons" model="ir.ui.view">
        <field name="name">account.payment.form.ua.buttons</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_pko" type="object"
                        string="Print ПКО"
                        invisible="ua_cash_order_type != 'pko' or state != 'paid'"
                        class="btn-secondary"/>
                <button name="action_print_vko" type="object"
                        string="Print ВКО"
                        invisible="ua_cash_order_type != 'vko' or state != 'paid'"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <!-- PKO List View (Cash Receipts) -->
    <record id="view_account_payment_pko_list" model="ir.ui.view">
        <field name="name">account.payment.pko.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="ПКО (Прибуткові касові ордери)">
                <field name="ua_cash_order_number" string="№ ПКО"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="ua_payment_basis" string="Підстава"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- VKO List View (Cash Disbursements) -->
    <record id="view_account_payment_vko_list" model="ir.ui.view">
        <field name="name">account.payment.vko.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="ВКО (Видаткові касові ордери)">
                <field name="ua_cash_order_number" string="№ ВКО"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="ua_cash_person" string="Отримав"/>
                <field name="ua_payment_basis" string="Підстава"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- PKO Action -->
    <record id="action_account_payment_pko" model="ir.actions.act_window">
        <field name="name">ПКО (Прибуткові)</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash'), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'search_default_journal_id': False,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_payment_pko_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_account_payment_form')})]"/>
    </record>

    <!-- VKO Action -->
    <record id="action_account_payment_vko" model="ir.actions.act_window">
        <field name="name">ВКО (Видаткові)</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'cash'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_partner_type': 'supplier',
            'search_default_journal_id': False,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_account_payment_vko_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_account_payment_form')})]"/>
    </record>

</odoo>
