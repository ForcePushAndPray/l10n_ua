<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Service Act Form View -->
    <record id="view_service_act_form" model="ir.ui.view">
        <field name="name">l10n_ua.service.act.form</field>
        <field name="model">l10n_ua.service.act</field>
        <field name="arch" type="xml">
            <form string="Service Act">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_view_invoice" type="object"
                            string="View Invoice" class="btn-secondary"
                            invisible="not invoice_id"/>
                    <button name="action_print" type="object"
                            string="Print" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="currency_id" groups="base.group_multi_currency"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="contract_number" readonly="state != 'draft'"/>
                            <field name="contract_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Service Period">
                        <group>
                            <field name="period_from" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="period_to" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."
                                   readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Service Act List View -->
    <record id="view_service_act_list" model="ir.ui.view">
        <field name="name">l10n_ua.service.act.list</field>
        <field name="model">l10n_ua.service.act</field>
        <field name="arch" type="xml">
            <list string="Service Acts" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Service Act Search View -->
    <record id="view_service_act_search" model="ir.ui.view">
        <field name="name">l10n_ua.service.act.search</field>
        <field name="model">l10n_ua.service.act</field>
        <field name="arch" type="xml">
            <search string="Service Acts">
                <field name="name" string="Number"/>
                <field name="partner_id"/>
                <field name="contract_number"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Invoiced" name="filter_invoiced" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <group>
                    <filter string="Customer" name="groupby_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Service Act Action -->
    <record id="action_service_act" model="ir.actions.act_window">
        <field name="name">Service Acts</field>
        <field name="res_model">l10n_ua.service.act</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Service Act
            </p>
            <p>
                Service acts confirm the provision of services to customers
                and serve as the basis for issuing invoices.
            </p>
        </field>
    </record>

    <!-- Sequence for Service Acts -->
    <record id="sequence_service_act" model="ir.sequence">
        <field name="name">Service Act Sequence</field>
        <field name="code">l10n_ua.service.act</field>
        <field name="prefix">АКТ-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
