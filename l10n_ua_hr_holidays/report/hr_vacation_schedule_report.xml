<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_hr_vacation_schedule" model="ir.actions.report">
        <field name="name">Print</field>
        <field name="model">hr.vacation.schedule</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ua_hr_holidays.report_hr_vacation_schedule</field>
        <field name="report_file">l10n_ua_hr_holidays.report_hr_vacation_schedule</field>
        <field name="print_report_name">'Графік_відпусток_%s' % (object.year)</field>
        <field name="binding_model_id" ref="model_hr_vacation_schedule"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="l10n_ua_hr_base.paperformat_a4_ua"/>
    </record>

    <template id="report_hr_vacation_schedule">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="report_doc">
                <t t-call="l10n_ua_hr_holidays.report_hr_vacation_schedule_document"/>
            </t>
        </t>
    </template>

    <template id="report_hr_vacation_schedule_document">
        <t t-call="web.basic_layout">
            <t t-set="company" t-value="report_doc.company_id or env.company"/>
            <div class="page" style="font-family: 'Times New Roman', serif; font-size: 11pt;">

                <div style="text-align: center; margin-bottom: 20px;">
                    <strong t-esc="company.name"/>
                    <h3 style="margin: 10px 0;">ГРАФІК ВІДПУСТОК</h3>
                    <p style="font-size: 10pt;">на <span t-esc="report_doc.year"/> рік</p>
                </div>

                <table style="width: 100%; border-collapse: collapse; font-size: 8pt;">
                    <thead>
                        <tr style="background-color: #f0f0f0;">
                            <th style="border: 1px solid #000; padding: 4px; width: 3%;">№</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 17%;">ПІБ</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 12%;">Посада</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 13%;">Тип відпустки</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 10%;">Кількість календарних днів</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 13%;">Період, за який надається відпустка</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 14%;">Місяць, або період відпустки</th>
                            <th style="border: 1px solid #000; padding: 4px; width: 18%;">Підпис працівника</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row_num" t-value="0"/>
                        <t t-foreach="report_doc._report_lines_grouped()" t-as="grp">
                            <t t-set="row_num" t-value="row_num + 1"/>
                            <t t-foreach="grp['type_groups']" t-as="tg">
                                <t t-foreach="tg['lines']" t-as="line">
                                    <tr>
                                        <t t-if="tg_index == 0 and line_index == 0">
                                            <td style="border: 1px solid #000; padding: 4px; text-align: center; vertical-align: middle;"
                                                t-att-rowspan="grp['total']">
                                                <t t-esc="row_num"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px; vertical-align: middle;"
                                                t-att-rowspan="grp['total']">
                                                <t t-esc="grp['employee'].name"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 4px; vertical-align: middle;"
                                                t-att-rowspan="grp['total']">
                                                <t t-esc="grp['employee'].job_id.name or ''"/>
                                            </td>
                                        </t>
                                        <t t-if="line_index == 0">
                                            <td style="border: 1px solid #000; padding: 4px; vertical-align: middle;"
                                                t-att-rowspan="len(tg['lines'])">
                                                <t t-esc="tg['leave_type'].name or ''"/>
                                            </td>
                                        </t>
                                        <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                            <t t-esc="line.planned_days"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                            <t t-esc="line.vacation_balance_id.period_label or ''"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                            <t t-esc="line.vacation_period_display or ''"/>
                                        </td>
                                        <t t-if="tg_index == 0 and line_index == 0">
                                            <td style="border: 1px solid #000; padding: 4px; vertical-align: middle;"
                                                t-att-rowspan="grp['total']"/>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div style="margin-top: 30px;">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 40%;">Керівник кадрової служби</td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                            <td style="width: 30%; text-align: center; border-bottom: 1px solid #000;"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: center; font-size: 9pt;">(підпис)</td>
                            <td style="text-align: center; font-size: 9pt;">(П.І.Б.)</td>
                        </tr>
                    </table>
                </div>

            </div>
        </t>
    </template>

</odoo>

