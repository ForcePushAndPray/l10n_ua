<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_inherit_ua_holidays" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ua.holidays</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_import_ua_leave_types"
                            string="Import UA Leave Types"
                            type="object"
                            class="btn-primary"
                            invisible="ua_leave_types_imported"/>
                    <button name="action_import_ua_leave_types"
                            string="Re-import UA Leave Types"
                            type="object"
                            class="btn-secondary"
                            invisible="not ua_leave_types_imported"
                            confirm="This will create any missing UA leave types. Continue?"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
