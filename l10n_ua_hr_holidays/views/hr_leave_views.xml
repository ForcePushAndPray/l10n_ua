<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_view_form_ua" model="ir.ui.view">
        <field name="name">hr.leave.form.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Ukrainian Specifics" name="ua_details">
                    <group>
                        <field name="calendar_days"/>
                        <field name="working_days"/>
                        <field name="vacation_year"/>
                        <field name="show_create_vacation_period" invisible="1"/>
                        <label for="vacation_balance_id"/>
                        <div class="o_row">
                            <field name="vacation_balance_id" nolabel="1"
                                   options="{'no_create': True}"/>
                            <button name="action_create_vacation_period"
                                    type="object" string="Create"
                                    class="btn-link"
                                    invisible="not show_create_vacation_period"/>
                        </div>
                    </group>
                    <group>
                        <field name="average_daily_salary"/>
                        <field name="vacation_pay_amount"/>
                    </group>
                    <group>
                        <field name="remaining_days_before"/>
                        <field name="remaining_days_after"/>
                    </group>
                    <group>
			<field name="order_id"/>
			<field name="order_date" invisible="bool(order_id)"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
