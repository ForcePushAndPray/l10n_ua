<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_view_form_ua" model="ir.ui.view">
        <field name="name">hr.leave.form.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

        <!-- Keep the dates + the day counter on a single line.
             Add nowrap classes non-destructively (Odoo's `add`/separator
             syntax) instead of replacing full_date's native classes, so
             the day-count text next to the dates never wraps. -->
        <xpath expr="//div[@id='full_date']" position="attributes">
            <attribute name="class" add="text-nowrap" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='full_date']/.." position="attributes">
            <attribute name="class" add="flex-nowrap text-nowrap" separator=" "/>
        </xpath>

            <xpath expr="//sheet" position="inside">
                <group string="Ukrainian Specifics" name="ua_details">
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="not carryover_warning">
                        <field name="carryover_warning" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="calendar_days"/>
                        <field name="working_days"/>
                        <field name="vacation_year" readonly="1"/>
                        <!-- The accounting period is created automatically on
                             save; shown read-only for reference. -->
                        <field name="vacation_balance_id" readonly="1"
                               options="{'no_create': True}"/>			
                    </group>
                    <group>
                        <field name="average_daily_salary"/>
                        <field name="vacation_pay_amount"/>
                    </group>
                    <group>
                        <field name="remaining_days_before"/>
                        <field name="remaining_days_after"/>
                    </group>
                    <group>
			<field name="order_id"/>
			<field name="order_date" invisible="bool(order_id)"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
