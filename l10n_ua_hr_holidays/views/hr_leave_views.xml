<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_view_form_ua" model="ir.ui.view">
        <field name="name">hr.leave.form.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='details_group']" position="after">
                <group string="Ukrainian Specifics" name="ua_details">
                    <field name="calendar_days"/>
                    <field name="working_days"/>
                    <field name="vacation_year"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Vacation Pay" name="vacation_pay" 
                       invisible="not holiday_status_id">
                    <group>
                        <field name="average_daily_salary"/>
                        <field name="vacation_pay_amount"/>
                    </group>
                    <group>
                        <field name="remaining_days_before"/>
                        <field name="remaining_days_after"/>
                    </group>
                    <group>
                        <field name="order_number"/>
                        <field name="order_date"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_calculate_vacation_pay" string="Calculate Pay" 
                        type="object" invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_tree_ua" model="ir.ui.view">
        <field name="name">hr.leave.tree.ua</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number_of_days']" position="after">
                <field name="calendar_days" optional="show"/>
                <field name="vacation_pay_amount" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
