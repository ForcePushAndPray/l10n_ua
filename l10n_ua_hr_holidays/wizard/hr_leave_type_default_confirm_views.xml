<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_type_default_confirm_form" model="ir.ui.view">
        <field name="name">hr.leave.type.default.confirm.form</field>
        <field name="model">hr.leave.type.default.confirm</field>
        <field name="arch" type="xml">
            <form string="Change Default Leave Type">
                <field name="leave_type_id" invisible="1"/>
                <div>
                    <p>
                        The leave type(s)
                        <strong><field name="current_default_ids" widget="many2many_tags" readonly="1" nolabel="1"/></strong>
                        are already set as the default for this company.
                    </p>
                    <p>
                        Do you want to make
                        <strong><field name="leave_type_id" readonly="1" nolabel="1"/></strong>
                        the default instead? The flag will be removed from the others.
                    </p>
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Yes, change default" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

