<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_medecin" model="ir.ui.view">
        <field name="name">res.company.form.medecin</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Медичний заклад (UA)" name="ua_medecin">
                    <group>
                        <field name="l10n_ua_medecin_type"/>
                        <field name="l10n_ua_medecin_is_state"
                               invisible="not l10n_ua_medecin_type"/>
                        <field name="l10n_ua_medecin_license_number"
                               invisible="not l10n_ua_medecin_type"/>
                        <field name="l10n_ua_medecin_license_date"
                               invisible="not l10n_ua_medecin_type"/>
                    </group>
                    <group>
                        <field name="l10n_ua_medecin_nszu_id"
                               invisible="not l10n_ua_medecin_type"/>
                        <field name="l10n_ua_medecin_ehealth_id"
                               invisible="not l10n_ua_medecin_type"/>
                    </group>
                </group>
                <group string="Спеціалізації" invisible="not l10n_ua_medecin_type">
                    <field name="l10n_ua_medecin_specialty_ids" widget="many2many_tags" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
