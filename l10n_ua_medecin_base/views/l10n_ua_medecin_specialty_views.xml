<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_specialty_list" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.specialty.list</field>
        <field name="model">l10n_ua.medecin.specialty</field>
        <field name="arch" type="xml">
            <list string="Медичні спеціалізації">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_specialty_form" model="ir.ui.view">
        <field name="name">l10n_ua.medecin.specialty.form</field>
        <field name="model">l10n_ua.medecin.specialty</field>
        <field name="arch" type="xml">
            <form string="Спеціалізація">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_specialty" model="ir.actions.act_window">
        <field name="name">Спеціалізації</field>
        <field name="res_model">l10n_ua.medecin.specialty</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
