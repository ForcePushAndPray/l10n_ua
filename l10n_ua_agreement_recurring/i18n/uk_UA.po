#. module: l10n_ua_agreement_recurring
#: model:ir.model.fields,help:l10n_ua_agreement_recurring.field_l10n_ua_agreement_recurring_line__name
msgid ""
"#PERIOD# — the period («жовтень 2026», «IV квартал 2026»), #START# / #END# —"
" its first and last day. Empty — the product name «for <period>»."
msgstr "#PERIOD# — період («жовтень 2026», «IV квартал 2026»), #START# / #END# — його перший і останній день. Порожньо — назва товару «за <період>»."

