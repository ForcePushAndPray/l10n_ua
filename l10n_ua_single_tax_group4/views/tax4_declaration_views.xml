<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_tax4_declaration_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.tax4.declaration.list</field>
        <field name="model">l10n_ua.tax4.declaration</field>
        <field name="arch" type="xml">
            <list string="Декларації ЄП 4 групи">
                <field name="year" options="{'enable_formatting': false}"/>
                <field name="declaration_type"/>
                <field name="katottg"/>
                <field name="tax_office_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_annual" sum="Разом"/>
                <field name="total_q1" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'calculated'" decoration-success="state in ('submitted', 'accepted')"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_tax4_declaration_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.tax4.declaration.form</field>
        <field name="model">l10n_ua.tax4.declaration</field>
        <field name="arch" type="xml">
            <form string="Декларація ЄП 4 групи">
                <header>
                    <button name="action_calculate" string="Розрахувати" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_calculate" string="Перерахувати" type="object"
                            invisible="state != 'calculated'"/>
                    <button name="action_create_reporting" string="Створити звітні за громадами" type="object"
                            invisible="declaration_type != 'general' or state != 'calculated'"/>
                    <button name="action_generate_xml" string="Сформувати XML" type="object"
                            invisible="state != 'calculated'"/>
                    <button name="action_submit" string="Підписати і подати" type="object" class="btn-primary"
                            invisible="state != 'calculated'"/>
                    <button name="action_post_accruals" string="Провести квартальні нарахування" type="object"
                            invisible="declaration_type != 'general' or state == 'draft' or accrual_move_ids"/>
                    <button name="action_accept" string="Прийнято" type="object" invisible="state != 'submitted'"/>
                    <button name="action_draft" string="В чернетку" type="object" invisible="state == 'draft'"
                            groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,calculated,submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-warning" role="alert"
                         invisible="declaration_type != 'general' or not total_income or agri_share &gt;= 75">
                        Частка сільськогосподарського товаровиробництва за минулий рік менша за 75 % —
                        перевірте право на четверту групу (п. 291.4 ПКУ).
                    </div>
                    <group>
                        <group>
                            <field name="year" options="{'enable_formatting': false}" readonly="state != 'draft'"/>
                            <field name="declaration_type" readonly="state != 'draft'"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="katottg" placeholder="UA00000000000000000"/>
                            <field name="tax_office_id"/>
                            <field name="sequence_number"/>
                            <field name="ngo_index"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="До сплати">
                            <field name="tax_annual"/>
                            <field name="mpz_difference"/>
                            <field name="total_annual" class="fw-bold"/>
                            <field name="total_q1"/>
                            <field name="tax_q2"/>
                            <field name="tax_q3"/>
                            <field name="tax_q4"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Розрахунок" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="plot_id"/>
                                    <field name="land_type"/>
                                    <field name="katottg" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="area" sum="Разом"/>
                                    <field name="ngo_ha"/>
                                    <field name="rate"/>
                                    <field name="annual_tax" sum="Разом"/>
                                    <field name="q1" sum="Разом"/>
                                    <field name="q2" sum="Разом"/>
                                    <field name="q3" sum="Разом"/>
                                    <field name="q4" sum="Разом"/>
                                </list>
                            </field>
                        </page>
                        <page string="МПЗ (додаток 3)" name="mpz">
                            <field name="mpz_line_ids" readonly="1">
                                <list>
                                    <field name="plot_id"/>
                                    <field name="own_area" sum="Разом"/>
                                    <field name="leased_area" sum="Разом"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="ngo_done"/>
                                    <field name="ngo_region" optional="hide"/>
                                    <field name="k"/>
                                    <field name="months"/>
                                    <field name="mpz_ngo" sum="Разом"/>
                                    <field name="mpz_region" sum="Разом" optional="hide"/>
                                    <field name="rent20" sum="Разом"/>
                                </list>
                            </field>
                            <group invisible="declaration_type != 'general'">
                                <group string="Сплачено податків за минулий рік">
                                    <field name="paid_single_tax"/>
                                    <field name="paid_profit_tax"/>
                                    <field name="paid_pdfo"/>
                                    <field name="paid_military"/>
                                    <field name="paid_pdfo_employees"/>
                                    <field name="paid_military_employees"/>
                                    <field name="paid_pdfo_rent"/>
                                    <field name="paid_military_rent"/>
                                    <field name="paid_land_tax"/>
                                    <field name="paid_water_rent"/>
                                </group>
                                <group string="Розділ II">
                                    <field name="mpz_total"/>
                                    <field name="paid_total"/>
                                    <field name="rent20_total"/>
                                    <field name="mpz_balance" class="fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Частка с/г виробництва" name="share" invisible="declaration_type != 'general'">
                            <group>
                                <field name="agri_income"/>
                                <field name="total_income"/>
                                <field name="agri_share"/>
                            </group>
                        </page>
                        <page string="Звітні декларації" name="children" invisible="declaration_type != 'general'">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="katottg"/>
                                    <field name="tax_office_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="total_annual" sum="Разом"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Подання" name="submit">
                            <group>
                                <group>
                                    <field name="signatory_name"/>
                                    <field name="signatory_rnokpp"/>
                                    <field name="accountant_name"/>
                                    <field name="accountant_rnokpp"/>
                                </group>
                                <group>
                                    <field name="xml_file" filename="xml_filename"/>
                                    <field name="xml_filename" invisible="1"/>
                                    <field name="annex1_xml_file" filename="annex1_xml_filename"/>
                                    <field name="annex1_xml_filename" invisible="1"/>
                                    <field name="annex3_xml_file" filename="annex3_xml_filename"/>
                                    <field name="annex3_xml_filename" invisible="1"/>
                                    <field name="submission_date"/>
                                    <field name="accrual_move_ids" widget="many2many_tags" invisible="not accrual_move_ids"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_tax4_declaration_action" model="ir.actions.act_window">
        <field name="name">Декларації ЄП 4 групи</field>
        <field name="res_model">l10n_ua.tax4.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_declaration_type': 'general'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Створіть декларацію єдиного податку четвертої групи</p>
            <p>Податок рахується з нормативної грошової оцінки земельних ділянок, що використовуються;
               загальна декларація подається до 20 лютого, звітні — за кожною громадою.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_ua_tax4_declarations"
              name="Декларації ЄП 4 групи"
              parent="l10n_ua_tax.menu_ua_tax_reporting"
              action="l10n_ua_tax4_declaration_action"
              sequence="35"/>

</odoo>
