<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">l10n_ua.meal.attendance.list</field>
        <field name="model">l10n_ua.meal.attendance</field>
        <field name="arch" type="xml">
            <list string="Відвідуваність" editable="bottom">
                <field name="date"/>
                <field name="group_id"/>
                <field name="enrolled_count" readonly="1"/>
                <field name="present_count"/>
                <field name="absent_count" readonly="1"/>
                <field name="breakfast_count"/>
                <field name="lunch_count"/>
                <field name="afternoon_count" optional="hide"/>
                <field name="dinner_count" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Відвідуваність харчування</field>
        <field name="res_model">l10n_ua.meal.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
