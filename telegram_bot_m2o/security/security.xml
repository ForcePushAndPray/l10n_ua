<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- User Group -->
    <record id="group_telegram_bot_user" model="res.groups">
        <field name="name">Telegram Bot / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_telegram_bot_manager" model="res.groups">
        <field name="name">Telegram Bot / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_telegram_bot_user'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- Users can only see bots from their company -->
    <record id="telegram_bot_company_rule" model="ir.rule">
        <field name="name">Telegram Bot: Company</field>
        <field name="model_id" ref="model_telegram_bot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_telegram_bot_user'))]"/>
    </record>

    <!-- Users can see chats for bots in their company -->
    <record id="telegram_bot_chat_company_rule" model="ir.rule">
        <field name="name">Telegram Bot Chat: Company</field>
        <field name="model_id" ref="model_telegram_bot_chat"/>
        <field name="domain_force">[('bot_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_telegram_bot_user'))]"/>
    </record>

</odoo>
