<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_form_ua" model="ir.ui.view">
        <field name="name">account.asset.form.ua</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ua_inventory_number"/>
            </field>
            <field name="acquisition_date" position="after">
                <field name="ua_commission_date"/>
                <field name="ua_group_id"/>
            </field>
            <field name="method" position="after">
                <field name="ua_depreciation_method"/>
                <field name="ua_useful_life"/>
                <field name="ua_liquidation_value"/>
                <field name="ua_production_capacity" invisible="ua_depreciation_method != 'production'"/>
                <field name="ua_produced_units" invisible="ua_depreciation_method != 'production'"/>
            </field>
        </field>
    </record>

</odoo>
