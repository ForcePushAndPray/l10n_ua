<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_ua_mnma_view_form" model="ir.ui.view">
        <field name="name">l10n_ua.mnma.form</field>
        <field name="model">l10n_ua.mnma</field>
        <field name="arch" type="xml">
            <form string="MNMA">
                <header>
                    <button name="action_commission" string="Commission" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_write_off" string="Write Off" type="object" class="btn-danger" invisible="state != 'in_use'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_use,written_off"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="inventory_number"/>
                            <field name="date"/>
                            <field name="commission_date"/>
                        </group>
                        <group>
                            <field name="original_value"/>
                            <field name="write_off_method"/>
                            <field name="depreciation_value"/>
                            <field name="residual_value"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="department_id"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ua_mnma_view_list" model="ir.ui.view">
        <field name="name">l10n_ua.mnma.list</field>
        <field name="model">l10n_ua.mnma</field>
        <field name="arch" type="xml">
            <list string="MNMA">
                <field name="inventory_number"/>
                <field name="name"/>
                <field name="date"/>
                <field name="original_value" sum="Total"/>
                <field name="write_off_method"/>
                <field name="depreciation_value" sum="Total"/>
                <field name="residual_value" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="l10n_ua_mnma_view_search" model="ir.ui.view">
        <field name="name">l10n_ua.mnma.search</field>
        <field name="model">l10n_ua.mnma</field>
        <field name="arch" type="xml">
            <search string="MNMA">
                <field name="name"/>
                <field name="inventory_number"/>
                <field name="responsible_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_use" string="In Use" domain="[('state', '=', 'in_use')]"/>
                <filter name="written_off" string="Written Off" domain="[('state', '=', 'written_off')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_ua_mnma_action" model="ir.actions.act_window">
        <field name="name">MNMA</field>
        <field name="res_model">l10n_ua.mnma</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
