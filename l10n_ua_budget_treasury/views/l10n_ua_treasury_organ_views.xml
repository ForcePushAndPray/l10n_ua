<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_treasury_organ_list" model="ir.ui.view">
        <field name="name">l10n_ua.treasury.organ.list</field>
        <field name="model">l10n_ua.treasury.organ</field>
        <field name="arch" type="xml">
            <list string="Органи ДКСУ" decoration-info="organ_type == 'central'">
                <field name="code"/>
                <field name="name"/>
                <field name="organ_type"/>
                <field name="state_id" optional="show"/>
                <field name="parent_id" optional="hide"/>
                <field name="edrpou" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ua_treasury_organ_form" model="ir.ui.view">
        <field name="name">l10n_ua.treasury.organ.form</field>
        <field name="model">l10n_ua.treasury.organ</field>
        <field name="arch" type="xml">
            <form string="Орган ДКСУ">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="organ_type"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="edrpou"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Підлеглі органи" name="children">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="organ_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ua_treasury_organ_search" model="ir.ui.view">
        <field name="name">l10n_ua.treasury.organ.search</field>
        <field name="model">l10n_ua.treasury.organ</field>
        <field name="arch" type="xml">
            <search string="Пошук органів ДКСУ">
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
                <filter string="Центральні" name="filter_central" domain="[('organ_type', '=', 'central')]"/>
                <filter string="Обласні" name="filter_regional" domain="[('organ_type', '=', 'regional')]"/>
                <filter string="Районні" name="filter_district" domain="[('organ_type', '=', 'district')]"/>
                <group>
                    <filter string="Тип" name="groupby_type" domain="[]" context="{'group_by': 'organ_type'}"/>
                    <filter string="Область" name="groupby_state" domain="[]" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ua_treasury_organ" model="ir.actions.act_window">
        <field name="name">Органи ДКСУ</field>
        <field name="res_model">l10n_ua.treasury.organ</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
