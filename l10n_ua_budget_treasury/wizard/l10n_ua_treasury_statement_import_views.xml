<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ua_treasury_statement_import_form" model="ir.ui.view">
        <field name="name">l10n_ua.treasury.statement.import.form</field>
        <field name="model">l10n_ua.treasury.statement.import</field>
        <field name="arch" type="xml">
            <form string="Імпорт виписки ДКСУ">
                <group>
                    <field name="journal_id"/>
                    <field name="file_format"/>
                    <field name="encoding"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <p><strong>Формат CSV (за замовчуванням):</strong> UTF-8, заголовки в першому рядку.</p>
                    <p>Очікувані колонки: <code>date,description,partner_name,amount,reference</code>.</p>
                    <p>Дата — у форматі <code>YYYY-MM-DD</code>. Сума — десяткове число (крапка або кома як роздільник).</p>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Імпортувати"
                            class="btn-primary"/>
                    <button special="cancel" string="Скасувати" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ua_treasury_statement_import" model="ir.actions.act_window">
        <field name="name">Імпорт виписки ДКСУ</field>
        <field name="res_model">l10n_ua.treasury.statement.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
